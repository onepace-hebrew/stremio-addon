Dialogue: 0,0:00:00.00,0:00:05.00,Main-207-,,0,0,0,,{\an8}‫תרגום לעברית — That One Gerbil
Dialogue: 0,0:01:42.68,0:01:47.85,Narrator,,0,0,0,,‫אחרי שמדריכם פקומס נעלם,\N‫הצוות של לופי עזב את האי קאקאו
Dialogue: 0,0:01:47.85,0:01:51.08,Narrator,,0,0,0,,‫ועוקב אחר ההוראות של פודינג\N‫לאי הול קייק
Dialogue: 0,0:01:51.08,0:01:53.74,Narrator,,0,0,0,,‫שם נמצאת הקיסרית ביג מאם.
Dialogue: 0,0:01:57.13,0:02:00.66,Main-207-,,0,0,0,,‫אני דואג לפקומס.\N‫צריך לחפש אותו!
Dialogue: 0,0:02:00.66,0:02:05.68,Main-207-,,0,0,0,,‫תודה, אבל זה לא יהיה פשוט.\N‫הוא בחור קשוח, הוא יהיה בסדר.
Dialogue: 0,0:02:06.14,0:02:07.48,Main-207-,,0,0,0,,‫כן, אבל...
Dialogue: 0,0:02:07.48,0:02:11.19,Main-207-,,0,0,0,,‫בכל מקרה, אנחנו צריכים להגיע\N‫לאי הול קייק
Dialogue: 0,0:02:11.19,0:02:13.07,Main-207-,,0,0,0,,‫מבלי שהאויב יראה אותנו.
Dialogue: 0,0:02:13.07,0:02:15.48,Main-207-,,0,0,0,,‫היי, איפה אנחנו עכשיו?
Dialogue: 0,0:02:18.82,0:02:22.78,Main-207-,,0,0,0,,‫עדיין לא התרחקנו הרבה מאי קאקאו.
Dialogue: 0,0:02:26.50,0:02:28.62,Main-207-,,0,0,0,,‫היי, אני רואה אי!
Dialogue: 0,0:02:29.63,0:02:32.84,Main-207-,,0,0,0,,‫יאי! איזה נשנוש יהיה שם?!
Dialogue: 0,0:02:32.84,0:02:36.05,Main-207-,,0,0,0,,‫אני מריח!\N‫זה חייב להיות משהו מתוק!
Dialogue: 0,0:02:36.05,0:02:39.38,Main-207-,,0,0,0,,‫הבא כנראה עיר עשויה ריבה.
Dialogue: 0,0:02:39.38,0:02:41.08,Main-207-,,0,0,0,,‫ריבה?!
Dialogue: 0,0:02:41.08,0:02:42.69,Main-207-,,0,0,0,,‫אבל אנחנו לא עוצרים שם.
Dialogue: 0,0:02:42.69,0:02:44.02,Main-207-,,0,0,0,,‫מה?!
Dialogue: 0,0:02:44.02,0:02:46.10,Main-207-,,0,0,0,,‫הנה, תסתכל.
Dialogue: 0,0:02:46.10,0:02:47.82,Main-207-,,0,0,0,,‫כשנזהה את אי הריבה,
Dialogue: 0,0:02:47.82,0:02:51.35,Main-207-,,0,0,0,,‫במקום להתקרב אליו, נפנה\N‫לכיוון של לוג-פוז השני.
Dialogue: 0,0:02:51.35,0:02:54.72,Main-207-,,0,0,0,,‫אבל זה מתוק! נאמי!
Dialogue: 0,0:02:54.72,0:02:58.19,Main-207-,,0,0,0,,‫לא הולכים לשם\N‫אפילו שזה מתוק?!
Dialogue: 0,0:02:58.49,0:02:59.70,Main-207-,,0,0,0,,‫נראה לי...
Dialogue: 0,0:03:00.40,0:03:01.96,Main-207-,,0,0,0,,‫לכיוון הזה.
Dialogue: 0,0:03:01.96,0:03:03.37,Main-207-,,0,0,0,,‫בסדר!
Dialogue: 0,0:03:04.87,0:03:08.26,Main-207-,,0,0,0,,‫לופי, ימנה! פנה לשלוש בשעון!
Dialogue: 0,0:03:08.26,0:03:12.43,Note,,0,0,0,,"Sanji" acts as a pun for "three o'clock"
Dialogue: 0,0:03:08.26,0:03:12.43,Main-207-,,0,0,0,,‫בדיוק! צ'ופר! קארוט!\N‫אנחנו הולכים לכיוון של {\i1}סאנג'י{\fs18} {\r}!
Dialogue: 0,0:03:12.43,0:03:14.05,Main-207-,,0,0,0,,‫אבל זה מתוק!
Dialogue: 0,0:03:14.45,0:03:18.27,Main-207-,,0,0,0,,‫אנחנו הולכים לאסוף את סאנג'י!\N‫ימנה קיצוני!
Dialogue: 0,0:03:18.27,0:03:19.55,Main-207-,,0,0,0,,‫זה יותר מידי!
Dialogue: 0,0:03:19.55,0:03:21.89,Main-207-,,0,0,0,,‫אתה גרוע בזה, לופי{\i1}{\fs10} {\r}!
Dialogue: 0,0:03:21.89,0:03:23.77,Main-207-,,0,0,0,,‫גם אתה, ברוק!
Dialogue: 0,0:03:23.77,0:03:26.57,Main-207-,,0,0,0,,‫אבל זה מתוק...!
Dialogue: 0,0:03:26.57,0:03:30.94,Main-207-,,0,0,0,,‫על ידי פנייה לכיוון האי הבא\N‫לפני שמתקרבים יותר מידי לאחד אחר,
Dialogue: 0,0:03:30.94,0:03:34.48,Main-207-,,0,0,0,,‫נוכל להימנע מרשת המעקב שלהם,\N‫היא אמרה.
Dialogue: 0,0:03:34.48,0:03:38.41,Main-207-,,0,0,0,,‫אה, ככה קוראים את המפה.
Dialogue: 0,0:03:38.41,0:03:39.70,Main-207-,,0,0,0,,‫אתה יכול לעשות את זה?
Dialogue: 0,0:03:39.70,0:03:40.87,Main-207-,,0,0,0,,‫סמוך עלי.
Dialogue: 0,0:03:40.87,0:03:44.13,Main-207-,,0,0,0,,‫לופי{\i1}{\i}, אני אקח מכאן.
Dialogue: 0,0:03:44.13,0:03:45.16,Main-207-,,0,0,0,,‫בסדר.
Dialogue: 0,0:03:45.16,0:03:48.12,Main-207-,,0,0,0,,‫טוב, חברים, אני אבשל לכם משהו!
Dialogue: 0,0:03:48.12,0:03:48.81,Main-207-,,0,0,0,,‫מה?!
Dialogue: 0,0:03:49.34,0:03:51.21,Main-207-,,0,0,0,,‫אני חייב לבשל!
Dialogue: 0,0:03:51.21,0:03:52.17,Main-207-,,0,0,0,,‫בבקשה!
Dialogue: 0,0:03:52.17,0:03:54.50,Main-207-,,0,0,0,,‫לופי, רגע!
Dialogue: 0,0:03:54.50,0:03:56.54,Main-207-,,0,0,0,,‫מה את רוצה, נאמי? אני אבשל.
Dialogue: 0,0:03:56.54,0:03:57.34,Main-207-,,0,0,0,,‫לא!
Dialogue: 0,0:03:57.78,0:03:59.92,Main-207-,,0,0,0,,‫הפעם אני לא אפשל!
Dialogue: 0,0:03:59.92,0:04:04.39,Main-207-,,0,0,0,,‫אני אעשה את זה! אל תכנס\N‫למטבח יותר לעולם!
Dialogue: 0,0:04:04.39,0:04:06.31,Main-207-,,0,0,0,,‫אני לא משלמת לך כלום!
Dialogue: 0,0:04:06.31,0:04:07.48,Main-207-,,0,0,0,,‫אני לא צריך את הכסף שלך!
Dialogue: 0,0:04:07.48,0:04:09.02,Main-207-,,0,0,0,,‫מה?!
Dialogue: 0,0:04:11.86,0:04:15.82,Main-207-,,0,0,0,,‫אני יכול להסתכל, פדרו?\N‫אני רוצה לעזור!
Dialogue: 0,0:04:15.82,0:04:16.86,Main-207-,,0,0,0,,‫בסדר.
Dialogue: 0,0:04:20.35,0:04:21.65,Main-207-,,0,0,0,,‫נראה לי...
Dialogue: 0,0:04:23.36,0:04:26.25,Main-207-,,0,0,0,,‫היי! המים צבועים בצבע ענבים!
Dialogue: 0,0:04:27.50,0:04:29.33,Main-207-,,0,0,0,,‫ענבים?
Dialogue: 0,0:04:29.33,0:04:32.12,Main-207-,,0,0,0,,‫יש אי שמוציא מיץ\N‫מסביב לאזור הזה.
Dialogue: 0,0:04:32.12,0:04:33.30,Main-207-,,0,0,0,,‫זה לא מזיק לנו.
Dialogue: 0,0:04:33.30,0:04:36.23,Main-207-,,0,0,0,,‫מה?! זה מיץ?!
Dialogue: 0,0:04:36.23,0:04:38.17,Main-207-,,0,0,0,,‫המקום הזה ממש גן עדן!
Dialogue: 0,0:04:38.86,0:04:41.92,Main-207-,,0,0,0,,‫פדרו, איך אתה יודע\N‫כל כך הרבה על האזור הזה?
Dialogue: 0,0:04:45.18,0:04:47.14,Main-207-,,0,0,0,,‫הייתי כאן פעם אחת לפני.
Dialogue: 0,0:04:47.14,0:04:48.18,Main-207-,,0,0,0,,‫מה?
Dialogue: 0,0:04:54.49,0:04:56.38,Main-207-,,0,0,0,,‫זה עצום!
Dialogue: 0,0:04:57.65,0:05:00.80,Main-207-,,0,0,0,,‫וואו! זה גדול!
Dialogue: 0,0:05:01.33,0:05:05.28,Main-207-,,0,0,0,,‫זה נדל ים ענק.\N‫הם חיים באזור הזה.
Dialogue: 0,0:05:06.57,0:05:09.81,Main-207-,,0,0,0,,‫לא! נדל ים ענק, לך מכאן!
Dialogue: 0,0:05:09.81,0:05:11.29,Main-207-,,0,0,0,,‫נאכל אותנו!
Dialogue: 0,0:05:11.29,0:05:13.20,Main-207-,,0,0,0,,‫לופי, זו העבודה שלך!
Dialogue: 0,0:05:13.63,0:05:14.83,Main-207-,,0,0,0,,‫בסדר!
Dialogue: 0,0:05:17.84,0:05:20.63,Main-207-,,0,0,0,,‫גם אני אעשה מה שאני יכול!
Dialogue: 0,0:05:26.93,0:05:28.79,Main-207-,,0,0,0,,‫הוא בא!
Dialogue: 0,0:05:28.79,0:05:31.72,Main-207-,,0,0,0,,{\fad(150,150)}‫גאם גאם...
Dialogue: 0,0:05:31.72,0:05:34.03,Main-207-,,0,0,0,,{\fad(150,150)}‫גאטלינג!
Dialogue: 0,0:05:48.81,0:05:51.70,Narrator,,0,0,0,,‫בינתיים, על אי הול קייק...
Dialogue: 0,0:05:51.70,0:05:54.62,Main-207-,,0,0,2,,{\i1}‫קרוקמבוש!{\i0}
Dialogue: 0,0:05:57.82,0:06:01.10,Main-207-,,0,0,0,,‫– מאמא! עצרי! מאמא!\N‫– מאמא! עצרי! מאמא!
Dialogue: 0,0:06:06.80,0:06:09.28,Main-207-,,0,0,0,,{\i1}‫מאמא... מאמא, בבקשה תעצרי!{\i}
Dialogue: 0,0:06:09.28,0:06:10.48,Main-207-,,0,0,0,,{\i1}‫זוזו!{\i}
Dialogue: 0,0:06:11.05,0:06:13.72,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש!{\i}
Dialogue: 0,0:06:14.56,0:06:18.04,Main-207-,,0,0,0,,‫לא! זה המחלה של מאמא!
Dialogue: 0,0:06:18.04,0:06:22.72,Main-207-,,0,0,0,,‫מהרו{\i1}{\fs10} {\r}!\N‫מה היא רוצה הפעם{\i1}{\fs12} {\r}?!
Dialogue: 0,0:06:22.72,0:06:23.57,Main-207-,,0,0,0,,‫היא רוצה...
Dialogue: 0,0:06:24.75,0:06:26.82,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\fs10} {\r}!
Dialogue: 0,0:06:26.82,0:06:28.84,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\fs12} {\r}?!
Dialogue: 0,0:06:28.84,0:06:32.54,Main-207-,,0,0,0,,‫זה הקינוח המעוטר שעשוי\N‫מבלינצ'ות שמגולגלות אחת על גבי השנייה?
Dialogue: 0,0:06:32.54,0:06:35.09,Main-207-,,0,0,0,,‫זה יהיה אתגר.
Dialogue: 0,0:06:35.09,0:06:37.33,Main-207-,,0,0,0,,‫אה! לא, רגע!
Dialogue: 0,0:06:37.33,0:06:39.84,Main-207-,,0,0,0,,‫אני חושב שיש קבוצת תיירים של
Dialogue: 0,0:06:39.84,0:06:44.00,Main-207-,,0,0,0,,‫בלינצ'ות שמתארחות במלון\N‫בעיר{\i1}{\fs10} {\r}!
Dialogue: 0,0:06:44.00,0:06:46.01,Main-207-,,0,0,0,,‫הם כבר עשו צ'ק-אאוט הבוקר.
Dialogue: 0,0:06:46.01,0:06:49.30,Main-207-,,0,0,0,,‫אולי פשוט נכין אחד?\N‫מה אומר השף?
Dialogue: 0,0:06:49.30,0:06:53.45,Main-207-,,0,0,0,,‫אני רוצה להכין בצק מיוחד.\N‫אפשר להביא לי שקדים?
Dialogue: 0,0:06:54.74,0:06:56.60,Main-207-,,0,0,0,,{\i1}‫אני אגיד לשר האגוזים!{\i}
Dialogue: 0,0:06:56.60,0:06:59.60,Main-207-,,0,0,0,,‫מאמא עכשיו בדרך לעיר המתוקה!
Dialogue: 0,0:06:59.60,0:07:04.10,Main-207-,,0,0,0,,‫היא באה לכאן?!\N‫זו הבירה! הטירה של מאמא נמצאת כאן!
Dialogue: 0,0:07:04.10,0:07:08.64,Main-207-,,0,0,0,,‫אי אפשר לשכנע אותה!\N‫היא מאבדת את דעתה מההתקף!
Dialogue: 0,0:07:12.02,0:07:14.11,Main-207-,,0,0,0,,‫מספר הקורבנות עדיין עולה!
Dialogue: 0,0:07:14.11,0:07:17.44,Main-207-,,0,0,0,,‫פרסמו פקודת פינוי בעיר המתוקה!
Dialogue: 0,0:07:17.44,0:07:21.46,Main-207-,,0,0,0,,‫רק {\i1}קרוקמבוש{\i0} יכול לעצור את מאמא עכשיו!
Dialogue: 0,0:07:21.46,0:07:24.62,Main-207-,,0,0,0,,‫לכאן! מהרו להתפנות!\N‫מהרו!
Dialogue: 0,0:07:26.17,0:07:28.38,Main-207-,,0,0,0,,‫מאמא, בבקשה עצרי!
Dialogue: 0,0:07:28.38,0:07:31.13,Main-207-,,0,0,0,,‫מאמא, בואי לא נעשה את זה!
Dialogue: 0,0:07:32.59,0:07:36.26,Main-207-,,0,0,0,,‫הביאו לי {\i1}קרוקמבוש{\fs10} {\r}!
Dialogue: 0,0:07:39.06,0:07:42.85,Main-207-,,0,0,0,,‫מאמא נכנסה לעיר המתוקה!\N‫היא נכנסה לעיר המתוקה!
Dialogue: 0,0:07:42.85,0:07:45.19,Main-207-,,0,0,0,,‫אה, היא סוף סוף כאן...
Dialogue: 0,0:07:45.19,0:07:49.47,Main-207-,,0,0,0,,‫שוטטות הרעב של מאמא\N‫מאוד מטרידה{\i1}{\fs10} {\r}!
Dialogue: 0,0:07:49.47,0:07:52.24,Main-207-,,0,0,0,,‫אף פעם לא יודעים מתי ההתקף יפרוץ.
Dialogue: 0,0:07:52.24,0:07:57.06,Main-207-,,0,0,0,,‫ההרס נמשך\N‫עד שהיא מקבלת ביס ממה שהיא חושקת בו.
Dialogue: 0,0:07:57.06,0:07:58.87,Main-207-,,0,0,0,,‫זה גרוע יותר מכל אסון.
Dialogue: 0,0:07:58.87,0:08:02.04,Main-207-,,0,0,0,,‫בכל מקרה, פנו את כל התושבים!
Dialogue: 0,0:08:02.04,0:08:03.93,Main-207-,,0,0,0,,‫ברחו! מהרו!
Dialogue: 0,0:08:03.93,0:08:05.88,Main-207-,,0,0,0,,‫ביג מאם עושה התפרצות!
Dialogue: 0,0:08:05.88,0:08:08.80,Main-207-,,0,0,0,,‫– עצרי!\N‫– לא בעיר הזאת!
Dialogue: 0,0:08:14.64,0:08:18.47,Main-207-,,0,0,0,,‫מאמא! מאמא! לא בעיר הזאת!
Dialogue: 0,0:08:18.47,0:08:23.02,Main-207-,,0,0,0,,‫– היא תהרוס את הטירה שלה!\N‫– זה לא עוזר. היא לא שומעת אותנו.
Dialogue: 0,0:08:33.15,0:08:37.63,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\fs10} {\r}!
Dialogue: 0,0:08:41.54,0:08:45.14,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\fs10} {\r}!
Dialogue: 0,0:08:51.96,0:08:54.22,Main-207-,,0,0,0,,‫זה לא זה!
Dialogue: 0,0:08:55.76,0:08:57.76,Main-207-,,0,0,0,,‫ת-תסתכלו למעלה!
Dialogue: 0,0:09:12.90,0:09:15.72,Main-207-,,0,0,0,,‫זה לא הטעם!
Dialogue: 0,0:09:15.72,0:09:18.54,Main-207-,,0,0,0,,‫גם אתם מפסידנים לא מה שאני רוצה!
Dialogue: 0,0:09:18.54,0:09:21.29,Main-207-,,0,0,0,,‫הכל לא בסדר!
Dialogue: 0,0:09:25.33,0:09:27.88,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\fs10} {\r}!
Dialogue: 0,0:09:29.13,0:09:30.92,Main-207-,,0,0,0,,‫תודה!
Dialogue: 0,0:09:31.89,0:09:34.51,Main-207-,,0,0,0,,‫אה, זה השר מוסקאטו!
Dialogue: 0,0:09:34.51,0:09:37.98,Main-207-,,0,0,0,,‫הבן ה-16 של משפחת שרלוט\N‫ושר הג'לאטו!
Dialogue: 0,0:09:37.98,0:09:41.51,Main-207-,,0,0,0,,‫הוא חבר במשפחה של מאמא!\N‫בטוח הוא יצליח לעצור אותה!
Dialogue: 0,0:09:41.51,0:09:46.02,Main-207-,,0,0,3,,‫פה מוסקאטו! מה עם ה{\i1}קרוקמבוש{\fs12} {\r}?!
Dialogue: 0,0:09:46.02,0:09:50.58,Main-207-,,0,0,0,,‫שמעתי שייקח עוד כחצי שעה\N‫עד שיהיה מוכן{\i1}{\fs10} {\r}!
Dialogue: 0,0:09:50.58,0:09:55.36,Main-207-,,0,0,0,,‫יהיה מאוחר מדי עד אז!\N‫אנחנו לא יכולים לתת לה להרוס את הטירה!
Dialogue: 0,0:09:59.70,0:10:01.49,Main-207-,,0,0,0,,‫זה לא זה!
Dialogue: 0,0:10:02.33,0:10:05.41,Main-207-,,0,0,0,,‫מאמא! תפסיקי!
Dialogue: 0,0:10:06.44,0:10:07.79,Main-207-,,0,0,0,,‫מי זה?!
Dialogue: 0,0:10:11.29,0:10:14.51,Main-207-,,0,0,0,,‫מאמא! זה אני! מוסקאטו!
Dialogue: 0,0:10:19.99,0:10:23.54,Main-207-,,0,0,0,,‫איפה ה{\i1}קרוקמבוש{\fs12} {\r}שלי?
Dialogue: 0,0:10:23.54,0:10:26.52,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\i0}...
Dialogue: 0,0:10:26.52,0:10:28.98,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\fs10} {\r}!
Dialogue: 0,0:10:28.98,0:10:34.65,Main-207-,,0,0,0,,‫תני לנו 30 דקות! השפים מנסים\N‫להכין אותו בהקדם האפשרי!
Dialogue: 0,0:10:34.65,0:10:38.70,Main-207-,,0,0,0,,‫לא, אח גדול מוס!\N‫אי אפשר לעצור אותה!
Dialogue: 0,0:10:38.70,0:10:41.49,Main-207-,,0,0,0,,‫אני לא יכול לתת לה להרוס את הבירה!
Dialogue: 0,0:10:42.55,0:10:45.49,Main-207-,,0,0,0,,‫הסתלקי מהדרך שלי!
Dialogue: 0,0:10:48.71,0:10:52.63,Main-207-,,0,0,0,,‫את לא מזהה אותי, מאמא?!
Dialogue: 0,0:11:04.64,0:11:06.56,Main-207-,,0,0,0,,‫חיים...
Dialogue: 0,0:11:06.93,0:11:07.60,Main-207-,,0,0,0,,‫או...
Dialogue: 0,0:11:08.61,0:11:11.35,Main-207-,,0,0,0,,‫ממתק!
Dialogue: 0,0:11:17.94,0:11:20.20,Main-207-,,0,0,0,,‫חיים או ממתק...
Dialogue: 0,0:11:20.20,0:11:22.36,Main-207-,,0,0,0,,‫חיי נצח או נשנוש!
Dialogue: 0,0:11:22.36,0:11:26.24,Main-207-,,0,0,0,,‫אי אפשר להאמין, מאמא!\N‫הוא הבן שלך!
Dialogue: 0,0:11:26.24,0:11:28.30,Main-207-,,0,0,0,,‫מאמא, אל תעשי את זה!
Dialogue: 0,0:11:28.30,0:11:34.25,Main-207-,,0,0,0,,‫י-יש לנו פה קצפת!\N‫עוד אין בצק, אבל מאמא, אל!
Dialogue: 0,0:11:34.94,0:11:37.55,Main-207-,,0,0,0,,‫הממ-הממתק עוד לא כאן!
Dialogue: 0,0:11:37.55,0:11:40.13,Main-207-,,0,0,0,,‫אני אקח את הממתק.
Dialogue: 0,0:11:41.62,0:11:43.68,Main-207-,,0,0,0,,‫אל תעמדי לי בדרך!
Dialogue: 0,0:11:58.65,0:12:00.19,Main-207-,,0,0,0,,‫מאמא!
Dialogue: 0,0:12:00.19,0:12:02.32,Main-207-,,0,0,0,,‫מוסקאטו, תישאר רגוע!
Dialogue: 0,0:12:04.99,0:12:09.50,Main-207-,,0,0,0,,‫לא! כל סימן של פחד\N‫ויקחו לך את שנות החיים!
Dialogue: 0,0:12:16.82,0:12:21.22,Main-207-,,0,0,0,,‫רחמי עלי, מאמא!\N‫לא אעצור אותך יותר!
Dialogue: 0,0:12:21.22,0:12:24.76,Main-207-,,0,0,0,,‫רק בבקשה! אל תהרגי אותי!
Dialogue: 0,0:12:42.01,0:12:44.49,Main-207-,,0,0,0,,‫תני לי 40 שנה.
Dialogue: 0,0:12:51.04,0:12:52.55,Main-207-,,0,0,0,,‫אח גדול!
Dialogue: 0,0:12:54.02,0:12:56.03,Main-207-,,0,0,0,,‫שר מוסקאטו!
Dialogue: 0,0:12:56.03,0:12:57.83,Main-207-,,0,0,0,,‫היא הרגה...
Dialogue: 0,0:12:58.92,0:13:02.32,Main-207-,,0,0,0,,‫את הבן שלה עצמו!
Dialogue: 0,0:13:05.42,0:13:09.10,Main-207-,,0,0,0,,{\i1}‫קרוקמבוש{\fs10} {\r}!
Dialogue: 0,0:13:09.67,0:13:13.52,Main-207-,,0,0,0,,‫ברחו! אף אחד לא יכול לעצור אותה עכשיו!
Dialogue: 0,0:13:19.48,0:13:21.27,Main-207-,,0,0,0,,‫זה נורא.
Dialogue: 0,0:13:28.16,0:13:31.08,Main-207-,,0,0,0,,‫מישהו בא מנהר המיץ!
Dialogue: 0,0:13:31.08,0:13:33.33,Main-207-,,0,0,0,,‫– זה...\N‫– האיש הזה הוא...
Dialogue: 0,0:13:33.33,0:13:34.75,Main-207-,,0,0,0,,‫אין ספק!
Dialogue: 0,0:13:34.75,0:13:37.83,Main-207-,,0,0,3,,‫כולם, זוזו!
Dialogue: 0,0:13:37.83,0:13:40.54,Main-207-,,0,0,3,,‫זה הבוס ג'ינביי!
Dialogue: 0,0:13:41.13,0:13:43.21,Main-207-,,0,0,0,,‫עזרה!
Dialogue: 0,0:13:43.21,0:13:45.51,Main-207-,,0,0,0,,‫נאכל אותנו!
Dialogue: 0,0:13:46.18,0:13:48.85,Main-207-,,0,0,0,,‫יש לו {\i1}קרוקמבוש{\i0} בצד שלו!
Dialogue: 0,0:13:48.85,0:13:52.64,Main-207-,,0,0,0,,‫הוא תפס את תיירי הבלינצ'ות בשבילנו!
Dialogue: 0,0:13:52.64,0:13:57.23,Main-207-,,0,0,0,,‫הם מצופים בסוכרייה!\N‫השר של הסוכרייה עשה את זה?!
Dialogue: 0,0:14:02.56,0:14:04.50,Main-207-,,0,0,0,,‫תסתכלו לכאן!
Dialogue: 0,0:14:05.32,0:14:07.70,Main-207-,,0,0,0,,‫אל תעמדי לי בדרך!
Dialogue: 0,0:14:08.99,0:14:11.24,Main-207-,,0,0,0,,‫תתפסי את זה!
Dialogue: 0,0:14:34.68,0:14:38.39,Main-207-,,0,0,0,,‫זה טעים!
Dialogue: 0,0:14:40.01,0:14:43.65,Main-207-,,0,0,0,,‫– כן!\N‫– מאמא נרגעה!
Dialogue: 0,0:14:44.98,0:14:47.28,Main-207-,,0,0,0,,‫זה זה!
Dialogue: 0,0:14:47.81,0:14:52.13,Main-207-,,0,0,0,,‫אם זה טעים,\N‫זה כל מה שחשוב...
Dialogue: 0,0:14:52.13,0:14:55.54,Main-207-,,0,0,0,,‫תודה, בוס ג'ינביי!
Dialogue: 0,0:14:56.95,0:15:00.08,Main-207-,,0,0,0,,‫הגידו לשפים! המשבר נגמר!
Dialogue: 0,0:15:00.08,0:15:02.44,Main-207-,,0,0,0,,‫זמנו את כל השרים!
Dialogue: 0,0:15:02.44,0:15:06.06,Main-207-,,0,0,0,,‫שקמו את הבירה\N‫בהקדם האפשרי{\i1}{\fs10} {\r}!
Dialogue: 0,0:15:08.80,0:15:14.35,Main-207-,,0,0,0,,‫אה, ג'ינביי הנאמן שלי, אביר הים!
Dialogue: 0,0:15:14.35,0:15:19.06,Main-207-,,0,0,3,,‫כל הכבוד על שהבאת לי את לוח הפונגליף אתמול.
Dialogue: 0,0:15:19.06,0:15:21.38,Main-207-,,0,0,3,,‫אם כי אני לא יכולה לקרוא אותו.
Dialogue: 0,0:15:26.86,0:15:31.39,Main-207-,,0,0,0,,‫מה אתה רוצה היום?\N‫למה יצאנו לכאן?
Dialogue: 0,0:15:31.82,0:15:36.33,Main-207-,,0,0,0,,‫אוה? העיר נראית טוב מתמיד.
Dialogue: 0,0:15:36.33,0:15:38.58,Main-207-,,0,0,0,,‫אתה עשית את זה?
Dialogue: 0,0:15:38.58,0:15:44.00,Main-207-,,0,0,0,,‫לא, רק הגעתי,\N‫ואין לי מושג מה קרה, גברתי.
Dialogue: 0,0:15:44.00,0:15:46.42,Main-207-,,0,0,0,,‫אה...?
Dialogue: 0,0:15:46.42,0:15:48.63,Main-207-,,0,0,0,,‫אני כאן...
Dialogue: 0,0:15:50.22,0:15:54.72,Main-207-,,0,0,0,,‫כדי להגיד לך משהו חשוב היום.
Dialogue: 0,0:16:00.89,0:16:04.65,Main-207-,,0,0,0,,‫אתה לא הולך לעזוב את הצוות שלי, כן?
Dialogue: 0,0:16:12.04,0:16:17.41,Main-207-,,0,0,0,,‫לופי עם כובע הקש\N‫ישנה את העולם יום אחד!
Dialogue: 0,0:16:18.00,0:16:21.97,Main-207-,,0,0,0,,‫אני יודע שהוא עדיין צעיר,\N‫אבל אני לא חושב שאף אחד מ
Dialogue: 0,0:16:21.97,0:16:24.71,Main-207-,,0,0,0,,‫ארבעת הקיסרים הנוכחיים\N‫יהפוך למלך הים!
Dialogue: 0,0:16:25.22,0:16:29.34,Main-207-,,0,0,0,,‫אני חושב שלופי עם כובע הקש יהיה זה!
Dialogue: 0,0:16:32.98,0:16:33.88,Main-207-,,0,0,0,,‫אני...
Dialogue: 0,0:16:34.97,0:16:38.31,Main-207-,,0,0,0,,‫רוצה לעזור לו!
Dialogue: 0,0:16:44.32,0:16:46.21,Flashbacks-207-,,0,0,0,,‫אני חלש מדי...
Dialogue: 0,0:16:46.70,0:16:48.86,Flashbacks-207-,,0,0,0,,‫חלש!
Dialogue: 0,0:16:48.86,0:16:54.50,Main-207-,,0,0,0,,‫אני... אני רוצה לעלות על הספינה שלו
Dialogue: 0,0:16:54.50,0:16:57.82,Main-207-,,0,0,0,,‫ולהקדיש את חיי לו!
Dialogue: 0,0:16:57.82,0:17:04.46,Main-207-,,0,0,0,,‫אני מאמין שהמסע הזה יביא חופש אמיתי\N‫לאנשי הדג בסוף!
Dialogue: 0,0:17:08.26,0:17:12.02,Main-207-,,0,0,3,,‫בשנתיים האחרונות,
Dialogue: 0,0:17:12.02,0:17:14.80,Main-207-,,0,0,3,,‫סיפרת לנו הרבה על לופי{\i1}{\i0}.
Dialogue: 0,0:17:14.80,0:17:19.93,Main-207-,,0,0,0,,‫חשבתי שאתה כבר צריך ללכת להצטרף אליו\N‫אם אתה כל כך אוהב אותו.
Dialogue: 0,0:17:20.86,0:17:22.68,Main-207-,,0,0,0,,‫מ-מה?! באמת?!
Dialogue: 0,0:17:23.28,0:17:25.64,Main-207-,,0,0,0,,‫דיברתי עליו כל כך הרבה?!
Dialogue: 0,0:17:28.25,0:17:30.65,Main-207-,,0,0,0,,‫לך, ג'ינביי!
Dialogue: 0,0:17:33.59,0:17:35.32,Main-207-,,0,0,0,,‫אתה בטוח?
Dialogue: 0,0:17:37.07,0:17:40.74,Main-207-,,0,0,0,,‫אף אחד כאן לא יכול להתנגד, קפטן!
Dialogue: 0,0:17:40.74,0:17:46.60,Main-207-,,0,0,0,,‫כן! היית חייל בצבא נפטון,\N‫אבל הפכת לפיראט
Dialogue: 0,0:17:46.60,0:17:51.67,Main-207-,,0,0,0,,‫כדי להלחם איתנו, העבדים לשעבר\N‫שברחו ממארי גואז!
Dialogue: 0,0:17:51.67,0:17:57.04,Main-207-,,0,0,0,,‫הפכת לאציל\N‫כדי לקדם את המעמד החברתי של אנשי הדג!
Dialogue: 0,0:17:57.04,0:18:01.57,Main-207-,,0,0,0,,‫והצטרפת לפיראטים של ביג מאם
Dialogue: 0,0:18:01.57,0:18:07.98,Main-207-,,0,0,0,,‫כדי להגן עלינו ועל ביתנו,\N‫ממלכת ריוגו, תחת שמה של ביג מאם.
Dialogue: 0,0:18:07.98,0:18:13.71,Main-207-,,0,0,0,,‫תמיד קיבלת החלטות\N‫למען אחרים!
Dialogue: 0,0:18:14.28,0:18:18.21,Main-207-,,0,0,0,,‫עשית מספיק, ג'ינביי.
Dialogue: 0,0:18:20.83,0:18:24.29,Main-207-,,0,0,0,,‫כן! תהיה חופשי, ג'ינביי{\i1}{\fs10} {\r}!
Dialogue: 0,0:18:24.29,0:18:28.38,Main-207-,,0,0,0,,‫– לך, ג'ינביי!\N‫– כן, קפטן ג'ינביי!
Dialogue: 0,0:18:28.38,0:18:32.21,Main-207-,,0,0,0,,‫נסתדר בלעדיך.\N‫אל תזלזל בנו!
Dialogue: 0,0:18:32.21,0:18:36.09,Main-207-,,0,0,0,,‫תחיה למען עצמך מעכשיו!
Dialogue: 0,0:18:52.15,0:18:55.36,Main-207-,,0,0,0,,‫אתם... תודה!
Dialogue: 0,0:19:05.85,0:19:12.00,Main-207-,,0,0,0,,‫אחרי כל זה... אני לא חושב שביג\N‫מאם תשחרר את הקפטן כל כך בקלות.
Dialogue: 0,0:19:12.00,0:19:17.61,Main-207-,,0,0,0,,‫אם היא כועסת גם עלינו,\N‫כל מה שנוכל לעשות זה לברוח!
Dialogue: 0,0:19:17.61,0:19:20.34,Main-207-,,0,0,0,,‫אבל מה עם אלאדין{\i1}{\fs12} {\r}?
Dialogue: 0,0:19:21.12,0:19:25.87,Main-207-,,0,0,0,,‫הוא התחתן עם גברת פראליין\N‫והפך לחבר במשפחה של ביג מאם.
Dialogue: 0,0:19:25.87,0:19:27.97,Main-207-,,0,0,0,,‫אה?
Dialogue: 0,0:19:29.66,0:19:32.81,Main-207-,,0,0,0,,‫אתם דואגים לי?
Dialogue: 0,0:19:32.81,0:19:34.36,Main-207-,,0,0,0,,‫אה, גברת!
Dialogue: 0,0:19:39.24,0:19:42.45,Main-207-,,0,0,0,,‫אתם מדברים מאחורי הגב שלי?
Dialogue: 0,0:19:42.45,0:19:44.99,Main-207-,,0,0,0,,‫שמעת מה אמרנו?!
Dialogue: 0,0:19:44.99,0:19:49.00,Main-207-,,0,0,0,,‫היי, אתם מנסים\N‫להסתיר ממני משהו?!
Dialogue: 0,0:19:48.98,0:19:56.26,Main-207-,,0,0,0,,‫אלאדין! אל תגיד לי שהיית\N‫הולך לעזוב אותי אם מאמא כועסת!
Dialogue: 0,0:19:56.26,0:19:58.63,Main-207-,,0,0,0,,‫לא, כמובן, הייתי שואל אותך...
Dialogue: 0,0:19:58.63,0:20:01.09,Main-207-,,0,0,0,,‫אין צורך לשאול!
Dialogue: 0,0:20:01.09,0:20:07.14,Main-207-,,0,0,0,,‫אני בהחלט אבחר בך על פני מאמא!\N‫אם משהו קורה, קחי אותי איתך!
Dialogue: 0,0:20:07.14,0:20:09.06,Main-207-,,0,0,0,,‫כל כך נלהב!
Dialogue: 0,0:20:11.13,0:20:13.08,Main-207-,,0,0,0,,‫סליחה, ואדאצומי.
Dialogue: 0,0:20:13.08,0:20:16.09,Main-207-,,0,0,0,,‫רק הבאתי אותך לכאן, אבל\N‫כפי ששמעת, אני צריך ללכת.
Dialogue: 0,0:20:16.09,0:20:21.70,Main-207-,,0,0,0,,‫זה בסדר! אני כל כך שמח\N‫להיות עם האנשים האלו.
Dialogue: 0,0:20:24.51,0:20:31.50,Main-207-,,0,0,0,,‫עכשיו, פראליין, את לא חושבת שמאמא\N‫תסלח לי... כלומר, לנו?
Dialogue: 0,0:20:31.50,0:20:38.87,Main-207-,,0,0,0,,‫ובכן, היו תקדימים,\N‫אבל אלו שרצו לעזוב את הצוות שלה...
Dialogue: 0,0:20:38.87,0:20:40.71,Main-207-,,0,0,0,,‫כולם מתים.
Dialogue: 0,0:21:05.07,0:21:07.32,Main-207-,,0,0,0,,‫שר מוסקאטו!
Dialogue: 0,0:21:07.32,0:21:10.66,Main-207-,,0,0,0,,‫שר מוסקאטו מת!
Dialogue: 0,0:21:10.66,0:21:13.62,Main-207-,,0,0,0,,‫אל תמות, שר מוסקאטו!
Dialogue: 0,0:21:13.62,0:21:16.00,Main-207-,,0,0,0,,‫שר מוסקאטו!
Dialogue: 0,0:21:23.34,0:21:25.22,Main-207-,,0,0,0,,‫הם סוף סוף כאן.
Dialogue: 0,0:21:32.53,0:21:34.00,Main-207-,,0,0,0,,‫מהרו ולקחו אותו מכאן.
Dialogue: 0,0:21:34.00,0:21:34.60,Main-207-,,0,0,0,,‫כן, גברתי.
Dialogue: 0,0:21:34.60,0:21:36.94,Main-207-,,0,0,0,,‫תסתלקו.
Dialogue: 0,0:21:47.12,0:21:48.32,Main-207-,,0,0,0,,‫תקשיבו, חברים.
Dialogue: 0,0:21:48.32,0:21:52.54,Main-207-,,0,0,0,,‫כל שנייה אחרונה. בסדר?
Dialogue: 0,0:22:02.21,0:22:03.80,Main-207-,,0,0,0,,‫שר מוסקאטו...
Dialogue: 0,0:22:06.67,0:22:11.28,Main-207-,,0,0,0,,‫תגיד, אתה חושב שגם הבוס ג'ינביי\N‫ייהרג, שר מון ד'אור?!
Dialogue: 0,0:22:11.28,0:22:12.98,Main-207-,,0,0,0,,‫מניין אדע?!
Dialogue: 0,0:22:12.98,0:22:16.92,Main-207-,,0,0,0,,‫כשמישהו מכעיס את מאמא,\N‫זה בוודאי מה שקורה,
Dialogue: 0,0:22:16.92,0:22:18.52,Main-207-,,0,0,0,,‫אפילו אם זה הבן שלה!
Dialogue: 0,0:22:29.68,0:22:32.74,Main-207-,,0,0,0,,‫אני מניח שאתה עוזב, ג'ינביי.
Dialogue: 0,0:22:35.56,0:22:39.34,Main-207-,,0,0,0,,‫– למה, בוס?!\N‫– אל תעזוב, בוס! למה אתה צריך לעזוב?!
Dialogue: 0,0:22:39.34,0:22:40.75,Main-207-,,0,0,0,,‫שתקו!
Dialogue: 0,0:22:46.88,0:22:51.60,Main-207-,,0,0,0,,‫אל תשאלו מישהו למה הוא עוזב!\N‫זה עלוב!
Dialogue: 0,0:22:51.60,0:22:54.38,Main-207-,,0,0,0,,‫למי אכפת?!
Dialogue: 0,0:22:57.46,0:23:02.52,Main-207-,,0,0,0,,‫אם אתה פיראט,\N‫כמובן שאתה רוצה לחיות כמו שאתה רוצה.
Dialogue: 0,0:23:03.01,0:23:05.69,Main-207-,,0,0,0,,‫אני טעים? תגידו לי, אני...?!
Dialogue: 0,0:23:08.22,0:23:10.14,Main-207-,,0,0,0,,‫אחרי כל זה,
Dialogue: 0,0:23:10.14,0:23:15.90,Main-207-,,0,0,0,,‫שבירת שבועת נאמנות\N‫מביישת את האדון.
Dialogue: 0,0:23:16.88,0:23:23.10,Main-207-,,0,0,0,,‫ג'ינביי, אתה יודע שזה אומר\N‫שאני הולכת לאבד נכס חזק: אותך.
Dialogue: 0,0:23:23.10,0:23:24.92,Main-207-,,0,0,0,,‫כן, אבל...
Dialogue: 0,0:23:24.92,0:23:30.49,Main-207-,,0,0,0,,‫אין אבל! גם אתה צריך לאבד משהו!
Dialogue: 0,0:23:30.49,0:23:33.09,Main-207-,,0,0,0,,‫אתה צריך לשלם מחיר!
Dialogue: 0,0:23:39.63,0:23:41.50,Main-207-,,0,0,0,,‫הביאו לי את הרולטה!
Dialogue: 0,0:23:41.50,0:23:42.81,Main-207-,,0,0,0,,‫מה?
Dialogue: 0,0:23:57.60,0:24:00.36,Main-207-,,0,0,0,,‫עכשיו, סובב אותה.
Dialogue: 0,0:24:05.00,0:24:11.93,Main-207-,,0,0,0,,‫אני לא יכולה לחכות לראות מה אתה הולך לאבד!
Dialogue: 0,0:24:18.18,0:24:23.27,Narrator,,0,0,0,,‫בינתיים, לופי ואחרים\N‫שטים בשטח של ביג מאם.
Dialogue: 0,0:24:25.92,0:24:27.52,Main-207-,,0,0,0,,‫כל כך מתוק!
Dialogue: 0,0:24:28.89,0:24:31.34,Main-207-,,0,0,0,,‫בכל מקרה, זה בכלל לא זז.
Dialogue: 0,0:24:31.34,0:24:32.63,Main-207-,,0,0,0,,‫לא...
Dialogue: 0,0:24:32.63,0:24:35.43,Main-207-,,0,0,0,,‫אז בואו פשוט נישאר כאן ונישן!
Dialogue: 0,0:24:35.43,0:24:39.29,Main-207-,,0,0,0,,‫לא! מה אם הנמלים ההן יתקפו אותנו שוב?!
Dialogue: 0,0:24:39.29,0:24:43.16,Main-207-,,0,0,0,,‫כשהשמש תזרח,\N‫זה יתחיל לזרום שוב.
Dialogue: 0,0:24:43.16,0:24:46.44,Main-207-,,0,0,0,,‫אבל בלילה,\N‫זה מתקרר ומתמצק.
Dialogue: 0,0:24:46.44,0:24:49.50,Main-207-,,0,0,0,,‫תשתפו דברים כאלו מראש!
Dialogue: 0,0:24:50.96,0:24:55.11,Main-207-,,0,0,0,,‫אנחנו חייבים להמיס את זה ולצאת\N‫מאזור הסירופ הזה!
Dialogue: 0,0:24:55.11,0:24:55.84,Main-207-,,0,0,0,,‫כן!
Dialogue: 0,0:24:56.45,0:24:57.95,Main-207-,,0,0,0,,‫משכו!
Dialogue: 0,0:24:57.95,0:25:01.60,Main-207-,,0,0,0,,‫הרדמנו את צבא הנמלים!
Dialogue: 0,0:25:01.60,0:25:04.15,Main-207-,,0,0,0,,‫יהיו צרות כשיתעוררו.
Dialogue: 0,0:25:04.15,0:25:05.85,Main-207-,,0,0,0,,‫נכון.
Dialogue: 0,0:25:08.77,0:25:12.55,Main-207-,,0,0,0,,‫הנמלים הים האלו פעם אכלו את הספינה שלי.
Dialogue: 0,0:25:12.55,0:25:13.53,Main-207-,,0,0,0,,‫אוי לי!
Dialogue: 0,0:25:13.53,0:25:17.66,Main-207-,,0,0,0,,‫פעם? מה באתם לכאן בשבילו?
Dialogue: 0,0:25:17.66,0:25:22.15,Main-207-,,0,0,0,,‫פדרו היה פיראט\N‫ביחד עם פקומס.
Dialogue: 0,0:25:22.15,0:25:24.68,Main-207-,,0,0,0,,‫מה?! ברצינות?!
Dialogue: 0,0:25:25.20,0:25:27.70,Main-207-,,0,0,0,,‫הייתי כל כך נאיבי.
Dialogue: 0,0:25:27.70,0:25:31.96,Main-207-,,0,0,0,,‫חשבתי על עצמי כמגלה,\N‫אבל הפכתי לנרדף.
Dialogue: 0,0:25:31.96,0:25:34.80,Main-207-,,0,0,0,,‫ליוויתי את פקומס רק חצי דרך.
Dialogue: 0,0:25:36.68,0:25:39.60,Main-207-,,0,0,0,,‫אני סומך עליכם, אז אני יכול לספר לכם.
Dialogue: 0,0:25:39.60,0:25:45.44,Main-207-,,0,0,0,,‫חיפשתי פונגליפים\N‫כי רציתי לעזור לאדון נקומאמושי.
Dialogue: 0,0:25:47.19,0:25:53.53,Main-207-,,0,0,0,,‫אבל כשהסגתי גבול בשטח של ביג מאם,\N‫זה הפך למסע האחרון שלי.
Dialogue: 0,0:25:56.22,0:25:57.45,Main-207-,,0,0,0,,‫אני...
Dialogue: 0,0:25:57.45,0:26:00.36,Main-207-,,0,0,0,,‫הובסתי כאן פעם אחת.
Dialogue: 0,0:26:07.03,0:26:09.50,Main-207-,,0,0,0,,‫כמעט לא סיפרתי לאף אחד על זה.
Dialogue: 0,0:26:09.96,0:26:12.34,Main-207-,,0,0,0,,‫לא ידעתי את זה.
Dialogue: 0,0:26:20.30,0:26:23.77,Main-207-,,0,0,0,,‫יש לך זכרונות רעים,\N‫ובכל זאת חזרת?
Dialogue: 0,0:26:23.77,0:26:29.19,Main-207-,,0,0,0,,‫אם הניסיון שלי יעזור לכם אפילו מעט\N‫להחזיר את סאנג'י, אני אשמח.
Dialogue: 0,0:26:30.61,0:26:32.61,Main-207-,,0,0,0,,‫מעבר לזה,
Dialogue: 0,0:26:32.61,0:26:36.48,Main-207-,,0,0,0,,‫אולי לא היה כל כך גרוע שבאתי.
Dialogue: 0,0:26:37.54,0:26:43.20,Main-207-,,0,0,0,,‫שמעתי שהמלכים שלנו הראו לכם\N‫את לוח הפונגליף הראשי בעץ הלווייתן.
Dialogue: 0,0:26:43.20,0:26:44.74,Main-207-,,0,0,0,,‫כן.
Dialogue: 0,0:26:44.74,0:26:47.31,Main-207-,,0,0,0,,‫הופתעתי.
Dialogue: 0,0:26:47.79,0:26:49.64,Main-207-,,0,0,0,,‫אפילו שאולי הצלתם אותנו,
Dialogue: 0,0:26:49.64,0:26:53.17,Main-207-,,0,0,0,,‫הם לא הראו אותו לאף אחד\N‫מחוץ לשושלת קוזוקי...
Dialogue: 0,0:26:53.17,0:26:56.13,Main-207-,,0,0,0,,‫במשך 26 שנה...
Dialogue: 0,0:26:56.13,0:26:59.84,Main-207-,,0,0,0,,‫מאז שהראו אותו\N‫לקבוצת הפיראטים של גול ד. רוג'ר.
Dialogue: 0,0:27:00.56,0:27:01.93,Main-207-,,0,0,0,,‫מלך הפיראטים?!
Dialogue: 0,0:27:02.36,0:27:07.45,Main-207-,,0,0,0,,‫אחר כך, רוג'ר הגיע ללאף טייל\N‫ונקרא מלך הפיראטים.
Dialogue: 0,0:27:09.64,0:27:16.11,Main-207-,,0,0,0,,‫אתם מזכירים\N‫לדוכס אינוארשי ולאדון נקומאמושי אותם.
Dialogue: 0,0:27:18.61,0:27:23.57,Main-207-,,0,0,0,,‫הם מצפים שתהפכו\N‫למישהו שיצטרך את לוחות הפונגליף הראשיים.
Dialogue: 0,0:27:23.99,0:27:27.26,Main-207-,,0,0,0,,‫מה אתה הולך לעשות אחרי שתנצח את קאידו?
Dialogue: 0,0:27:27.70,0:27:30.79,Main-207-,,0,0,0,,‫זה רחוק מדי!\N‫לא חשבתי על זה...
Dialogue: 0,0:27:30.79,0:27:34.96,Main-207-,,0,0,0,,‫אחר כך, תצטרך את לוח הפונגליף הראשי\N‫שיש לביג מאם!
Dialogue: 0,0:27:35.81,0:27:39.48,Main-207-,,0,0,0,,‫אם כן, זאת ההזדמנות הגדולה ביותר שלנו!
Dialogue: 0,0:27:39.48,0:27:42.55,Main-207-,,0,0,0,,‫מאחר שנכנסנו כל כך עמוק לשטח שלה,
Dialogue: 0,0:27:42.55,0:27:48.14,Main-207-,,0,0,0,,‫כדאי גם לגנוב את לוח הפונגליף הראשי של ביג מאם\N‫בנוסף להחזרת סאנג'י!
Dialogue: 0,0:27:50.39,0:27:53.79,Main-207-,,0,0,0,,‫מה? אבל זה...
Dialogue: 0,0:27:54.82,0:27:57.40,Main-207-,,0,0,0,,‫לא רק סאנג'י, אלא גם לוח פונגליף ראשי?
Dialogue: 0,0:28:00.37,0:28:05.42,Main-207-,,0,0,0,,‫ובכן, רובין ביקשה ממני להשיג אותו גם,\N‫אבל קודם אני רוצה להציל את סאנג'י...
Dialogue: 0,0:28:05.42,0:28:07.16,Main-207-,,0,0,0,,‫אני מבין.
Dialogue: 0,0:28:07.16,0:28:11.89,Main-207-,,0,0,0,,‫אני אשיג את לוח הפונגליף הראשי.\N‫אתם לכו על סאנג'י.
Dialogue: 0,0:28:11.89,0:28:12.87,Main-207-,,0,0,0,,‫מה?
Dialogue: 0,0:28:14.63,0:28:18.77,Main-207-,,0,0,0,,‫כשנגיע לאי,\N‫אפשר שיהיה לי קצת זמן?
Dialogue: 0,0:28:18.77,0:28:20.47,Main-207-,,0,0,0,,‫הפעם אני אשיג אותו!
Dialogue: 0,0:28:20.47,0:28:24.59,Main-207-,,0,0,0,,‫לא, אבל אם אתה עושה את זה בשבילנו,\N‫אנחנו ניבוא איתך!
Dialogue: 0,0:28:24.59,0:28:28.14,Main-207-,,0,0,0,,‫לא, דאגו להגן על סאנג'י.
Dialogue: 0,0:28:28.14,0:28:30.43,Main-207-,,0,0,0,,‫גם אחרי שתחזירו אותו,\N‫הדברים יהיו קשים.
Dialogue: 0,0:28:35.69,0:28:38.75,Main-207-,,0,0,0,,‫בסדר. אז אני משאיר לך את זה!
Dialogue: 0,0:28:39.36,0:28:41.00,Main-207-,,0,0,0,,‫מצוין!
Dialogue: 0,0:28:41.00,0:28:42.65,Main-207-,,0,0,0,,‫אל תחליטו כל כך בקלות!
Dialogue: 0,0:28:44.52,0:28:49.24,Main-207-,,0,0,0,,‫תהה אם לופי{\i1}{\i} נולד בר מזל...
Dialogue: 0,0:28:50.78,0:28:51.86,Main-207-,,0,0,0,,‫מה קורה, ברוק?
Dialogue: 0,0:28:51.86,0:28:54.87,Main-207-,,0,0,0,,‫כלום. גם אני בר מזל.
Dialogue: 0,0:28:54.87,0:28:58.00,Main-207-,,0,0,0,,‫על מה אתה מדבר? אתה מוזר.
Dialogue: 0,0:29:10.81,0:29:13.84,Main-207-,,0,0,0,,‫אה, הנמלים התעוררו!
Dialogue: 0,0:29:13.84,0:29:15.06,Main-207-,,0,0,0,,‫לא!
Dialogue: 0,0:29:17.80,0:29:19.45,Main-207-,,0,0,0,,‫הם באים!
Dialogue: 0,0:29:20.15,0:29:22.95,Main-207-,,0,0,0,,‫תצילו את ה{\i1}סאני{\fs10} {\r}!
Dialogue: 0,0:29:34.28,0:29:36.30,Main-207-,,0,0,0,,‫היי, חברים!
Dialogue: 0,0:29:36.30,0:29:37.71,Main-207-,,0,0,0,,‫התעוררו!
Dialogue: 0,0:29:42.03,0:29:43.97,Main-207-,,0,0,0,,‫הא? מה קרה?
Dialogue: 0,0:29:55.13,0:29:57.15,Main-207-,,0,0,0,,‫תראו! תראו!
Dialogue: 0,0:30:08.91,0:30:10.53,Main-207-,,0,0,0,,‫הגענו סוף סוף!
Dialogue: 0,0:30:17.28,0:30:21.24,Main-207-,,0,0,0,,‫וואו, זה עצום!
Dialogue: 0,0:30:21.24,0:30:24.14,Main-207-,,0,0,0,,‫אז כאן גר קיסר!
Dialogue: 0,0:30:25.58,0:30:27.51,Main-207-,,0,0,0,,‫יש עוגה!
Dialogue: 0,0:30:29.59,0:30:34.51,Main-207-,,0,0,0,,‫עוגת הקשר הגבוהה ביותר היא הטירה\N‫שבה גרה ביג מאם.
Dialogue: 0,0:30:34.51,0:30:36.15,Main-207-,,0,0,0,,‫טירה?!
Dialogue: 0,0:30:36.15,0:30:38.90,Main-207-,,0,0,0,,‫נאמי{\i1}{\i}, נמשיך\N‫ישר ככה?
Dialogue: 0,0:30:38.90,0:30:42.85,Main-207-,,0,0,0,,‫כן, הכף הזו היא\N‫המקום היחיד ללא אבטחה.
Dialogue: 0,0:30:42.85,0:30:44.57,Main-207-,,0,0,0,,‫מובן.
Dialogue: 0,0:30:44.57,0:30:47.10,Main-207-,,0,0,0,,‫זה המקום שפודינג{\i1}{\i} ציינה.
Dialogue: 0,0:30:47.10,0:30:50.81,Main-207-,,0,0,0,,‫כן, אנחנו ממש חייבים להודות לה.
Dialogue: 0,0:30:50.81,0:30:54.53,Main-207-,,0,0,0,,‫אם לא היה לה,\N‫לא יודעת אם היינו מגיעים עד כאן.
Dialogue: 0,0:30:54.53,0:30:56.12,Main-207-,,0,0,0,,‫צודקת.
Dialogue: 0,0:30:58.41,0:31:00.96,Main-207-,,0,0,0,,‫היי, יש שם מישהו!
Dialogue: 0,0:31:08.54,0:31:09.93,Main-207-,,0,0,0,,‫סאנג'י?
Dialogue: 0,0:31:09.93,0:31:13.17,Main-207-,,0,0,0,,‫זה סאנג'י?! היי!
Dialogue: 0,0:31:13.17,0:31:15.97,Main-207-,,0,0,0,,‫סאנג'י!
Dialogue: 0,0:00:00.09,0:00:03.62,Credits,,0,0,0,,{\fad(500,0)\pos(503,240)\blur0.1\bord2.5\fscx130\fscy130\c&H000000&}Team One Pace
