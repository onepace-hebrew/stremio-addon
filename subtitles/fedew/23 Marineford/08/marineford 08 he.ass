Dialogue: 0,0:02:31.28,0:02:39.89,Title,,0,0,240,,{\fad(1200,1300)}‫האיש שזעזע את העולם
Dialogue: 0,0:03:19.09,0:03:20.91,Main,,0,0,0,,‫זקן לבן...
Dialogue: 0,0:03:21.19,0:03:24.32,Main,,0,0,0,,‫שיפדו את זקן לבן!
Dialogue: 0,0:03:34.51,0:03:35.33,Main,,0,0,0,,‫הזקן...
Dialogue: 0,0:03:36.64,0:03:38.65,Main,,0,0,0,,‫מי עשה את זה?!
Dialogue: 0,0:03:38.65,0:03:40.23,Main,,0,0,0,,‫נדמה לי שזה...
Dialogue: 0,0:03:41.32,0:03:44.88,Main,,0,0,0,,‫קפטן מהברית של זקן לבן דקר אותו...
Dialogue: 0,0:03:44.88,0:03:47.21,Main,,0,0,0,,‫מפיראטי העולם החדש, עכביש המערבולת...
Dialogue: 0,0:03:47.21,0:03:48.91,Main,,0,0,0,,‫סקווארד!
Dialogue: 0,0:03:50.22,0:03:52.45,Main,,0,0,0,,‫למה עשית את זה?!
Dialogue: 0,0:03:52.45,0:03:53.81,Main,,0,0,0,,‫תענה לי, סקווארד!
Dialogue: 0,0:03:53.81,0:03:57.58,Main,,0,0,0,,‫ת-תסתמו! לא השארתם לי ברירה!
Dialogue: 0,0:03:57.58,0:04:01.39,Main,,0,0,0,,‫מה?! אתה קולט מה עשית-
Dialogue: 0,0:04:04.63,0:04:07.76,Main,,0,0,0,,‫אבא! אל תאמץ את הגוף ככה-
Dialogue: 0,0:04:07.76,0:04:09.04,Main,,0,0,0,,‫אבא!
Dialogue: 0,0:04:13.44,0:04:17.13,Main,,0,0,0,,‫תפסיק לשחק, זקן לבן!
Dialogue: 0,0:04:18.10,0:04:21.09,Main,,0,0,0,,‫עשית עסקה עם הצי, נכון?!
Dialogue: 0,0:04:21.09,0:04:27.24,Main,,0,0,0,,‫אייס ופיראטי זקן לבן\N‫יוצאים מזה בחיים!
Dialogue: 0,0:04:28.92,0:04:32.55,Main,,0,0,0,,‫על מה סקווארד מדבר?
Dialogue: 0,0:04:32.55,0:04:33.59,Main,,0,0,0,,‫מה קורה פה?!
Dialogue: 0,0:04:33.94,0:04:37.49,Main,,0,0,0,,‫הוא גרר את כולנו למלכודת!
Dialogue: 0,0:04:38.69,0:04:41.11,Main,,0,0,0,,‫לא ידעתי...
Dialogue: 0,0:04:42.00,0:04:47.38,Main,,0,0,0,,‫אבל אייס הבן של גולד רוג'ר!
Dialogue: 0,0:04:47.95,0:04:53.48,Main,,0,0,0,,‫הייתי לבד כשמצאת אותי...
Dialogue: 0,0:04:58.52,0:05:00.91,Main,,0,0,0,,‫סקווארד שוב משתולל!
Dialogue: 0,0:05:04.86,0:05:07.74,Main,,0,0,0,,‫מה, כולם פה חלשים?!
Dialogue: 0,0:05:07.74,0:05:09.95,Main,,0,0,0,,‫קדימה, בואו עלי!
Dialogue: 0,0:05:10.44,0:05:12.96,Main,,0,0,0,,‫תביאו לי את גולד רוג'ר!
Dialogue: 0,0:05:14.04,0:05:16.75,Main,,0,0,0,,‫מה, נגמר לכם האומץ?!
Dialogue: 0,0:05:17.85,0:05:19.67,Main,,0,0,0,,‫מה יש לכם, חבר'ה?!
Dialogue: 0,0:05:24.71,0:05:27.81,Main,,0,0,0,,‫ברור לך למה הייתי לבד...
Dialogue: 0,0:05:33.85,0:05:37.54,Main,,0,0,0,,‫כי החברים שנלחמתי איתם שנים...
Dialogue: 0,0:05:37.54,0:05:40.51,Main,,0,0,0,,‫רוג'ר הרג לי את כולם!
Dialogue: 0,0:05:41.17,0:05:46.63,Main,,0,0,0,,‫ברור לך כמה אני שונא את רוג'ר!
Dialogue: 0,0:05:46.63,0:05:51.73,Main,,0,0,0,,‫ולא אמרת לי שאייס הבן של רוג'ר...
Dialogue: 0,0:05:51.73,0:05:56.14,Main,,0,0,0,,‫ואתה רוצה אותו למלך הפיראטים!
Dialogue: 0,0:05:56.14,0:05:58.60,Main,,0,0,0,,‫עזבו את פיראטי זקן לבן!
Dialogue: 0,0:05:58.60,0:06:01.04,Main,,0,0,0,,‫תמשיכו לזוז! חזרה לכיכר!
Dialogue: 0,0:06:01.04,0:06:03.78,Main,,0,0,0,,‫הזקן רוצה את אייס למלך הפיראטים?
Dialogue: 0,0:06:04.25,0:06:08.02,Flashbacks,,0,0,0,,‫זקן לבן הפיראט הכי חזק שאני מכיר.
Dialogue: 0,0:06:08.02,0:06:11.98,Flashbacks,,0,0,0,,‫אני רוצה אותו למלך הפיראטים.
Dialogue: 0,0:06:17.73,0:06:22.19,Main,,0,0,0,,‫כבר אז בגדת בי!
Dialogue: 0,0:06:22.60,0:06:28.17,Main,,0,0,0,,‫הפכת אותי לחבר של אייס,\N‫וצחקת עלי מאחורי הגב!
Dialogue: 0,0:06:28.17,0:06:33.10,Main,,0,0,0,,‫ואז תפסו לך את אייס היקר!
Dialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,{\fs30\pos(891.667,515)\fad(0,150)}‫ספינות בעלות הברית
Dialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,{\fs30\pos(636.666,603.333)\fad(0,150)}‫נשק אנושי
Dialogue: 0,0:06:33.10,0:06:37.16,Captions,,0,0,0,,{\fs30\pos(368.333,513.333)\fad(0,150)}‫ספינות בעלות הברית
Dialogue: 0,0:06:33.10,0:06:36.19,Main,,0,0,0,,‫פיראטי זקן לבן בתוך המפרץ,
Dialogue: 0,0:06:36.19,0:06:39.60,Main,,0,0,0,,‫ואנחנו בעלי הברית בחוץ, על החוף...
Dialogue: 0,0:06:39.60,0:06:44.68,Main,,0,0,0,,‫מכרת את חיי 43 קפטנים מהברית...
Dialogue: 0,0:06:44.68,0:06:47.22,Main,,0,0,0,,‫בתמורה לחיים של אייס!
Dialogue: 0,0:06:47.74,0:06:52.62,Main,,0,0,0,,‫הצוותים של הברית יוצאו להורג,\N‫ואייס ופיראטי זקן לבן יינצלו!
Dialogue: 0,0:06:52.62,0:06:56.23,Main,,0,0,0,,‫אתה וסנגוקו כבר סגרתם על זה?!
Dialogue: 0,0:06:58.78,0:07:01.95,Main,,0,0,0,,‫שקט! את הקשקוש הזה אני לא קונה!
Dialogue: 0,0:07:09.09,0:07:11.43,Main,,0,0,0,,‫אתה עדיין לא קולט?
Dialogue: 0,0:07:11.43,0:07:14.18,Main,,0,0,0,,‫עוד מעט תתחרט על כל מילה.
Dialogue: 0,0:07:14.18,0:07:16.55,Main,,0,0,0,,‫אם אני משקר, תפקח עיניים!
Dialogue: 0,0:07:19.38,0:07:25.56,Main,,0,0,0,,‫רק צוותי הברית ייפגעו\N‫במתקפה שמתחילה עכשיו!
Dialogue: 0,0:07:26.35,0:07:31.13,Main,,0,0,0,,‫הצי הסכים לא לגעת בפיראטי זקן לבן!
Dialogue: 0,0:07:32.07,0:07:38.45,Main,,0,0,0,,‫ומסתבר שבאנו בשביל אייס,\N‫ובשביל זקן לבן...
Dialogue: 0,0:07:38.45,0:07:41.04,Main,,0,0,0,,‫באנו למות, ולא ידענו שעבדו עלינו!
Dialogue: 0,0:07:41.04,0:07:42.14,Main,,0,0,0,,‫תראה בעצמך!
Dialogue: 0,0:07:44.81,0:07:49.05,Main,,0,0,0,,‫הוא צדק! הצי תוקף רק אותנו!
Dialogue: 0,0:07:51.12,0:07:58.29,Captions,,0,0,0,,{\fs30\pos(628.333,403.333)}‫זקן לבן
Dialogue: 0,0:07:51.47,0:07:53.79,Main,,0,0,0,,‫המפלצות האלו באות מאחור,
Dialogue: 0,0:07:53.79,0:07:58.31,Main,,0,0,0,,‫חומות קרח חוסמות מימין ומשמאל,\N‫אין לאן לברוח!
Dialogue: 0,0:08:00.17,0:08:03.90,Main,,0,0,0,,‫אבא! זה נכון?!
Dialogue: 0,0:08:03.90,0:08:06.63,Main,,0,0,0,,‫אבא, בבקשה, תגיד שזה שקר!
Dialogue: 0,0:08:13.91,0:08:16.71,Main,,0,0,0,,‫נס שבכלל פגעתי בך.
Dialogue: 0,0:08:17.92,0:08:20.16,Main,,0,0,0,,‫אני מוכן.
Dialogue: 0,0:08:20.16,0:08:21.15,Main,,0,0,0,,‫תהרוג אותי!
Dialogue: 0,0:08:27.55,0:08:31.32,Main,,0,0,0,,‫הם באמת תוקפים רק אותנו!
Dialogue: 0,0:08:34.70,0:08:36.19,Main,,0,0,0,,‫תברחו!
Dialogue: 0,0:08:39.96,0:08:43.80,Main,,0,0,0,,‫אבא! באמת מכרת אותנו...
Dialogue: 0,0:08:43.80,0:08:46.44,Main,,0,0,0,,‫בתמורה לחיים של אייס?!
Dialogue: 0,0:08:46.92,0:08:49.65,Main,,0,0,0,,‫תגיד משהו! אבא!
Dialogue: 0,0:08:50.06,0:08:53.70,Main,,0,0,0,,‫אבא! אבא!
Dialogue: 0,0:09:09.63,0:09:12.11,Main,,0,0,0,,‫אין מצב! בטח יש טעות!
Dialogue: 0,0:09:12.11,0:09:14.21,Main,,0,0,0,,‫זקן לבן עושה עסקה עם הצי?
Dialogue: 0,0:09:14.21,0:09:15.66,Main,,0,0,0,,‫בוגד באנשיו?
Dialogue: 0,0:09:15.66,0:09:18.00,Main,,0,0,0,,‫לא ייתכן!\N‫זה זקן לבן!
Dialogue: 0,0:09:18.00,0:09:20.49,Main,,0,0,0,,‫זקן לבן והצי סגרו עסקה?!
Dialogue: 0,0:09:20.49,0:09:23.66,Main,,0,0,0,,‫הפיראטים שבטחו בזקן לבן\N‫ונלחמו איתו...
Dialogue: 0,0:09:23.66,0:09:27.51,Main,,0,0,0,,‫נבגדו, והצי יחסל אותם?
Dialogue: 0,0:09:27.51,0:09:31.02,Main,,0,0,0,,‫לא רציתי להאמין...\N‫לא האמנתי למה שראיתי!
Dialogue: 0,0:09:31.02,0:09:33.45,Main,,0,0,0,,‫איך בגדת בנו, אבא?!
Dialogue: 0,0:09:33.45,0:09:35.14,Main,,0,0,0,,‫אידיוט!
Dialogue: 0,0:09:35.77,0:09:37.64,Main,,0,0,0,,‫הוא אסף אותך, סקווארד!
Dialogue: 0,0:09:37.64,0:09:39.70,Main,,0,0,0,,‫למה אתה לא סומך על אבא?!
Dialogue: 0,0:09:39.70,0:09:43.15,Main,,0,0,0,,‫מי אתה שתגיד לי את זה, מארקו?!
Dialogue: 0,0:09:43.15,0:09:45.77,Main,,0,0,0,,‫אתה מפקד היחידה הראשונה!
Dialogue: 0,0:09:45.77,0:09:51.49,Main,,0,0,0,,‫אל תגיד לי שלא ידעת על אייס,\N‫ולא על העסקה עם הצי!
Dialogue: 0,0:09:51.94,0:09:56.83,Main,,0,0,0,,‫נכון. אייס הבן של רוג'ר...
Dialogue: 0,0:09:56.83,0:10:01.65,Main,,0,0,0,,‫לקחו את מי שהכי יישבר מזה,\N‫ושמו אותו נגדנו.
Dialogue: 0,0:10:02.43,0:10:08.21,Main,,0,0,0,,‫הם הקדימו אותי בצעד אחד.
Dialogue: 0,0:10:08.55,0:10:10.70,Main,,0,0,0,,‫מספיק.
Dialogue: 0,0:10:10.70,0:10:11.39,Main,,0,0,0,,‫אאוקיג'י!
Dialogue: 0,0:10:14.64,0:10:16.36,Main,,0,0,0,,‫למה הוא בא לפה?!
Dialogue: 0,0:10:16.85,0:10:18.78,Main,,0,0,0,,‫אז הכל היה סגור מראש?!
Dialogue: 0,0:10:18.78,0:10:20.87,Main,,0,0,0,,‫אז בשביל מה נלחמו עד עכשיו?!
Dialogue: 0,0:10:20.87,0:10:23.16,Main,,0,0,0,,‫אז אף אחד מהם לא ינצח?!
Dialogue: 0,0:10:25.19,0:10:26.02,Main,,0,0,0,,‫השידור מת!
Dialogue: 0,0:10:26.02,0:10:27.06,Main,,0,0,0,,‫מה קורה פה?!
Dialogue: 0,0:10:27.06,0:10:28.21,Main,,0,0,0,,‫זה נשבר?
Dialogue: 0,0:10:34.38,0:10:36.68,Main,,0,0,0,,‫תפעילו את החומות!
Dialogue: 0,0:10:46.18,0:10:52.56,Main,,0,0,0,,‫הממזר... אחד משלו דקר אותו בקלות.
Dialogue: 0,0:10:53.06,0:10:56.17,Main,,0,0,0,,‫אתה חרפה, זקן לבן!
Dialogue: 0,0:10:56.17,0:11:01.01,Main,,0,0,0,,‫לא ידעתי שהפסדתי לחלש כזה!
Dialogue: 0,0:11:05.49,0:11:06.88,Main,,0,0,0,,‫קרוקו...
Dialogue: 0,0:11:07.42,0:11:08.68,Main,,0,0,0,,‫קרוקודייל...
Dialogue: 0,0:11:13.96,0:11:20.05,Thoughts,,0,0,0,,‫כן... תמיד חמקת ממכות כאלו.
Dialogue: 0,0:11:20.05,0:11:25.36,Thoughts,,0,0,0,,‫גם פצוע, גם מותש,\N‫גם כשזה בא משלך,
Dialogue: 0,0:11:25.36,0:11:29.37,Thoughts,,0,0,0,,‫אף פעם לא חטפת מכה כזו.\N‫וזה מציק לי.
Dialogue: 0,0:11:31.34,0:11:36.06,Flashbacks,,0,0,0,,‫שהאויב ירחם עלי, או משהו?!\N‫לא אלבש את זה!
Dialogue: 0,0:11:36.06,0:11:36.94,Flashbacks,,0,0,0,,‫אבא!
Dialogue: 0,0:11:36.94,0:11:39.61,Thoughts,,0,0,0,,‫הגוף שלך הולך ונגמר.
Dialogue: 0,0:11:53.39,0:11:57.20,Main,,0,0,0,,‫אתה יודע מה עשית...
Dialogue: 0,0:11:57.20,0:11:58.91,Main,,0,0,0,,‫סקווארד?
Dialogue: 0,0:12:00.20,0:12:04.70,Main,,0,0,0,,‫הרמת חרב על אבא שלך...
Dialogue: 0,0:12:04.70,0:12:07.84,Main,,0,0,0,,‫בן טיפש!
Dialogue: 0,0:12:20.59,0:12:25.09,Main,,0,0,0,,‫אתה טיפש, הבן שלי. ועדיין אוהב אותך.
Dialogue: 0,0:12:28.06,0:12:32.63,Main,,0,0,0,,‫אל... תעבוד עלי...
Dialogue: 0,0:12:32.63,0:12:36.15,Main,,0,0,0,,‫אתה... מכרת את...
Dialogue: 0,0:12:36.15,0:12:44.45,Main,,0,0,0,,‫מי השחיר לב נאמן כמו שלך?
Dialogue: 0,0:12:45.42,0:12:49.17,Main,,0,0,0,,‫מורד מהצי.
Dialogue: 0,0:12:50.90,0:12:54.79,Main,,0,0,0,,‫אני נגד התוכנית הזו.
Dialogue: 0,0:12:54.79,0:12:57.83,Main,,0,0,0,,‫תפיל את זקן לבן.
Dialogue: 0,0:12:57.83,0:13:01.13,Main,,0,0,0,,‫כל מטרה אחרת, טעות קטלנית.
Dialogue: 0,0:13:01.13,0:13:06.03,Main,,0,0,0,,‫שתף פעולה, ואציל את בעלי הברית.
Dialogue: 0,0:13:07.54,0:13:09.97,Main,,0,0,0,,‫תהרוג את זקן לבן.
Dialogue: 0,0:13:14.99,0:13:19.28,Main,,0,0,0,,‫הוא אמר שיציל את בעלי הברית\N‫אם אהרוג אותך...
Dialogue: 0,0:13:19.98,0:13:23.05,Main,,0,0,0,,‫אז זה מה שאקאינו אמר...
Dialogue: 0,0:13:23.05,0:13:30.17,Main,,0,0,0,,‫אני יודע היטב כמה אתה שונא את רוג'ר.
Dialogue: 0,0:13:30.69,0:13:32.98,Main,,0,0,0,,‫אבל סקווארד...
Dialogue: 0,0:13:32.98,0:13:37.08,Main,,0,0,0,,‫בן לא משלם על מה שאבא שלו עשה.
Dialogue: 0,0:13:37.08,0:13:39.73,Main,,0,0,0,,‫מה אייס בכלל עשה לך?
Dialogue: 0,0:13:40.30,0:13:46.34,Main,,0,0,0,,‫אתה ואייס עברתם הכל יחד.
Dialogue: 0,0:13:46.34,0:13:52.15,Main,,0,0,0,,‫וכל פעם קמתם, עם החברים.
Dialogue: 0,0:13:52.15,0:13:55.58,Main,,0,0,0,,‫לא משנה מי ההורים של אייס.
Dialogue: 0,0:13:55.58,0:13:59.27,Main,,0,0,0,,‫זכינו להיפגש בים כל כך רחב.
Dialogue: 0,0:13:59.27,0:14:05.37,Main,,0,0,0,,‫לא רק שניכם. כולכם הבנים שלי.
Dialogue: 0,0:14:05.37,0:14:09.62,Main,,0,0,0,,‫אז סקווארד, תסתדר איתם.
Dialogue: 0,0:14:09.62,0:14:13.54,Main,,0,0,0,,‫אל תחשוב שאייס מעל כולם.
Dialogue: 0,0:14:13.54,0:14:17.37,Main,,0,0,0,,‫כולכם המשפחה שלי.
Dialogue: 0,0:14:27.08,0:14:30.02,Main,,0,0,0,,‫עדיין...
Dialogue: 0,0:14:32.43,0:14:34.67,Main,,0,0,0,,‫אתה באמת...
Dialogue: 0,0:14:37.33,0:14:40.42,Main,,0,0,0,,‫לא השתנית, סנגוקו.
Dialogue: 0,0:14:40.42,0:14:45.26,Main,,0,0,0,,‫יפה עבדת עליו.
Dialogue: 0,0:14:46.04,0:14:50.40,Main,,0,0,0,,‫אני?! למכור את חיי הבנים שלי?!
Dialogue: 0,0:15:03.88,0:15:07.69,Main,,0,0,0,,‫הוא פתח להם דרך החוצה...
Dialogue: 0,0:15:07.69,0:15:09.19,Main,,0,0,0,,‫לא הייתי צריך לזלזל בו.
Dialogue: 0,0:15:14.98,0:15:17.32,Main,,0,0,0,,‫חומת הקרח נעלמה...
Dialogue: 0,0:15:17.32,0:15:19.27,Main,,0,0,0,,‫אפשר לקחת את ספינות המלחמה!
Dialogue: 0,0:15:19.27,0:15:21.70,Main,,0,0,0,,‫עכשיו בורחים מתי שבא לנו!
Dialogue: 0,0:15:24.40,0:15:30.34,Main,,0,0,0,,‫אם אתם פיראטים,\N‫תחליטו בעצמכם למי להאמין!
Dialogue: 0,0:15:39.82,0:15:43.55,Main,,0,0,0,,‫בסוף זה שקר! הצי תכנן הכל!
Dialogue: 0,0:15:43.55,0:15:45.39,Main,,0,0,0,,‫לעזאזל! עבדו על כולנו!
Dialogue: 0,0:15:45.39,0:15:48.90,Main,,0,0,0,,‫אין מצב שאבא יבגוד בנו!
Dialogue: 0,0:15:48.90,0:15:52.43,Main,,0,0,0,,‫סליחה! לא אפקפק בך עוד, אבא!
Dialogue: 0,0:15:52.43,0:15:55.02,Main,,0,0,0,,‫גם אני! תסלח לי, אבא!
Dialogue: 0,0:15:55.02,0:15:57.17,Main,,0,0,0,,‫אבא! אלך אחריך עד הסוף!
Dialogue: 0,0:15:57.17,0:15:58.15,Main,,0,0,0,,‫אבא!
Dialogue: 0,0:15:58.54,0:16:03.60,Thoughts,,0,0,0,,‫חלש? עזוב, ילד תנין!
Dialogue: 0,0:16:03.60,0:16:09.31,Thoughts,,0,0,0,,‫אני רק אדם אחד. לב אחד.
Dialogue: 0,0:16:09.31,0:16:12.48,Thoughts,,0,0,0,,‫שיקראו לי שד או מפלצת, לא משנה,
Dialogue: 0,0:16:12.48,0:16:16.19,Thoughts,,0,0,0,,‫אבל לא אשאר הכי חזק לנצח.
Dialogue: 0,0:16:16.19,0:16:19.02,Thoughts,,0,0,0,,‫אם רק בן אחד יגיע רחוק בזכותי,
Dialogue: 0,0:16:19.02,0:16:22.83,Thoughts,,0,0,0,,‫זה יספיק לי.
Dialogue: 0,0:16:23.24,0:16:27.06,Main,,0,0,0,,‫מי שמוכן לבוא איתי, אחרי!\N‫גם אם זה עולה לכם בחיים!
Dialogue: 0,0:16:27.06,0:16:35.31,Main,,0,0,0,,‫כן!
Dialogue: 0,0:16:38.11,0:16:43.63,Main,,0,0,0,,‫הסתערו! הוא יוצא!\N‫האיש הכי חזק בעולם!
Dialogue: 0,0:16:46.63,0:16:48.90,Main,,0,0,0,,‫קדימה!
Dialogue: 0,0:16:48.90,0:16:50.96,Main,,0,0,0,,‫כן!
Dialogue: 0,0:16:50.96,0:16:52.86,Main,,0,0,0,,‫אל תתנו להם להתקדם!
Dialogue: 0,0:16:52.86,0:16:54.03,Main,,0,0,0,,‫אש!
Dialogue: 0,0:16:55.78,0:16:57.46,Main,,0,0,0,,‫תעשו מה שאבא אומר!
Dialogue: 0,0:16:57.46,0:16:59.30,Main,,0,0,0,,‫תפתחו דרך לאבא!
Dialogue: 0,0:17:21.39,0:17:22.26,Main,,0,0,0,,‫זקן לבן...
Dialogue: 0,0:17:35.23,0:17:37.40,Main,,0,0,0,,‫סקווארד...
Dialogue: 0,0:17:37.40,0:17:41.06,Main,,0,0,0,,‫הצי עבד עליו שיתקוף את אבא!
Dialogue: 0,0:17:41.06,0:17:43.51,Main,,0,0,0,,‫איך אתה כזה טיפש?!
Dialogue: 0,0:17:43.77,0:17:47.68,Main,,0,0,0,,‫וכמה הוא נשבר עכשיו?!
Dialogue: 0,0:17:48.73,0:17:51.00,Main,,0,0,0,,‫אבל אז...
Dialogue: 0,0:17:52.81,0:17:54.66,Main,,0,0,0,,‫מה...
Dialogue: 0,0:17:55.76,0:17:57.60,Main,,0,0,0,,‫מה...
Dialogue: 0,0:18:01.07,0:18:03.49,Main,,0,0,0,,‫עשיתי?!
Dialogue: 0,0:18:12.44,0:18:14.93,Main,,0,0,0,,‫סליחה, אבא!
Dialogue: 0,0:18:15.34,0:18:17.88,Main,,0,0,0,,‫סליחה, אייס!
Dialogue: 0,0:18:26.21,0:18:27.51,Main,,0,0,0,,‫סקווארד.
Dialogue: 0,0:18:31.79,0:18:35.35,Main,,0,0,0,,‫תבכה, או שתחזיר להם?
Dialogue: 0,0:18:41.26,0:18:44.24,Main,,0,0,0,,‫הזקן הזה מטורף... עם פצע כזה...
Dialogue: 0,0:18:45.33,0:18:48.08,Main,,0,0,0,,‫אבל אני חייב להגיע לאייס!
Dialogue: 0,0:18:48.08,0:18:49.44,Main,,0,0,0,,‫לופי!
Dialogue: 0,0:18:50.59,0:18:51.95,Main,,0,0,0,,‫ג'ינביי!
Dialogue: 0,0:18:52.55,0:18:54.81,Main,,0,0,0,,‫תראה את זה!
Dialogue: 0,0:19:15.20,0:19:19.48,Main,,0,0,0,,‫כל האויבים נסוגו לכיכר, ולא שמנו לב!
Dialogue: 0,0:19:20.39,0:19:22.47,Main,,0,0,0,,‫יש לי תחושה רעה...
Dialogue: 0,0:19:23.01,0:19:27.28,Main,,0,0,0,,‫אבל הזקן כבר זז!\N‫אין זמן לחשוב!
Dialogue: 0,0:19:27.51,0:19:31.14,Main,,0,0,0,,‫אכן! מאוחר לעצור עכשיו!
Dialogue: 0,0:19:33.16,0:19:34.60,Main,,0,0,0,,‫עוד לא מוכנים?!
Dialogue: 0,0:19:35.32,0:19:38.96,Main,,0,0,0,,‫סליחה, אדוני!\N‫הקרח הרבה יותר חזק משחשבנו.
Dialogue: 0,0:19:51.46,0:19:53.44,Main,,0,0,0,,‫הסתערו!
Dialogue: 0,0:19:53.78,0:19:55.60,Main,,0,0,0,,‫עד עכשיו החומות כבר למעלה...
Dialogue: 0,0:19:55.60,0:19:56.98,Main,,0,0,0,,‫זה לא טוב!
Dialogue: 0,0:19:56.98,0:19:59.58,Main,,0,0,0,,‫אני אקנה לנו זמן!
Dialogue: 0,0:20:02.27,0:20:03.31,Main,,0,0,0,,‫סגן אדמירל!
Dialogue: 0,0:20:09.31,0:20:13.89,Main,,0,0,0,,‫לא אתן לכם להגיע לכיכר,\N‫פיראטי זקן לבן!
Dialogue: 0,0:20:16.83,0:20:20.41,Main,,0,0,0,,‫ז-זה ג'ון הענק, סגן אדמירל!
Dialogue: 0,0:20:29.76,0:20:32.30,Main,,0,0,0,,‫אתה עומד לנו בדרך.
Dialogue: 0,0:20:56.23,0:20:57.70,Main,,0,0,0,,‫אני מאבד שיווי משקל...
Dialogue: 0,0:20:59.68,0:21:00.58,Main,,0,0,0,,‫סגן אדמירל!
Dialogue: 0,0:21:00.58,0:21:02.53,Main,,0,0,0,,‫היי! האדמה נוטה!
Dialogue: 0,0:21:08.63,0:21:10.58,Main,,0,0,0,,‫תתרחקו מאבא!
Dialogue: 0,0:21:11.43,0:21:13.18,Main,,0,0,0,,‫זו לא סתם רעידת אדמה!
Dialogue: 0,0:21:23.97,0:21:25.23,Main,,0,0,0,,‫הים...
Dialogue: 0,0:21:25.55,0:21:27.43,Main,,0,0,0,,‫לא ייאמן...
Dialogue: 0,0:21:27.43,0:21:29.46,Main,,0,0,0,,‫כל האי והים...
Dialogue: 0,0:21:29.46,0:21:31.67,Main,,0,0,0,,‫נוטים על הצד!
Dialogue: 0,0:21:53.10,0:21:56.43,Main,,0,0,0,,‫איזה זקן משוגע!
Dialogue: 0,0:22:17.08,0:22:17.94,Main,,0,0,0,,‫לופי!
Dialogue: 0,0:22:20.79,0:22:22.25,Main,,0,0,0,,‫ג'ינביי!
Dialogue: 0,0:22:22.25,0:22:24.66,Main,,0,0,0,,‫תפסתי אותך!
Dialogue: 0,0:22:32.92,0:22:34.99,Main,,0,0,0,,‫הצלת אותי... תודה!
Dialogue: 0,0:22:36.03,0:22:37.76,Main,,0,0,0,,‫אין צורך להודות.
Dialogue: 0,0:22:39.28,0:22:42.46,Main,,0,0,0,,‫הזקן לא מזהה חבר מאויב?
Dialogue: 0,0:22:42.46,0:22:45.41,Main,,0,0,0,,‫האנשים שלו ידעו ללכת לצדדים.
Dialogue: 0,0:22:57.61,0:23:00.65,Main,,0,0,0,,‫איזה כוח...
Dialogue: 0,0:23:00.65,0:23:05.43,Main,,0,0,0,,‫הצדק המוחלט של הצי על הכף...
Dialogue: 0,0:23:05.43,0:23:09.43,Main,,0,0,0,,‫לא אתן לך לעבור!
Dialogue: 0,0:23:29.92,0:23:31.65,Main,,0,0,0,,‫זה לא עוצר!
Dialogue: 0,0:23:34.38,0:23:36.58,Main,,0,0,0,,‫זה יגיע לבמת ההוצאה להורג!
Dialogue: 0,0:23:36.58,0:23:38.02,Main,,0,0,0,,‫קדימה! תקרעו אותה!
Dialogue: 0,0:23:51.05,0:23:53.67,Main,,0,0,0,,‫היי... במת ההוצאה עוד עומדת?
Dialogue: 0,0:23:54.77,0:23:56.14,Main,,0,0,0,,‫זה עבד?
Dialogue: 0,0:24:01.13,0:24:03.74,Main,,0,0,0,,‫זה לא פגע בבמת ההוצאה להורג?!
Dialogue: 0,0:24:04.14,0:24:05.95,Main,,0,0,0,,‫למה זה סטה?
Dialogue: 0,0:24:06.87,0:24:08.55,Main,,0,0,0,,‫ז-זה...
Dialogue: 0,0:24:10.95,0:24:13.09,Main,,0,0,0,,‫שלושת האדמירלים!
Dialogue: 0,0:24:16.82,0:24:19.37,Main,,0,0,0,,‫החומות פשוט לא עלו בזמן.
Dialogue: 0,0:24:19.92,0:24:22.80,Main,,0,0,0,,‫הקרח שלך חוסם את החומות!
Dialogue: 0,0:24:24.47,0:24:28.01,Main,,0,0,0,,‫פשוט תמיס את זה, סאקאזוקי?
Dialogue: 0,0:24:28.01,0:24:30.81,Main,,0,0,0,,‫קדימה, פיראטי זקן לבן!
Dialogue: 0,0:24:36.16,0:24:38.18,Main,,0,0,0,,‫הסתערו!
Dialogue: 0,0:24:42.16,0:24:45.55,Main,,0,0,0,,‫כולם דיי נלהבים...
Dialogue: 0,0:24:45.55,0:24:48.09,Main,,0,0,0,,‫מפחיד!
Dialogue: 0,0:24:48.67,0:24:50.77,Main,,0,0,0,,‫מה קרה לחומות?
Dialogue: 0,0:24:50.77,0:24:52.76,Main,,0,0,0,,‫אדוני, זה...
Dialogue: 0,0:24:52.76,0:24:55.69,Main,,0,0,0,,‫לא אכפת לי להחשיך את כל העיר.
Dialogue: 0,0:24:55.69,0:24:58.33,Main,,0,0,0,,‫כל הכוח שיש, תפעילו את החומות!
Dialogue: 0,0:24:58.33,0:24:59.67,Main,,0,0,0,,‫כן, אדוני! מיד!
Dialogue: 0,0:25:04.25,0:25:07.81,Main,,0,0,0,,‫אייס!
Dialogue: 0,0:25:14.27,0:25:15.36,Main,,0,0,0,,‫לופי!
Dialogue: 0,0:25:15.36,0:25:16.19,Main,,0,0,0,,‫אני בא עכשיו!
Dialogue: 0,0:25:18.62,0:25:21.59,Main,,0,0,0,,‫אייס!
Dialogue: 0,0:25:21.59,0:25:23.43,Main,,0,0,0,,‫הזנת כוח, מקסימום!
Dialogue: 0,0:25:34.67,0:25:36.08,Main,,0,0,0,,‫מ-מה?!
Dialogue: 0,0:25:37.54,0:25:39.28,Main,,0,0,0,,‫ח-חומות?!
Dialogue: 0,0:25:45.20,0:25:46.92,Main,,0,0,0,,‫כיתרו אותנו!
Dialogue: 0,0:25:46.92,0:25:48.65,Main,,0,0,0,,‫מה זה?!
Dialogue: 0,0:25:52.30,0:25:54.00,Main,,0,0,0,,‫לעזאזל!
Dialogue: 0,0:25:58.45,0:25:59.64,Main,,0,0,0,,‫פגעתי?
Dialogue: 0,0:26:03.87,0:26:06.09,Main,,0,0,0,,‫אין סיכוי! זה לא זז!
Dialogue: 0,0:26:06.09,0:26:08.54,Main,,0,0,0,,‫זו בטח פלדה דחוסה בטירוף!
Dialogue: 0,0:26:08.94,0:26:13.81,Main,,0,0,0,,‫אז זה מה שדיברו עליו,\N‫החומות ההגנתיות הענקיות?!
Dialogue: 0,0:26:13.81,0:26:16.55,Main,,0,0,0,,‫לעזאזל! אז אתם לא נלחמים, הצי?!
Dialogue: 0,0:26:20.43,0:26:22.28,Main,,0,0,0,,‫היי, תראו את זה!
Dialogue: 0,0:26:22.28,0:26:25.26,Main,,0,0,0,,‫כל התותחים מכוונים עלינו!
Dialogue: 0,0:26:25.26,0:26:27.09,Main,,0,0,0,,‫בואו נברח!
Dialogue: 0,0:26:27.09,0:26:30.04,Main,,0,0,0,,‫כיתרו אותנו! לאן אמורים...
Dialogue: 0,0:26:33.68,0:26:34.91,Main,,0,0,0,,‫יש פתח!
Dialogue: 0,0:26:34.91,0:26:37.00,Main,,0,0,0,,‫היי! מה קורה?!
Dialogue: 0,0:26:37.00,0:26:38.58,Main,,0,0,0,,‫תרימו את כל החומות!
Dialogue: 0,0:26:38.95,0:26:44.35,Main,,0,0,0,,‫טוב... אורס כבד מידי על החומות!
Dialogue: 0,0:26:44.73,0:26:49.75,Main,,0,0,0,,‫הדם שלו נזל למערכת והרס אותה!
Dialogue: 0,0:26:51.83,0:26:53.33,Main,,0,0,0,,‫ברצינות? שד ארור!
Dialogue: 0,0:26:54.80,0:26:57.76,Main,,0,0,0,,‫אורס... אתה...
Dialogue: 0,0:27:01.60,0:27:03.99,Main,,0,0,0,,‫איזה גבר מדהים!
Dialogue: 0,0:27:05.46,0:27:09.55,Main,,0,0,0,,‫הוא עדיין נלחם... גם עכשיו.
Dialogue: 0,0:27:14.35,0:27:16.41,Main,,0,0,0,,‫מעורר כבוד!
Dialogue: 0,0:27:17.69,0:27:19.22,Main,,0,0,0,,‫הם אולי לא מכותרים...
Dialogue: 0,0:27:19.81,0:27:21.85,Main,,0,0,0,,‫אבל תמשיך במבצע, אקאינו!
Dialogue: 0,0:27:44.13,0:27:46.02,Main,,0,0,0,,{\fad(150,150)}‫הר געש מטאורים!
Dialogue: 0,0:28:00.57,0:28:01.99,Main,,0,0,0,,‫מה קורה פה?!
Dialogue: 0,0:28:05.14,0:28:06.89,Main,,0,0,0,,‫לא ניתן לכם לברוח!
