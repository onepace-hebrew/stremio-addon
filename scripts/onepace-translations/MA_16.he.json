{"i":264,"he":"ג'ינביי וכובע הקש!"},
{"i":265,"he":"איך לעזאזל יצא שאתם עפים באוויר,\\Nמכוסים בדם?"},
{"i":266,"he":"היי, ממש חם פה..."},
{"i":267,"he":"מ-מאגמה!"},
{"i":268,"he":"תודה לך, אף אדום..."},
{"i":269,"he":"הצלת אותנו."},
{"i":270,"he":"ובכל זאת, נתתי ללופי\\Nלחטוף עוד פציעה קשה..."},
{"i":271,"he":"חייבים לטפל בפצעים שלו מיד!"},
{"i":272,"he":"שתוק כבר! לי צריך לעזור, אידיוט!"},
{"i":273,"he":"פה למעלה אי אפשר לטפל בו..."},
{"i":274,"he":"היי! למי קראת אף אדום?!"},
{"i":275,"he":"עד הרגע האחרון הם מפריעים לי!"},
{"i":276,"he":"רונדו הוורדים!"},
{"i":277,"he":"עוד חבורת מזיקים..."},
{"i":278,"he":"כולכם רוצים למות בשביל כובע הקש?"},
{"i":279,"he":"כולנו ראינו את הכוח והעקשנות שלו,\\Nשאין להם סוף."},
{"i":280,"he":"הוא האיש שאייס הגן עליו,\\Nואבא העריך אותו!"},
{"i":281,"he":"החובה שלנו היא להביא אותו לעידן החדש!"},
{"i":282,"he":"כולכם טיפשים, כל אחד ואחד!"},
{"i":283,"he":"פיראטי זקן לבן!"},
{"i":284,"he":"אקאינו."},
{"i":285,"he":"הסכנה הנוראה שאתה רואה\\Nבמי שאתה רוצה להרוג..."},
{"i":286,"he":"והפוטנציאל העצום שאנחנו רואים\\Nבמי שאנחנו רוצים להציל..."},
{"i":287,"he":"זה בדיוק אותו דבר, לא?!"},
{"i":288,"he":"אני לא מאמין שסיבכת אותי שוב!"},
{"i":289,"he":"אתה מקשיב לי?"},
{"i":290,"he":"היי, ג'-ג'ינביי?"},
{"i":291,"he":"התעלפת?!"},
{"i":292,"he":"היי, ולאן אני אמור ללכת עכשיו?!"},
{"i":293,"he":"היי!"},
{"i":294,"he":"חי או מת, הממזר הזה בגיהנום."},
{"i":295,"he":"תנו לו לסבול!"},
{"i":296,"he":"כבר ברור ששום דבר שאגיד לא יעצור אתכם."},
{"i":297,"he":"נראה אתכם!"},
{"i":298,"he":"א-אין סיכוי..."},
{"i":299,"he":"בצד אחד, סנגוקו וזקן שחור..."},
{"i":300,"he":"ובצד השני, אקאינו והמפקדים..."},
{"i":301,"he":"הקרב הזה לא ייגמר אף פעם!"},
{"i":302,"he":"קפטן באגי! תעשה משהו!"},
{"i":303,"he":"בחלומות שלכם, אידיוטים!"},
{"i":304,"he":"מה לעזאזל..."},
{"i":305,"he":"זו ספינה!"},
{"i":306,"he":"זו צוללת!"},
{"i":307,"he":"של מי הספינה הזו?"},
{"i":308,"he":"תביא לפה את כובען הקש!"},
{"i":309,"he":"\"כובען הקש\"?\\Nאיזו דרך מוזרה לקרוא למישהו..."},
{"i":310,"he":"מי אתה בכלל, ילד?!"},
{"i":311,"he":"כובען הקש ואני כנראה\\Nנהיה אויבים יום אחד..."},
{"i":312,"he":"אבל אין לי שום דבר נגדו."},
{"i":313,"he":"יהיה חבל לתת לו למות פה."},
{"i":314,"he":"קפטן פיראטי הלב"},
{"i":315,"he":"טראפלגר לאו"},
{"i":316,"he":"אני אוציא אותו מפה. תן לי אותו!"},
{"i":317,"he":"מה?!"},
{"i":318,"he":"אני רופא!"}
]
