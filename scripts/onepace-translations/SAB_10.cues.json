 {
  "i": 346,
  "style": "Main",
  "name": "Usopp",
  "text": "Move your leg!"
 },
 {
  "i": 347,
  "style": "Main",
  "name": "Brook",
  "text": "Please move!"
 },
 {
  "i": 348,
  "style": "Main",
  "name": "Kizaru",
  "text": "That's no use."
 },
 {
  "i": 349,
  "style": "Main",
  "name": "Kizaru",
  "text": "I ate the Light Fruit, I'm a light man."
 },
 {
  "i": 350,
  "style": "Main",
  "name": "Kizaru",
  "text": "I'm a Logia."
 },
 {
  "i": 351,
  "style": "Main",
  "name": "Franky",
  "text": "Light man?!"
 },
 {
  "i": 352,
  "style": "Main",
  "name": "Nami",
  "text": "You're kidding, right?! He's gonna die!"
 },
 {
  "i": 353,
  "style": "Main",
  "name": "Chopper",
