  "text": "{\\fad(150,150)}Twenty Flower"
 },
 {
  "i": 359,
  "style": "Main",
  "name": "Usopp",
  "text": "Alright! Great, Robin!"
 },
 {
  "i": 360,
  "style": "Main",
  "name": "Kizaru",
  "text": "I won't let you get away."
 },
 {
  "i": 361,
  "style": "Main",
  "name": "Kizaru",
  "text": "It's useless."
 },
 {
  "i": 362,
  "style": "Main",
  "name": "Kizaru",
  "text": "You'll die now."
 },
 {
  "i": 363,
  "style": "Main",
  "name": "Kizaru",
  "text": "So, now you decide to appear..."
 },
 {
  "i": 364,
  "style": "Main",
  "name": "Kizaru",
  "text": "\"Dark King\", Rayleigh?"
 },
 {
  "i": 365,
  "style": "Main",
  "name": "Rayleigh",
  "text": "I won't let you take out these youngsters."
 },
 {
  "i": 366,
  "style": "Main",
  "name": "Rayleigh",
  "text": "Their era is only beginning!"
 },
 {
