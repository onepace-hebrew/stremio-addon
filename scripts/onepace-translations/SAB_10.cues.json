 },
 {
  "i": 356,
  "style": "Main",
  "name": "Sanji",
  "text": "It's no use! That guy is at his limit already!"
 },
 {
  "i": 357,
  "style": "Main",
  "name": "Robin",
  "text": "{\\fad(150,150)}Veinte Fleur!"
 },
 {
  "i": 358,
  "style": "Note",
