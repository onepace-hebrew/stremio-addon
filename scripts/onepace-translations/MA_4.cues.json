[
 {
  "i": 0,
  "style": "Title",
  "name": "",
  "text": "{\\fad(700,400)}Justice Will Prevail!!"
 },
 {
  "i": 1,
  "style": "Main",
  "name": "",
  "text": "Hurry to the execution platform!"
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "The Giant Squad is coming!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "They're targeting Little Oars Jr.!"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "Stopping that thing..."
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "... is our duty!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "His size is unbelievable..."
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "He's more than twice as large as any ordinary Giant!"
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "Keep shooting!"
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "He's only flesh and blood... he can't be invulnerable!"
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "They brought one hell of an ally."
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "Fire! Shoot him down!"
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "Oars! Forget about it!"
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "Your size makes you too easy a target!"
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "Ace-{\\i1}kun{\\i0}!"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "I'm coming for ya!"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "This is bad!"
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "Stop him!"
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "Oars opened a path into the bay!"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "Invade the bay!"
 },
 {
  "i": 20,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(700,700)\\fs40\\pos(385,568.333)}Oars"
 },
 {
  "i": 21,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(700,700)\\fs38\\pos(490,166.667)}Plaza"
 },
 {
  "i": 22,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(700,700)\\fs30\\pos(773.333,246.667)}The Seven\\NWarlords"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "Fall back! Fortify the shoreline!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "Don't let them reach the plaza!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "I've never had to look up at someone before!"
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "You said it!"
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "This is as far as you get!"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "Vice Admiral Lacroix!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "That Oars... No point trying to hold him back..."
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "There's a difference between being a hero and throwing your life away!"
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "Old Man, please don't stop me!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "I wanna save 'im!"
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "I wanna save Ace-{\\i1}kun{\\i0} as fast as possible!"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "I hear ya."
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "Men! Wipe your asses!\\NLet's give Oars some support!"
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "Yeah!"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "How do we fight a guy this big?!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "How dare you hurt Vice Admiral Lacroix!"
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "If you get distracted by Oars, I'll take you down!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "H-Hey! Guys!"
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "The Pirate Empress, I'm guessing?"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "My body's... crumbling?!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "Hey! What do you think you're doing, attacking marines?!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "I agreed to fight against Whitebeard..."
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "but I never said I would be your ally."
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "Whether enemies or friends, all men are the same!"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "All but one man..."
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "I want to leave here with my promise fulfilled."
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "What are you saying?!"
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "Can you forgive this beauty?"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "Y-You...!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "You!"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "I'll save ya now!"
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "Oars..."
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "That's enough! Stop this!"
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "You won't make it this far!"
 },
 {
  "i": 58,
  "style": "Flashbacks",
  "name": "",
  "text": "Me?"
 },
 {
  "i": 59,
  "style": "Flashbacks",
  "name": "",
  "text": "I learned how to make it in the Wano Country."
 },
 {
  "i": 60,
  "style": "Flashbacks",
  "name": "",
  "text": "Try it on!"
 },
 {
  "i": 61,
  "style": "Flashbacks",
  "name": "",
  "text": "{\\i1}Ace-san burned the darn thing twice trying to make that hat.{\\i0}"
 },
 {
  "i": 62,
  "style": "Flashbacks",
  "name": "",
  "text": "A fire man like him shouldn't be weaving straw."
 },
 {
  "i": 63,
  "style": "Flashbacks",
  "name": "",
  "text": "Whoa! It's much cooler now!"
 },
 {
  "i": 64,
  "style": "Flashbacks",
  "name": "",
  "text": "Really? Great!"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "Aim for Oars!"
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "I guess there was no chance."
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "He's such a big target!"
 },
 {
  "i": 69,
  "style": "Flashbacks",
  "name": "",
  "text": "Captain Oars!"
 },
 {
  "i": 70,
  "style": "Flashbacks",
  "name": "",
  "text": "What are you doing outside?"
 },
 {
  "i": 71,
  "style": "Flashbacks",
  "name": "",
  "text": "Hmm... I don't even get wet by the rain..."
 },
 {
  "i": 72,
  "style": "Flashbacks",
  "name": "",
  "text": "It's really sturdy."
 },
 {
  "i": 73,
  "style": "Flashbacks",
  "name": "",
  "text": "This is great!"
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "At the very least..."
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "Even if it's just one of the Warlords..."
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "Is something wrong, demon?"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "My legs won't..."
 },
 {
  "i": 78,
  "style": "Flashbacks",
  "name": "",
  "text": "Captain!"
 },
 {
  "i": 79,
  "style": "Flashbacks",
  "name": "",
  "text": "Captain! Why are you outside again?"
 },
 {
  "i": 80,
  "style": "Flashbacks",
  "name": "",
  "text": "The snow doesn't even reach me."
 },
 {
  "i": 81,
  "style": "Flashbacks",
  "name": "",
  "text": "I'm not cold at all!"
 },
 {
  "i": 82,
  "style": "Flashbacks",
  "name": "",
  "text": "This is really good!"
 },
 {
  "i": 83,
  "style": "Flashbacks",
  "name": "",
  "text": "Thanks, Ace-"
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "How fun!"
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "I-It's the monster!"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "He's breached the plaza!"
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "Just a little more..."
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "Just a little further to Ace-{\\i1}kun{\\i0}..."
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "That Doflamingo bastard!"
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "He's gone and cut off a leg!"
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "Even though I said I wanted the corpse..."
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "Go!"
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "Look! This is the right way to kill someone!"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "Captain Oars!"
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "Damn the Seven Warlords!"
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "Captain!"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "If I use his corpse, I can create the ultimate zombie warrior!"
 },
 {
  "i": 102,
  "style": "Thoughts",
  "name": "",
  "text": "Oars..."
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "You're wide open, Whitebeard!"
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "Vice Admiral Ronse!"
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "H-He beat a Giant -"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "and a Navy HQ vice admiral at that - effortlessly!"
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "Charge across Oars!"
 },
 {
  "i": 108,
  "style": "Captions",
  "name": "",
  "text": "Marineford - Inside the Bay"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "This is priceless!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "Doflamingo! How could you do that to Oars?!"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "I won't let you get away with this!"
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "What's so funny?!"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "You wanna know what's so funny?"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "This feeling of being right at the center of an era, that's what!"
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "This is the turning point!"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "Quit spouting nonsense!"
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "Just as I'd expect of the commander!"
 },
 {
  "i": 118,
  "style": "Main",
  "name": "",
  "text": "Doflamingo is running away from him!"
 },
 {
  "i": 119,
  "style": "Thoughts",
  "name": "",
  "text": "Impossible! This is just too much for me!"
 },
 {
  "i": 120,
  "style": "Thoughts",
  "name": "",
  "text": "I'm too scared to do anything!"
 },
 {
  "i": 121,
  "style": "Thoughts",
  "name": "",
  "text": "So many strong people are falling, one after another!"
 },
 {
  "i": 122,
  "style": "Thoughts",
  "name": "",
  "text": "There's nothing I can do here!"
 },
 {
  "i": 123,
  "style": "Thoughts",
  "name": "",
  "text": "Someone like me can't..."
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "Wait, Koby! If you're running away, then I'm coming with you!"
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "Return to the battlefield!"
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Let me go! Please!"
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "It's Admiral Akainu! What's he doing here?"
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "I'm afraid of dying! When I think of my family, I can't even move!"
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "Please! I'm begging you! Please!"
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "We marines..."
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "fight against pirates and carry the justice of the world on our backs."
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "Someone who runs away and lets an enemy see his back..."
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "has no right to call himself a marine!"
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "Someone like that is merely..."
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "trash!"
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "If you truly cared for your family,"
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "you wouldn't have disgraced them like this!"
 },
 {
  "i": 138,
  "style": "Thoughts",
  "name": "",
  "text": "N-No way! How could he do that to an ally?"
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "Admiral Sakazuki! We've finished preparing for the operation."
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "Have you now? Finally!"
 },
 {
  "i": 141,
  "style": "Thoughts",
  "name": "",
  "text": "Operation?"
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "Commander Atmos!"
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "Why..."
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "My body's not listening to me..."
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "Stop this, Doflamingo!"
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "Pirates are evil? The Navy is righteous?"
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "Those views change as often as the tides!"
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "Kids who've never known peace have different values from those who've never known war."
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "It's the job of those at the top to\\Ndecide what's good and what's evil."
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "This place is the turning point."
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "Justice will triumph, you say?"
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "Why of course!"
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "Because the winners will become justice!"
 },
 {
  "i": 155,
  "style": "Captions",
  "name": "",
  "text": "Marineford - Bay Head"
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "{\\an8}Don't let them close the path Oars has opened!"
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "Advance into the bay!"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "An icebreaker?"
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "It's the Ice Witch, Whitey Bay!"
 },
 {
  "i": 160,
  "style": "Main",
  "name": "",
  "text": "Nothing to it."
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "Now, all of you! Let's go!"
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "Thanks!"
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "Come on, men! Forward, into the bay!"
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "The bay's been breached in two spots!"
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "The Whitebeard Pirates and their allies are surging through both openings,"
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "and they're attacking the bay in large numbers, Fleet Admiral Sengoku!"
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "That's not a problem."
 },
 {
  "i": 168,
  "style": "Main",
  "name": "",
  "text": "What?"
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "Tsuru-{\\i1}san{\\i0}, commence the operation."
 },
 {
  "i": 170,
  "style": "Main",
  "name": "",
  "text": "{\\an8}At last."
 },
 {
  "i": 171,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(0,450)}Marineford - Bay Head"
 },
 {
  "i": 172,
  "style": "Main",
  "name": "",
  "text": "{\\an8}Move it! Or you'll be more than just wounded!"
 },
 {
  "i": 173,
  "style": "Main",
  "name": "",
  "text": "Move it, old woman!"
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "I've been washed!"
 },
 {
  "i": 175,
  "style": "Main",
  "name": "",
  "text": "I've been hung out to dry!"
 },
 {
  "i": 176,
  "style": "Main",
  "name": "",
  "text": "But it feels so nice!"
 },
 {
  "i": 177,
  "style": "Main",
  "name": "",
  "text": "You're a million years too young to stand a chance against me."
 },
 {
  "i": 178,
  "style": "Main",
  "name": "",
  "text": "Calling all ships and all men!"
 },
 {
  "i": 179,
  "style": "Main",
  "name": "",
  "text": "You're planning something, aren't you?"
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "The Resourceful General, Sengoku the Buddha."
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "Gramps!"
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "Why have you come here? Do you wish to protest against my plan?"
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "No, we're up against pirates. There's no room for sympathy."
 },
 {
  "i": 184,
  "style": "Main",
  "name": "",
  "text": "Then..."
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "Be silent!"
 },
 {
  "i": 186,
  "style": "Main",
  "name": "",
  "text": "You don't mind, right?"
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "I'm just gonna sit here."
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "You idiot! You too?!"
 },
 {
  "i": 189,
  "style": "Main",
  "name": "",
  "text": "Don't hit Luffy, you damn geezer!"
 },
 {
  "i": 190,
  "style": "Main",
  "name": "",
  "text": "\"Damn\"?!"
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "Ace, how dare you?!"
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "I have no sympathy for criminals..."
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "but for my family, I do."
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "What... should I do?"
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "Damn you Ace! Why couldn't you just live as I told you?!"
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "Ace..."
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "You two are gonna become strong marines."
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "You got that?"
 },
 {
  "i": 199,
  "style": "Flashbacks",
  "name": "",
  "text": "You're gonna become strong marines."
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "Gramps...!"
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "If you cause some sort of commotion here, I won't show you any mercy, Garp."
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "If I was gonna do something, I'd have done it already."
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "Did you hear their plan just now, Helmeppo-{\\i1}san{\\i0}?"
 },
 {
  "i": 204,
  "style": "Main",
  "name": "",
  "text": "Yeah..."
 },
 {
  "i": 205,
  "style": "Main",
  "name": "",
  "text": "They're gonna ignore Fire Fist Ace's scheduled execution time and just kill him now!"
 },
 {
  "i": 206,
  "style": "Main",
  "name": "",
  "text": "If they do that..."
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "What's that?"
 },
 {
  "i": 208,
  "style": "Main",
  "name": "",
  "text": "Is that...?"
 },
 {
  "i": 209,
  "style": "Main",
  "name": "",
  "text": "Something's falling out of the sky!"
 },
 {
  "i": 210,
  "style": "Main",
  "name": "",
  "text": "Is it a sneak attack from the Whitebeard Pirates?"
 },
 {
  "i": 211,
  "style": "Main",
  "name": "",
  "text": "I knew you'd overdo it!"
 },
 {
  "i": 212,
  "style": "Main",
  "name": "",
  "text": "This is all because of his wink."
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "Vyou're blaming this on vme, Croco?!"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "Who cares?! We're gonna die!"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "The sea beneath us is frozen solid!"
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "Oh! I'm made of rubber, so I'll be fine!"
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "Then you'll be the only survivor!"
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "We have to do something!"
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "Vi don't want to die like this!"
 },
 {
  "i": 220,
  "style": "Main",
  "name": "",
  "text": "Someone, stop vus!"
 },
 {
  "i": 221,
  "style": "Main",
  "name": "",
  "text": "I never should've listened to you, Straw Hat!"
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "Dammit!"
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 }
]