[
 {
  "i": 0,
  "style": "Title",
  "name": "",
  "text": "{\\fad(1600,1500)}The War's Conclusion"
 },
 {
  "i": 1,
  "style": "Main",
  "name": "",
  "text": "You've gotta be kidding me! What kind of doctor carries a sword around?!"
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "Do you make house calls by submarine or something?!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "What's wrong? Who is it?!"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "Trafalgar Law..."
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "A rookie from the North Blue!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "What?!"
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "If I'm remembering right, he's a pirate who teamed up with Straw Hat Luffy and got away..."
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "after the Celestial Dragon incident on the Sabaody Archipelago the other day!"
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "It looks like they've come to save him in their submarine!"
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "Don't waste any more time! Hand him over!"
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "That's why I'm asking you who the hell you are and why I should trust you!"
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "Captain Law! Warships are approaching off the stern!"
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "Hurry! Bring both of them over here!"
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "Calling all Navy soldiers!"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "Split into two forces:"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "push back the Whitebeard Pirates' attack,\\N and suppress the Blackbeard Pirates' ambush!"
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "Marines are coming up from underground!"
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "They had a path down there?!"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "We've got backup! All right! Take them out immediately!"
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "W-What?!"
 },
 {
  "i": 21,
  "style": "Main",
  "name": "",
  "text": "What is this?!"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "What an extraordinary power!"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "I said I'll never let him escape!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "You're not going anywhere!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "He's putting on a pretty fantastic show, once again."
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "But I can't control it too well yet."
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "Hey, Captain! If you get too carried away, we'll lose our footing as well!"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "What do you think, Sengoku the Buddha?! Garp the Hero?!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "Can you stop me?!"
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "Your era ended with Whitebeard's!"
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "What's Blackbeard doing now?!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "I'm scared!"
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "I've got a bad feeling about this!"
 },
 {
  "i": 34,
  "style": "Narrator",
  "name": "",
  "text": "Warning! Due to the earthquake that struck Marineford..."
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "we are issuing a tsunami warning for the south coast of Sabaody Archipelago."
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "We assure you there is no cause for panic, please remain calm."
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "Please take shelter in the elevated areas of Groves 40 to 50, on the northern side of the archipelago."
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "Get out of the way! What are you waiting for?!"
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "I'm a noble! I'll pay you, just let me go first!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "Everyone, please remain calm."
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "The Pacifista have crossed the chasm in the plaza!"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "Follow the Pacifista! Don't let the pirates escape, men!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "Hey!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "What's wrong with you?!"
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "I don't know! But I'm so sad!"
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "Sad?"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "I can hear voices in my head..."
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "disappearing, one by one..."
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "What? Voices?"
 },
 {
  "i": 50,
  "style": "Thoughts",
  "name": "",
  "text": "We'll show you Navy justice!"
 },
 {
  "i": 51,
  "style": "Thoughts",
  "name": "",
  "text": "Is this your idea of justice?!"
 },
 {
  "i": 52,
  "style": "Thoughts",
  "name": "",
  "text": "That's for my friend who died in the war!"
 },
 {
  "i": 53,
  "style": "Thoughts",
  "name": "",
  "text": "Damn pirate! Go to Hell!"
 },
 {
  "i": 54,
  "style": "Thoughts",
  "name": "",
  "text": "Now it's time to make them understand! The rulers of the sea are not the pirates, but us!"
 },
 {
  "i": 55,
  "style": "Thoughts",
  "name": "",
  "text": "I did it!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "What kind of nonsense are you spouting?!"
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "Have you gone crazy? Get a hold of yourself!"
 },
 {
  "i": 58,
  "style": "Thoughts",
  "name": "",
  "text": "H-Help me..."
 },
 {
  "i": 59,
  "style": "Thoughts",
  "name": "",
  "text": "Run!"
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "Koby!"
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "Hey! Where are you going?!"
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "As many of us must escape as possible!"
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "Hang in there! You can still be saved!"
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "We must get him treated!"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "I... I don't want to die..."
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "Abandon him! We're at war here!"
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "B-But Sir..."
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "This is the time to show the power of the Navy... of justice!"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "We have no time to tend to the wounded!"
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "Go!"
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "Y-Yes Sir!"
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "Chase down the pirates!"
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "Kill every last one of them!"
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "Someone, help him! Anyone!"
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "Destroy the pirates! Don't leave a single one alive!"
 },
 {
  "i": 76,
  "style": "Thoughts",
  "name": "",
  "text": "The killing won't stop... The marines have accomplished their goals, but are far more brutal now!"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "Our bullets don't work!"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "Chase them!"
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "Damn villains!"
 },
 {
  "i": 80,
  "style": "Thoughts",
  "name": "",
  "text": "Something is wrong... with our \"justice\" and \"evil\"..."
 },
 {
  "i": 81,
  "style": "Thoughts",
  "name": "",
  "text": "Both sides are acting in their own self-interests."
 },
 {
  "i": 82,
  "style": "Main",
  "name": "",
  "text": "Damn it!"
 },
 {
  "i": 83,
  "style": "Main",
  "name": "",
  "text": "Listen up, men! As long as you are marines..."
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "you must never forgive the evil we know as pirates!"
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "Nobody can stop me!"
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "I'll destroy everything and swallow it up!"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "Just leave Straw Hat Luffy behind."
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "That's..."
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "It's Kizaru!"
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "Hurry and get them over here!"
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "All right, I'll leave them with you, whoever you are!"
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "Do what you can!"
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "Catch them, Jean Bart!"
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "All right! Good job!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "Let's dive!"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "You did well to escape from me on Sabaody, Trafalgar Law..."
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "He's horribly injured! Is he still alive?"
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "Let's hurry!"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "Damn it!"
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "Just give it up!"
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "That's enough!"
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "A marine?"
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "Koby!"
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "Stop, already! All this fighting, just end it!"
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "What's with him?"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "S-Someone..."
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "H-Help us..."
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "We're throwing people's lives away!"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "Even though every single soldier has a family waiting for them to return!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "Even though we've already accomplished our goal!"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "We keep chasing pirates who don't want to fight, drawing out a battle that should already be over..."
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "and abandoning soldiers who could be saved if we treat their wounds now!"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "And still, we're sacrificing even more people!"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "What about the soldiers who will fall after this?!"
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "Koby?!"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "We're making them look like idiots!"
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "Huh? Who the hell are you?!"
 },
 {
  "i": 118,
  "style": "Main",
  "name": "",
  "text": "You've wasted several seconds of my time. The Navy has no use for soldiers who aren't righteous!"
 },
 {
  "i": 119,
  "style": "Thoughts",
  "name": "",
  "text": "It's hopeless... I'm gonna die!"
 },
 {
  "i": 120,
  "style": "Thoughts",
  "name": "",
  "text": "But... I said it! I said what I wanted to say!"
 },
 {
  "i": 121,
  "style": "Thoughts",
  "name": "",
  "text": "I have no regrets!"
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "You did well, young marine."
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "You risked your life to create a brief moment of courage..."
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "for better or worse, that has greatly changed the fate of the world."
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "Hurry! Hurry and bring him inside!"
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Yes, Captain!"
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "That's not gonna work."
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "Don't do anything, Kizaru."
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "Oh, my... Benn Beckman..."
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "That's... that ship is..."
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "Cast off!"
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "What is..."
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "one of the Four Emperors of the New World doing here?!"
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "It's Red Hair Shanks!"
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "I've come..."
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "to end this war!"
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "Red Hair..."
 },
 {
  "i": 138,
  "style": "Main",
  "name": "",
  "text": "The one who put Luffy on the path to become a pirate!"
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "It's the Red Hair Pirates!"
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "No way!"
 },
 {
  "i": 141,
  "style": "Main",
  "name": "",
  "text": "The skirmish between Emperors Kaido and Red Hair was just a few days ago in the New World!"
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "He made it all the way here already?!"
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "Sh-Shanks?!"
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "W-What are you doing here?!"
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "Buggy!"
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "Y-Your straw hat?"
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "Give it to Luffy."
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "Why do I have to do that?!"
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "I had a treasure map I wanted to give you, too..."
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "Really?!"
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "Yeah. It leads to a great treasure trove!"
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "Oh, come on!"
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "That's way too good to be true! You think you can fool me with a story like that?"
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "All right. I'll just give it to someone else, then."
 },
 {
  "i": 155,
  "style": "Main",
  "name": "",
  "text": "Wha-?! Oh, crap, wait! I'll do it!"
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "I'll give it to him right away!"
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "Chief!"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "You haven't seen Luffy for ten years!"
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "Don't you want to take a look at him?"
 },
 {
  "i": 160,
  "style": "Main",
  "name": "",
  "text": "Yeah..."
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "Captain! This is dangerous!"
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "I know it's rare to see one of the Four Emperors, but hurry and close the doors!"
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "Sure."
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "You forgot this! Here, catch!"
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "Something's flying towards us."
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "This is..."
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "Captain! Hurry! Hurry up!"
 },
 {
  "i": 168,
  "style": "Main",
  "name": "",
  "text": "Sure!"
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "I would like to see him, but..."
 },
 {
  "i": 170,
  "style": "Flashbacks",
  "name": "",
  "text": "I'm entrusting you with this hat."
 },
 {
  "i": 171,
  "style": "Flashbacks",
  "name": "",
  "text": "Make sure you give it back one day..."
 },
 {
  "i": 172,
  "style": "Flashbacks",
  "name": "",
  "text": "once you've become a great pirate."
 },
 {
  "i": 173,
  "style": "Flashbacks",
  "name": "",
  "text": "That's a promise, Luffy."
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "If we met now..."
 },
 {
  "i": 175,
  "style": "Main",
  "name": "",
  "text": "it would break our promise, wouldn't it..."
 },
 {
  "i": 176,
  "style": "Main",
  "name": "",
  "text": "Luffy?"
 },
 {
  "i": 177,
  "style": "Main",
  "name": "",
  "text": "This should be a fun operation."
 },
 {
  "i": 178,
  "style": "Main",
  "name": "",
  "text": "Red Hair, you scum!"
 },
 {
  "i": 179,
  "style": "Main",
  "name": "",
  "text": "You let Dragon's son escape!"
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Ice Age!"
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "He's after the submarine!"
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "The water is freezing over!"
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "His pulse is starting to stabilize."
 },
 {
  "i": 184,
  "style": "Main",
  "name": "",
  "text": "What now?"
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "This is an emergency! The ice is closing in on us!"
 },
 {
  "i": 186,
  "style": "Main",
  "name": "",
  "text": "We'll dive quickly!"
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "Looks like we got away..."
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "W-We're safe..."
 },
 {
  "i": 189,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Yasakani Sacred Jewel!"
 },
 {
  "i": 190,
  "style": "Main",
  "name": "",
  "text": "W-What is it now?!"
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "We've got to go deeper! To the ocean floor!"
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "We'll get hit! We're {\\i1}definitely{\\i} gonna get hit!"
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "Hurry! Full speed ahead!"
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "Damn it... They just won't give up!"
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "He didn't hit them, did he?"
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "Ace's brother! Jinbe!"
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "If they're still alive now..."
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "then they're really lucky."
 },
 {
  "i": 199,
  "style": "Main",
  "name": "",
  "text": "We'll just have to give up on them for now..."
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "Why is that warship sailing out alone?"
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "You must hurry!"
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "Follow the submarine!"
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "Follow it? But it's at the bottom of the ocean!"
 },
 {
  "i": 204,
  "style": "Main",
  "name": "",
  "text": "I doubt it even survived the Admirals' attacks just now..."
 },
 {
  "i": 205,
  "style": "Main",
  "name": "",
  "text": "No. They are, without a doubt, alive."
 },
 {
  "i": 206,
  "style": "Main",
  "name": "",
  "text": "Listen well!"
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "As one of the Seven Warlords of the Sea,"
 },
 {
  "i": 208,
  "style": "Main",
  "name": "",
  "text": "I shall definitely chase down Straw Hat Luffy and finish him off!"
 },
 {
  "i": 209,
  "style": "Main",
  "name": "",
  "text": "Report this to the Navy!"
 },
 {
  "i": 210,
  "style": "Main",
  "name": "",
  "text": "Y-Yes Ma'am!"
 },
 {
  "i": 211,
  "style": "Main",
  "name": "",
  "text": "B-But where should we go?"
 },
 {
  "i": 212,
  "style": "Main",
  "name": "",
  "text": "Just advance!"
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "She's crazy, yet so beautiful!"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "What did you say?!"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "You were lying about the treasure map?!"
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "D-D-Damn you!"
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "It was a spur of the moment thing, Buggy."
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "It's been a long time, huh?"
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "W-What do you mean"
 },
 {
  "i": 220,
  "style": "Main",
  "name": "",
  "text": "\"It's been a long time, huh?\""
 },
 {
  "i": 221,
  "style": "Main",
  "name": "",
  "text": "Don't forget that I still hold a grudge against you, Shanks!"
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "About what?"
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "Don't tell me you've forgotten!"
 },
 {
  "i": 224,
  "style": "Main",
  "name": "",
  "text": "If you hadn't shouted at me back then,"
 },
 {
  "i": 225,
  "style": "Main",
  "name": "",
  "text": "I wouldn't have lost that treasure map, nor would I have Devil Fruit powers!"
 },
 {
  "i": 226,
  "style": "Main",
  "name": "",
  "text": "Oh, that's what you meant?"
 },
 {
  "i": 227,
  "style": "Main",
  "name": "",
  "text": "Thanks for the great reaction."
 },
 {
  "i": 228,
  "style": "Main",
  "name": "",
  "text": "I've always hated this side of you!"
 },
 {
  "i": 229,
  "style": "Main",
  "name": "",
  "text": "As soon as we were reunited you took advantage of me!"
 },
 {
  "i": 230,
  "style": "Main",
  "name": "",
  "text": "I don't care if you've come to end this war, or whatever..."
 },
 {
  "i": 231,
  "style": "Main",
  "name": "",
  "text": "I'm ready to start a one-on-one war with you right now!"
 },
 {
  "i": 232,
  "style": "Main",
  "name": "",
  "text": "Did you see that?"
 },
 {
  "i": 233,
  "style": "Main",
  "name": "",
  "text": "I saw it!"
 },
 {
  "i": 234,
  "style": "Main",
  "name": "",
  "text": "He's talking to Red Hair Shanks, one of the Four Emperors..."
 },
 {
  "i": 235,
  "style": "Main",
  "name": "",
  "text": "with that attitude!"
 },
 {
  "i": 236,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy!"
 },
 {
  "i": 237,
  "style": "Main",
  "name": "",
  "text": "We will follow you..."
 },
 {
  "i": 238,
  "style": "Main",
  "name": "",
  "text": "forever!"
 },
 {
  "i": 239,
  "style": "Main",
  "name": "",
  "text": "All right, I got it. Don't get upset."
 },
 {
  "i": 240,
  "style": "Main",
  "name": "",
  "text": "What was that?!"
 },
 {
  "i": 241,
  "style": "Thoughts",
  "name": "",
  "text": "But wait a second..."
 },
 {
  "i": 242,
  "style": "Thoughts",
  "name": "",
  "text": "as long as I'm with these guys, I can get off this island safely!"
 },
 {
  "i": 243,
  "style": "Main",
  "name": "",
  "text": "Red Hair..."
 },
 {
  "i": 244,
  "style": "Main",
  "name": "",
  "text": "Marco."
 },
 {
  "i": 245,
  "style": "Main",
  "name": "",
  "text": "Don't continue this fight any longer."
 },
 {
  "i": 246,
  "style": "Main",
  "name": "",
  "text": "Just pull back quietly."
 },
 {
  "i": 247,
  "style": "Main",
  "name": "",
  "text": "Hawk-Eye!"
 },
 {
  "i": 248,
  "style": "Main",
  "name": "",
  "text": "Where are you going?!"
 },
 {
  "i": 249,
  "style": "Main",
  "name": "",
  "text": "I agreed to fight Whitebeard..."
 },
 {
  "i": 250,
  "style": "Main",
  "name": "",
  "text": "Fighting Red Hair was not part of the agreement."
 },
 {
  "i": 251,
  "style": "Main",
  "name": "",
  "text": "I'm leaving."
 },
 {
  "i": 252,
  "style": "Main",
  "name": "",
  "text": "If you keep on fighting..."
 },
 {
  "i": 253,
  "style": "Main",
  "name": "",
  "text": "both sides will suffer more pointless casualties."
 },
 {
  "i": 254,
  "style": "Main",
  "name": "",
  "text": "If anybody still wants to fight..."
 },
 {
  "i": 255,
  "style": "Main",
  "name": "",
  "text": "then come! We will be your opponents!"
 },
 {
  "i": 256,
  "style": "Main",
  "name": "",
  "text": "What do you say, Teach?"
 },
 {
  "i": 257,
  "style": "Main",
  "name": "",
  "text": "No, Blackbeard!"
 },
 {
  "i": 258,
  "style": "Main",
  "name": "",
  "text": "Let's stop for now."
 },
 {
  "i": 259,
  "style": "Main",
  "name": "",
  "text": "I got what I wanted."
 },
 {
  "i": 260,
  "style": "Main",
  "name": "",
  "text": "It's still too soon for us to fight you guys."
 },
 {
  "i": 261,
  "style": "Main",
  "name": "",
  "text": "Let's go, men!"
 },
 {
  "i": 262,
  "style": "Main",
  "name": "",
  "text": "Everyone..."
 },
 {
  "i": 263,
  "style": "Main",
  "name": "",
  "text": "for now..."
 },
 {
  "i": 264,
  "style": "Main",
  "name": "",
  "text": "please listen to what I have to say."
 },
 {
  "i": 265,
  "style": "Main",
  "name": "",
  "text": "Here's the final news report..."
 },
 {
  "i": 266,
  "style": "Main",
  "name": "",
  "text": "Whitebeard. Ace."
 },
 {
  "i": 267,
  "style": "Main",
  "name": "",
  "text": "Please leave their burial to us."
 },
 {
  "i": 268,
  "style": "Main",
  "name": "",
  "text": "This war was broadcast all over the world."
 },
 {
  "i": 269,
  "style": "Main",
  "name": "",
  "text": "Don't exploit their deaths more than you already have!"
 },
 {
  "i": 270,
  "style": "Main",
  "name": "",
  "text": "What selfish crap are you spouting?!"
 },
 {
  "i": 271,
  "style": "Main",
  "name": "",
  "text": "Holding their heads up to the world will be the symbol of our victory!"
 },
 {
  "i": 272,
  "style": "Main",
  "name": "",
  "text": "The Vice Admiral is right!"
 },
 {
  "i": 273,
  "style": "Main",
  "name": "",
  "text": "Are you trying to disgrace our victory?!"
 },
 {
  "i": 274,
  "style": "Main",
  "name": "",
  "text": "We won't obey the orders of a pirate!"
 },
 {
  "i": 275,
  "style": "Main",
  "name": "",
  "text": "Very well."
 },
 {
  "i": 276,
  "style": "Main",
  "name": "",
  "text": "Fleet Admiral!"
 },
 {
  "i": 277,
  "style": "Main",
  "name": "",
  "text": "I'm fine with entrusting them to you, Red Hair."
 },
 {
  "i": 278,
  "style": "Main",
  "name": "",
  "text": "But, Sir!"
 },
 {
  "i": 279,
  "style": "Main",
  "name": "",
  "text": "I will take the blame."
 },
 {
  "i": 280,
  "style": "Main",
  "name": "",
  "text": "Sorry about this."
 },
 {
  "i": 281,
  "style": "Main",
  "name": "",
  "text": "Tend to the wounds of the fallen!"
 },
 {
  "i": 282,
  "style": "Main",
  "name": "",
  "text": "This war..."
 },
 {
  "i": 283,
  "style": "Main",
  "name": "",
  "text": "is over!"
 },
 {
  "i": 284,
  "style": "Main",
  "name": "",
  "text": "Everyone who can move, help the medical staff!"
 },
 {
  "i": 285,
  "style": "Main",
  "name": "",
  "text": "Start with the ones who are heavily injured!"
 },
 {
  "i": 286,
  "style": "Main",
  "name": "",
  "text": "We can't suffer any more casualties on this battlefield!"
 },
 {
  "i": 287,
  "style": "Narrator",
  "name": "",
  "text": "And so..."
 },
 {
  "i": 288,
  "style": "Narrator",
  "name": "",
  "text": "the greatest battle since the curtain first rose on the Great Age of Pirates..."
 },
 {
  "i": 289,
  "style": "Narrator",
  "name": "",
  "text": "the great war of Marineford, came to an end."
 },
 {
  "i": 290,
  "style": "Narrator",
  "name": "",
  "text": "Engraving its place in history."
 }
]