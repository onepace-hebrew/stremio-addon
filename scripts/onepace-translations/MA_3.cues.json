[
 {
  "i": 0,
  "style": "Title",
  "name": "",
  "text": "{\\fad(1450,1900)}Conflict at the Summit"
 },
 {
  "i": 1,
  "style": "Main",
  "name": "",
  "text": "It's a tsunami!"
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "What power! He truly is a legendary monster!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "Aokiji..."
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "Young fool!"
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "H-He stopped it!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "Oh, my..."
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "He froze the entire bay!"
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "It's impossible for the ships to move!"
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "Fire!"
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "Destroy the Moby Dick!"
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "Now, let's go!"
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "We've got some solid ground to stand on!"
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "Show them what we can do!"
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "The division commanders have joined the fight! Don't stop attacking!"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "How nice of them to freeze the ocean!"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "I was so fired up that it was getting too hot for me!"
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "Guess it won't be that easy..."
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "The vice admirals of Navy HQ are here, too!"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "I've never seen so many of the vice admirals together in one place!"
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "It's just like a Buster Call!"
 },
 {
  "i": 21,
  "style": "Main",
  "name": "",
  "text": "But when they're up against the Old Man, or us, they're nothing special!"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "Tsuru-san, stand back!"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "Don't be ridiculous, youngsters!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "Even if I retreated to the ends of the sea, there's no such thing as a safe place anymore."
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "Ground the ship on the frozen bay!"
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "Take 'em all down!"
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "Our destination is the bay! Advance!"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "For the Old Man, I'd gladly sacrifice my own life!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "Bring it on, Navy HQ!"
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "Let's go, Squard Pirates!"
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "Yeah!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "It has finally begun."
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "What's this? You're gonna fight now?"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "I merely wish to measure..."
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "to see for myself..."
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "the true distance between us and that man."
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "That's dangerous!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "Run away!"
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "Old Man!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "He stopped it... The most powerful slash in the world!"
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "The commander of the Third Division..."
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "Diamond Jozu!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "K-Kizaru is here!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "Hey, now. That's really bright, you know."
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "He deflected an admiral's attack?"
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "What?"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "He's covered in blue flames!"
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "Blue flames?"
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "You can't just..."
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "go straight for..."
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "the King, you know!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "You Whitebeard Pirates sure are scary!"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "What's with his body?"
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "He took Kizaru-san's attack head-on, yet he's still alive!"
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "His ability is as powerful as the rumors said!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "A power even more rare than the Logia Fruits..."
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "The Mythical Zoan Type."
 },
 {
  "i": 58,
  "style": "Main",
  "name": "",
  "text": "Look! His wounds are disappearing!"
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "I don't believe this! How could that attack not work!?"
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "It still hurts."
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "Liar."
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "That's the First Division Commander!"
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "No matter what hits him, he recovers by flame..."
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "Marco the Phoenix!"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "I've never seen a bird like this before..."
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "Hmm... this really hurts."
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "Liar!"
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "Kizaru-san!"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "Giant unit! Watch out for attacks coming from the sky, too!"
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "Sure!"
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "The Giants are coming!"
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "Aim for their legs! Bring them down!"
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "You guys, stand back!"
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "Jozu!"
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "What power!"
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "What's he doing?"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "Try stopping {\\i1}this{\\i0}!"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "It's a block of ice!"
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "It's way too big!"
 },
 {
  "i": 80,
  "style": "Main",
  "name": "",
  "text": "I swear, those two are just..."
 },
 {
  "i": 81,
  "style": "Main",
  "name": "",
  "text": "They simply went and left their stations!"
 },
 {
  "i": 82,
  "style": "Main",
  "name": "",
  "text": "If we're not here..."
 },
 {
  "i": 83,
  "style": "Main",
  "name": "",
  "text": "who will protect this area?!"
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "That enormous ice-block..."
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "He completely vaporized it!"
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "This is bad!"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "Volcanic rocks!"
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "We can't let them hit us!"
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "Damn bastard!"
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "One of our ships has been hit!"
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "Get away from the ships!"
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "It's like watching the end of the world!"
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "These flames are too flashy."
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "Why don't you go light some candles on a birthday cake instead, magma-brat?"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "You don't like flashy funerals, Whitebeard?"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "Fire! Don't stop!"
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "Don't hesitate!"
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "Advance towards the plaza!"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "Stop the commanders!"
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "Don't let them reach the shore!"
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "Sink the Moby Dick! Kill Whitebeard!"
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "Here he comes!"
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "Fire!"
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "Break through the blockade of warships!"
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "Advance towards the plaza!"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "Ace-kun!"
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "Alright, go!"
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "Little Oars Jr.!"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "He's the descendant of the Continent-Puller, Oars!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "He's enormous! Far larger than an ordinary Giant!"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "Don't let him into the bay! He's trying to breach our defenses!"
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "So, Oars's descendant is one of Whitebeard's men?"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "I want him! I want his corpse!"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "I'm starting to get excited!"
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "Ace-kun is a nice guy!"
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "I ain't lettin' ya kill him!"
 }
]