[
 {
  "i": 0,
  "style": "Title",
  "name": "",
  "text": "A Gift to a New Era{\\fad(1000,1100)}"
 },
 {
  "i": 1,
  "style": "Narrator",
  "name": "",
  "text": "The news has quickly spread around the world.{\\an8}"
 },
 {
  "i": 2,
  "style": "Narrator",
  "name": "",
  "text": "The Whitebeard Pirates have failed to rescue Roger’s son, Ace.{\\an8}"
 },
 {
  "i": 3,
  "style": "Narrator",
  "name": "",
  "text": "And their legendary captain, Whitebeard, has died.{\\an8}"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "We’re printing a special edition! Get to work!"
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "This is an important announcement!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "Following Fire Fist Ace, we can also confirm the death of Whitebeard!"
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "I repeat:"
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "At Marineford, Whitebeard has..."
 },
 {
  "i": 9,
  "style": "Secondary",
  "name": "",
  "text": "Whitebeard has..."
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "Died!"
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "The Whitebeard Pirates are done for, as well!"
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "Now the war is over!"
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "We can finally live in peace!"
 },
 {
  "i": 14,
  "style": "Narrator",
  "name": "",
  "text": "Those who have witnessed this unforgettable historic moment...{\\an8}"
 },
 {
  "i": 15,
  "style": "Narrator",
  "name": "",
  "text": "have been left speechless.{\\an8}"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "So you've passed on, Whitebeard."
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "The man who once rivaled...{\\an8}"
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "the Pirate King on the high seas...{\\an8}"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "the captain of the Whitebeard Pirates...{\\an8}"
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "and the legendary pirate...{\\an8}"
 },
 {
  "i": 21,
  "style": "Main",
  "name": "",
  "text": "Edward  \"Whitebeard\" Newgate....{\\an8}"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "has died at the age of 72 in the fierce battle in Marineford Bay...{\\an8}"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "which broke out between his pirate armada and an alliance of the Navy and the Seven Royal Warlords of the Sea...{\\an8}"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "That damn bastard..."
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "Marco. We all feel the same way..."
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "but we have to retreat!"
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "I know, Vista."
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "Don't just stand there! Get on the ship!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "Did you forget our captain's final order?!"
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "Jinbe! Hurry and take Ace's brother to safety!"
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "Of course!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "He sure was one stubborn bastard..."
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "So he finally bit the dust?"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "So far, everything has gone exactly according to plan."
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "Well then, Captain..."
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "Now, it's time to begin!"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "They're up to something again!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "That Teach..."
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "What's he planning to do with Pops?!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "I'm about to present..."
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "an amazing show that will astonish the entire world!"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "What's with that black shroud?!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "Blackbeard and Whitebeard are both underneath it!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "Now, I must ask that no one enters for the time being."
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "What are you trying to pull?!"
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "He turned on us after pretending to have joined the Seven Royal Warlords of the Sea!"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "Don't let your guard down!"
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "I'm looking forward to this."
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "If this fails, I suppose we'll have to disband."
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy, where are you going?!"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "Are you stupid or what?! I'm running away, of course!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "There's no way I can take Whitebeard's head now, is there?"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy..."
 },
 {
  "i": 54,
  "style": "Thoughts",
  "name": "",
  "text": "I failed!"
 },
 {
  "i": 55,
  "style": "Thoughts",
  "name": "",
  "text": "I was too scared, and couldn't even approach him!"
 },
 {
  "i": 56,
  "style": "Thoughts",
  "name": "",
  "text": "I was afraid!"
 },
 {
  "i": 57,
  "style": "Thoughts",
  "name": "",
  "text": "Whitebeard... he was scary in his prime, and he's still scary after dying!"
 },
 {
  "i": 58,
  "style": "Main",
  "name": "",
  "text": "Just go ahead and think I'm pathetic if you want to!"
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "This is where we part ways, you imbeciles!"
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy!"
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "He's crying... Captain Buggy!"
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "I get it... yesterday's enemies are friends today!"
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "At some point, you felt sympathy for your rival Whitebeard as a fellow man!"
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "Even though you were going to take his head!"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "And yet you're leaving without trying to make any excuses!"
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "You truly are..."
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "a man among men, just as we always thought you were!"
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "You are too cool, Captain Buggy!"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "Please wait, Captain Buggy!"
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "Take us with you!"
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "Captain!"
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "Hurry out to sea!"
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "Luffy-{\\i1}kun{\\i0}..."
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "Hang in there... You must survive..."
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "in this world that Ace-{\\i1}{\\i1}san{\\i0}{\\i0} has already left behind..."
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "on to tomorrow... and the day after..."
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "Fire!"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "You must survive!"
 },
 {
  "i": 79,
  "style": "Flashbacks",
  "name": "",
  "text": "Jinbe... If I end up dying like this..."
 },
 {
  "i": 80,
  "style": "Flashbacks",
  "name": "",
  "text": "I hate to ask, but please take care of my brother..."
 },
 {
  "i": 81,
  "style": "Flashbacks",
  "name": "",
  "text": "I might have to refuse that request, Ace-{\\i1}san{\\i0}..."
 },
 {
  "i": 82,
  "style": "Flashbacks",
  "name": "",
  "text": "You mustn't overestimate me."
 },
 {
  "i": 83,
  "style": "Flashbacks",
  "name": "",
  "text": "I'm not that kind-hearted."
 },
 {
  "i": 84,
  "style": "Flashbacks",
  "name": "",
  "text": "He might be your brother, but in the world of pirates..."
 },
 {
  "i": 85,
  "style": "Flashbacks",
  "name": "",
  "text": "I will not lend a hand to anyone I don't think highly of, nor will I protect them."
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "Jinbe! Come onboard!"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "Sure!"
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "This is..."
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "Damn it... The ocean has been frozen!"
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "We can't set sail!"
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "Quickly, do something about it!"
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "It's Admiral Aokiji!"
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "Hold Aokiji back!"
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "We have no choice... we must take another ship!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "I said I wouldn't let him escape."
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "Just resign yourself to death, you imbecile!"
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "Hand over Dragon’s son!"
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "Akainu... isn't dead?!"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "I thought Pops finished him off!"
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "He traveled underground..."
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "by melting a path with his magma!"
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "Jinbe!"
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "That isn't happening!"
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "I have already decided to protect this man, even at the cost of my life!"
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "Then, I will not ask again."
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "Protect Ace's brother!"
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "Ace's family is our family!"
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "Get out of my way, you cowards!"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "Move aside, Jinbe!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "Emporio Face-Growth Hormone{\\fad(150,150)}"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "Iva-{\\i1}san{\\i0}. Allow me to help as well."
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "Great Scissors!{\\fad(150,150)}"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "Vi will not let vyou lay one hand on Straw Hat-boy!"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "I {\\i1}will{\\i0} execute Dragon's son!"
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "Hell... Wink!{\\fad(150,150)}"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "Ever since Impel Down..."
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "the damage that Straw Hat-boy has taken, both physically and mentally,"
 },
 {
  "i": 118,
  "style": "Main",
  "name": "",
  "text": "has long since gone past its limits!"
 },
 {
  "i": 119,
  "style": "Main",
  "name": "",
  "text": "If anything else were to happen to Straw Hat-boy now, while Vi'm here..."
 },
 {
  "i": 120,
  "style": "Main",
  "name": "",
  "text": "Vi will never be able to show vmy face to vmy comrade, Dragon, again!"
 },
 {
  "i": 121,
  "style": "Main",
  "name": "",
  "text": "I feel the same way."
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "Bring it on!"
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "Right now, Vi am burning far, {\\i1}far{\\i} hotter than vyou are!"
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "Well then, ladies and gentlemen..."
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "Thank you for waiting."
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Captain Teach of the Blackbeard Pirates is proud to present..."
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "the world's greatest show."
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "Please watch closely!"
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "B-Blackbeard!"
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "What was he doing in there?!"
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "Whitebeard hasn't changed at all!"
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "And Blackbeard is unchanged too!"
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "Navy!"
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "Allow me to show you my power!"
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "Now, we are enemies once more."
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "Black Hole!{\\fad(150,150)}"
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "What's this?!"
 },
 {
  "i": 138,
  "style": "Main",
  "name": "",
  "text": "This is the power of my Dark-Dark Fruit!"
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "And..."
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "this is..."
 },
 {
  "i": 141,
  "style": "Main",
  "name": "",
  "text": "That stance!"
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "That's..."
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "the power of the Quake-Quake Fruit!"
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "H-How did he use Whitebeard’s power?! He’s dead!"
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "You did it, Captain!"
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "That’s Pops’ earthquake power!"
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "What's going on?! Damn that Teach!"
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "The pull of darkness reverts all to nothing..."
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "while the force of earthquakes destroys everything."
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "I've obtained it at last! Now, nobody is a match for me!"
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "I am the strongest!"
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "I don't know what he did..."
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "but he's stolen Whitebeard's power!"
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "How can that be possible?!"
 },
 {
  "i": 155,
  "style": "Main",
  "name": "",
  "text": "Then, the terror of the Quake-Quake Fruit..."
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "still hasn't ended?!"
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "I thought it was impossible to have the powers of two Devil Fruits!"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "It's definitely impossible for ordinary humans..."
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "but... as you all know, Teach isn't quite normal."
 },
 {
  "i": 160,
  "style": "Main",
  "name": "",
  "text": "His body is fundamentally different from an ordinary person's!"
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "Is that what led to this?!"
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "Hey, did you all see that?!"
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "Let the whole world know this!"
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "Peace-loving, boring commoners!"
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "Marines! World Government! And pirates!"
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "Is this some nightmare?"
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "The future of this world has been decided!"
 },
 {
  "i": 168,
  "style": "Main",
  "name": "",
  "text": "Yes, from now on..."
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "this is my era!"
 },
 {
  "i": 170,
  "style": "Main",
  "name": "",
  "text": "Navy HQ is crumbling to pieces!"
 },
 {
  "i": 171,
  "style": "Main",
  "name": "",
  "text": "Get out of here!"
 },
 {
  "i": 172,
  "style": "Main",
  "name": "",
  "text": "It's hopeless!"
 },
 {
  "i": 173,
  "style": "Main",
  "name": "",
  "text": "Is this... real?"
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "Someone... please tell me this isn't true!"
 },
 {
  "i": 175,
  "style": "Main",
  "name": "",
  "text": "The fortress of justice, the Navy's base,"
 },
 {
  "i": 176,
  "style": "Main",
  "name": "",
  "text": "which has protected the oceans of the world for centuries..."
 },
 {
  "i": 177,
  "style": "Main",
  "name": "",
  "text": "How could it end up like this?!"
 },
 {
  "i": 178,
  "style": "Main",
  "name": "",
  "text": "After capturing Fire Fist Ace to trigger this war..."
 },
 {
  "i": 179,
  "style": "Main",
  "name": "",
  "text": "Blackbeard has stolen Whitebeard’s powers!"
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "Behold, all you people of the world!"
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "Look at me, and my power!"
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "What will happen to the world?!"
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "I can feel the power..."
 },
 {
  "i": 184,
  "style": "Main",
  "name": "",
  "text": "surging through me!"
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "Damn it..."
 },
 {
  "i": 186,
  "style": "Main",
  "name": "",
  "text": "Such incredible power!"
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "It appears that the world’s my oyster!"
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "Damn him!"
 },
 {
  "i": 189,
  "style": "Main",
  "name": "",
  "text": "Hey! What's wrong?"
 },
 {
  "i": 190,
  "style": "Main",
  "name": "",
  "text": "What? Isn't anyone coming?"
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "I'm willing to fight as many of you as you like, too..."
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "What a shame!"
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "Guess there's no helping it."
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "Then, first of all..."
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "I guess I'll send Marineford to the bottom of the ocean!"
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "What?!"
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "A shockwave?!"
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "We can just rebuild the fortress!"
 },
 {
  "i": 199,
  "style": "Main",
  "name": "",
  "text": "However..."
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "this is the island at the very center of the world: Marineford!"
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "Fleet Admiral..."
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "Our presence here is significant to the citizens of the world..."
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "who fear the villains infesting our waters!"
 },
 {
  "i": 204,
  "style": "Main",
  "name": "",
  "text": "Justice in the name of humanity shall not fall."
 },
 {
  "i": 205,
  "style": "Main",
  "name": "",
  "text": "You will not so lightly speak of sinking this place."
 },
 {
  "i": 206,
  "style": "Main",
  "name": "",
  "text": "You callow child!"
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "Such admirable conviction!"
 },
 {
  "i": 208,
  "style": "Main",
  "name": "",
  "text": "Hey, Fleet Admiral-{\\i1}san{\\i0}?"
 },
 {
  "i": 209,
  "style": "Main",
  "name": "",
  "text": "Well then... listen!"
 },
 {
  "i": 210,
  "style": "Main",
  "name": "",
  "text": "Just try to protect it!"
 },
 {
  "i": 211,
  "style": "Main",
  "name": "",
  "text": "Damn it!"
 },
 {
  "i": 212,
  "style": "Main",
  "name": "",
  "text": "Now's vyour chance! Hurry!"
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "Get Straw Hat-boy to safety!"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "Forgive me!"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "Inazuma!"
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "Iva-{\\i1}sama!{\\i0}"
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "Pirate scum!"
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "Akainu!"
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "Jinbe! Give up Dragon’s son!"
 },
 {
  "i": 220,
  "style": "Main",
  "name": "",
  "text": "The sea is my turf!"
 },
 {
  "i": 221,
  "style": "Main",
  "name": "",
  "text": "We can still escape!"
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "Oh, no! It's frozen?!"
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "Aokiji!"
 },
 {
  "i": 224,
  "style": "Main",
  "name": "",
  "text": "So you've come..."
 },
 {
  "i": 225,
  "style": "Main",
  "name": "",
  "text": "Looks like you've lost your escape route!"
 },
 {
  "i": 226,
  "style": "Main",
  "name": "",
  "text": "It didn't work..."
 },
 {
  "i": 227,
  "style": "Main",
  "name": "",
  "text": "Straw Hat Luffy!"
 },
 {
  "i": 228,
  "style": "Main",
  "name": "",
  "text": "You're mine!"
 },
 {
  "i": 229,
  "style": "Main",
  "name": "",
  "text": "Jinbe!"
 },
 {
  "i": 230,
  "style": "Main",
  "name": "",
  "text": "He pierced straight through Jinbe and hit Ace's brother!"
 },
 {
  "i": 231,
  "style": "Main",
  "name": "",
  "text": "Is he still alive?!"
 },
 {
  "i": 232,
  "style": "Main",
  "name": "",
  "text": "You’re in my way, Jinbe!"
 },
 {
  "i": 233,
  "style": "Main",
  "name": "",
  "text": "Luffy-{\\i1}{\\i1}kun{\\i0}{\\i0}... forgive me..."
 },
 {
  "i": 234,
  "style": "Main",
  "name": "",
  "text": "I let you get injured again..."
 },
 {
  "i": 235,
  "style": "Main",
  "name": "",
  "text": "This is no time to worry about others, you scum!"
 },
 {
  "i": 236,
  "style": "Main",
  "name": "",
  "text": "My aim was a little off because you interfered..."
 },
 {
  "i": 237,
  "style": "Main",
  "name": "",
  "text": "It would've been easier for him if I pierced his heart."
 },
 {
  "i": 238,
  "style": "Main",
  "name": "",
  "text": "Don't you think so, Jinbe?"
 },
 {
  "i": 239,
  "style": "Main",
  "name": "",
  "text": "Are you still trying to protect him, with that hole in your chest?"
 },
 {
  "i": 240,
  "style": "Main",
  "name": "",
  "text": "You'll both die soon enough."
 },
 {
  "i": 241,
  "style": "Main",
  "name": "",
  "text": "Crocodile!"
 },
 {
  "i": 242,
  "style": "Main",
  "name": "",
  "text": "Sables!{\\fad(150,150)}"
 },
 {
  "i": 243,
  "style": "Main",
  "name": "",
  "text": "Someone catch him, and get him on a ship already!"
 },
 {
  "i": 244,
  "style": "Main",
  "name": "",
  "text": "Right..."
 },
 {
  "i": 245,
  "style": "Main",
  "name": "",
  "text": "Crocodile!"
 },
 {
  "i": 246,
  "style": "Main",
  "name": "",
  "text": "If you want to protect something, then you should do it right!"
 },
 {
  "i": 247,
  "style": "Main",
  "name": "",
  "text": "Don't let these guys keep doing whatever they want!"
 },
 {
  "i": 248,
  "style": "Main",
  "name": "",
  "text": "Catch him!"
 },
 {
  "i": 249,
  "style": "Main",
  "name": "",
  "text": "It's all over..."
 },
 {
  "i": 250,
  "style": "Main",
  "name": "",
  "text": "I'm so sorry for getting carried away, everyone."
 },
 {
  "i": 251,
  "style": "Main",
  "name": "",
  "text": "The legend of Captain Buggy is over."
 },
 {
  "i": 252,
  "style": "Main",
  "name": "",
  "text": "Thank you for supporting me."
 },
 {
  "i": 253,
  "style": "Main",
  "name": "",
  "text": "Jinbe!"
 },
 {
  "i": 254,
  "style": "Main",
  "name": "",
  "text": "He's not falling back down..."
 },
 {
  "i": 255,
  "style": "Main",
  "name": "",
  "text": "What the hell is this?!"
 },
 {
  "i": 256,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy!"
 },
 {
  "i": 257,
  "style": "Main",
  "name": "",
  "text": "You saved Straw Hat and Jinbe!"
 },
 {
  "i": 258,
  "style": "Main",
  "name": "",
  "text": "I knew it..."
 },
 {
  "i": 259,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy... you just made it look like you were running away,"
 },
 {
  "i": 260,
  "style": "Main",
  "name": "",
  "text": "so that you could save your fellow escapee, Straw Hat, in his time of need!"
 },
 {
  "i": 261,
  "style": "Main",
  "name": "",
  "text": "How noble!"
 },
 {
  "i": 262,
  "style": "Main",
  "name": "",
  "text": "Your nobility is blinding me!"
 },
 {
  "i": 263,
  "style": "Main",
  "name": "",
  "text": "They're acting weird again..."
 },
 {
  "i": 264,
  "style": "Main",
  "name": "",
  "text": "Jinbe and Straw Hat!"
 },
 {
  "i": 265,
  "style": "Main",
  "name": "",
  "text": "How the hell did you end up flying through the air, covered in blood?"
 },
 {
  "i": 266,
  "style": "Main",
  "name": "",
  "text": "Hey, it sure is hot here..."
 },
 {
  "i": 267,
  "style": "Main",
  "name": "",
  "text": "M-Magma!"
 },
 {
  "i": 268,
  "style": "Main",
  "name": "",
  "text": "Thank you, Red Nose..."
 },
 {
  "i": 269,
  "style": "Main",
  "name": "",
  "text": "You saved us."
 },
 {
  "i": 270,
  "style": "Main",
  "name": "",
  "text": "Still, I let Luffy-{\\i1}kun{\\i0} get another grave injury..."
 },
 {
  "i": 271,
  "style": "Main",
  "name": "",
  "text": "We must treat his wounds immediately!"
 },
 {
  "i": 272,
  "style": "Main",
  "name": "",
  "text": "Oh, shut up! I'm the one who needs help, you dumbass!"
 },
 {
  "i": 273,
  "style": "Main",
  "name": "",
  "text": "It's not like we can treat him up here..."
 },
 {
  "i": 274,
  "style": "Main",
  "name": "",
  "text": "Hey! Who're you calling Red Nose?!"
 },
 {
  "i": 275,
  "style": "Main",
  "name": "",
  "text": "They get in my way even to the very end!"
 },
 {
  "i": 276,
  "style": "Main",
  "name": "",
  "text": "Rose Rondo!{\\fad(150,150)}"
 },
 {
  "i": 277,
  "style": "Main",
  "name": "",
  "text": "Another pack of vermin..."
 },
 {
  "i": 278,
  "style": "Main",
  "name": "",
  "text": "Do you all wish to die for Straw Hat's sake?"
 },
 {
  "i": 279,
  "style": "Main",
  "name": "",
  "text": "We've all seen his bottomless tenacity and power."
 },
 {
  "i": 280,
  "style": "Main",
  "name": "",
  "text": "He's the man Ace protected, and Pops respected him!"
 },
 {
  "i": 281,
  "style": "Main",
  "name": "",
  "text": "It is our duty to send him on to the new era!"
 },
 {
  "i": 282,
  "style": "Main",
  "name": "",
  "text": "Every last one of you are fools!"
 },
 {
  "i": 283,
  "style": "Main",
  "name": "",
  "text": "Whitebeard Pirates!"
 },
 {
  "i": 284,
  "style": "Main",
  "name": "",
  "text": "Akainu."
 },
 {
  "i": 285,
  "style": "Main",
  "name": "",
  "text": "The terrible danger you see in the one you want to kill..."
 },
 {
  "i": 286,
  "style": "Main",
  "name": "",
  "text": "the immense potential we see in the one we want to save..."
 },
 {
  "i": 287,
  "style": "Main",
  "name": "",
  "text": "Ain't they one and the same?!"
 },
 {
  "i": 288,
  "style": "Main",
  "name": "",
  "text": "I can't believe you got me involved again!"
 },
 {
  "i": 289,
  "style": "Main",
  "name": "",
  "text": "Are you listening to me?"
 },
 {
  "i": 290,
  "style": "Main",
  "name": "",
  "text": "Hey, J-Jinbe?"
 },
 {
  "i": 291,
  "style": "Main",
  "name": "",
  "text": "You're unconscious?!"
 },
 {
  "i": 292,
  "style": "Main",
  "name": "",
  "text": "Hey, where should I go now?!"
 },
 {
  "i": 293,
  "style": "Main",
  "name": "",
  "text": "Hey!"
 },
 {
  "i": 294,
  "style": "Main",
  "name": "",
  "text": "Alive or dead, that bastard’s in hell."
 },
 {
  "i": 295,
  "style": "Main",
  "name": "",
  "text": "Just leave him to suffer!"
 },
 {
  "i": 296,
  "style": "Main",
  "name": "",
  "text": "I guess nothing I say will stop you at this point."
 },
 {
  "i": 297,
  "style": "Main",
  "name": "",
  "text": "Do your worst!"
 },
 {
  "i": 298,
  "style": "Main",
  "name": "",
  "text": "I-It's hopeless..."
 },
 {
  "i": 299,
  "style": "Main",
  "name": "",
  "text": "Sengoku and Blackbeard are over there..."
 },
 {
  "i": 300,
  "style": "Main",
  "name": "",
  "text": "And Akainu and the commanders are over there..."
 },
 {
  "i": 301,
  "style": "Main",
  "name": "",
  "text": "The battle will never end!"
 },
 {
  "i": 302,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy! Do something!"
 },
 {
  "i": 303,
  "style": "Main",
  "name": "",
  "text": "Like hell, you idiots!"
 },
 {
  "i": 304,
  "style": "Main",
  "name": "",
  "text": "What the..."
 },
 {
  "i": 305,
  "style": "Main",
  "name": "",
  "text": "It's a ship!"
 },
 {
  "i": 306,
  "style": "Main",
  "name": "",
  "text": "That's a submarine!"
 },
 {
  "i": 307,
  "style": "Main",
  "name": "",
  "text": "Whose ship is that?"
 },
 {
  "i": 308,
  "style": "Main",
  "name": "",
  "text": "Bring Straw Hatter over here!"
 },
 {
  "i": 309,
  "style": "Main",
  "name": "",
  "text": "\"Straw Hatter\"? That sure is a weird way to address a guy..."
 },
 {
  "i": 310,
  "style": "Main",
  "name": "",
  "text": "Who are you, kid?!"
 },
 {
  "i": 311,
  "style": "Main",
  "name": "",
  "text": "Straw Hatter and I will probably be enemies someday..."
 },
 {
  "i": 312,
  "style": "Main",
  "name": "",
  "text": "but I have nothing against him."
 },
 {
  "i": 313,
  "style": "Main",
  "name": "",
  "text": "It'd be no fun to let him die here."
 },
 {
  "i": 314,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(500,0)}Captain of the Heart Pirates"
 },
 {
  "i": 315,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(500,0)}Trafalgar Law"
 },
 {
  "i": 316,
  "style": "Main",
  "name": "",
  "text": "I'll get him out of here. Hand him over!{\\an8}"
 },
 {
  "i": 317,
  "style": "Main",
  "name": "",
  "text": "What?!"
 },
 {
  "i": 318,
  "style": "Main",
  "name": "",
  "text": "I'm a doctor!"
 }
]