{"i":253,"he":"אף אחד לא ראה סימן לזקן לבן,"},
{"i":254,"he":"והמתח במרינפורד רק עולה."},
{"i":255,"he":"נשארו פחות מ-3 שעות להוצאה להורג."},
{"i":256,"he":"תעלה במדרגות."},
{"i":257,"he":"תקשיב, לופי!"},
{"i":258,"he":"חייבים לחיות בלי חרטות!"},
{"i":259,"he":"כן!"},
{"i":260,"he":"יום אחד נצא לים,"},
{"i":261,"he":"ואז נעשה מה שבא לנו!"},
{"i":262,"he":"אף אחד לא יהיה חופשי כמונו!"},
{"i":263,"he":"הכחול הדרומי"},
{"i":264,"he":"עוד 3 שעות. מעניין אם\\Nזקן לבן כבר הופיע?"},
{"i":265,"he":"מי יודע. אתה בטוח שהוא יגיע?"},
{"i":266,"he":"גם אם זה זקן לבן,\\Nהוא כבר דיי זקן, לא?"},
{"i":267,"he":"אתה חושב?"},
{"i":268,"he":"הוא שריד מלפני\\Nעידן הפיראטים הגדול."},
{"i":269,"he":"בטח כבר נהיה סנילי."},
{"i":270,"he":"הוא שקט כבר כמה שנים."},
{"i":271,"he":"הכחול המזרחי"},
{"i":272,"he":"הוא פה כבר נצח."},
{"i":273,"he":"אפשר בכלל להפיל את צמרת הצי?"},
{"i":274,"he":"לא משנה מי ינצח,\\Nיהיו המון מתים."},
{"i":275,"he":"הכי טוב שהוא לא יגיע,\\Nוההוצאה להורג תעבור בשקט."},
{"i":276,"he":"הכחול הצפוני"},
{"i":277,"he":"היי! היי! אני רוצה לשתות, זקן!"},
{"i":278,"he":"אתה חושב שאפתח את הפאב ביום כזה?!"},
{"i":279,"he":"יכולה לפרוץ מלחמה, אתה יודע!"},
{"i":280,"he":"לך הביתה! אם מחר העולם עוד עומד,\\Nאפתח את הפאב!"},
{"i":281,"he":"אז בבקשה, תמכור לי קצת לשתות!"},
{"i":282,"he":"כאילו אותנו מוציאים להורג פה!"},
{"i":283,"he":"חייבים לשתות כדי לעבור את זה!"},
{"i":284,"he":"הכחול המערבי"},
{"i":285,"he":"אל תחשוב שהוא סתם זקן.\\Nהוא חזק כמו תמיד."},
{"i":286,"he":"ראינו אותו לפני שנה. רק ישב."},
{"i":287,"he":"איבדנו תקווה שנצא מזה חיים."},
{"i":288,"he":"הקו הגדול"},
{"i":289,"he":"זקן לבן באמת כל כך מפחיד?"},
{"i":290,"he":"אפילו הילדים יודעים."},
{"i":291,"he":"הם שרים עליו כשהם קופצים בחבל."},
{"i":292,"he":"♪ זקן לבן הפיראט, מפחיד יותר מהשטן! ♪"},
{"i":293,"he":"ריבונו של עולם,"},
{"i":294,"he":"לאן העולם הזה הולך?"},
{"i":295,"he":"מפקדת הצי\\Nמרינפורד, הקו הגדול"},
{"i":296,"he":"מהר, תתכוננו!"},
{"i":297,"he":"אתה! תזוז!"},
{"i":298,"he":"אל תפחדו!"},
{"i":299,"he":"מה שיהיה, נשארו רק 3 שעות."},
{"i":300,"he":"ואז כל זה נגמר!"},
{"i":301,"he":"יותר מ-100,000 אנשי צי\\Nהתאספו מכל העולם."},
{"i":302,"he":"50 ספינות מלחמה מקיפות\\Nאת המפרץ כמו חצי סהר."},
{"i":303,"he":"ובתוך המפרץ, תותחים בלי סוף מוכנים."},
{"i":304,"he":"את השורה הראשונה של החיילים\\Nרואים מהנמל."},
{"i":305,"he":"ביניהם חמישה נבלים\\Nשיכולים להכריע את המלחמה,"},
{"i":306,"he":"חברי שבעת לוחמי הים."},
{"i":307,"he":"מתחת לבמת ההוצאה להורג שומר\\Nהכוח הכי חזק של מפקדת הצי:"},
{"i":308,"he":"שלושת האדמירלים!"},
{"i":309,"he":"אדמירל\\N\"אאוקיג'י\" קוזאן"},
{"i":310,"he":"אדמירל\\N\"אקאינו\" סאקאזוקי"},
{"i":311,"he":"אדמירל\\N\"קיזארו\" בורסלינו"},
{"i":312,"he":"עכשיו,"},
{"i":313,"he":"כל כוחות הצדק בעולם..."},
{"i":314,"he":"ממתינים לפיראטי זקן לבן..."},
{"i":315,"he":"שלא יצליחו להציל את אייס."},
{"i":316,"he":"אני רואה את זה!"},
{"i":317,"he":"היי! ג'ינביי!"},
{"i":318,"he":"אני רואה את שער הצדק!"},
{"i":319,"he":"זה היה מהיר!"},
{"i":320,"he":"לא, אנחנו דווקא דיי מאחרים!"},
{"i":321,"he":"אם הרוח הייתה בעדנו,\\Nהיינו מגיעים קודם!"},
{"i":322,"he":"אז איך עוברים את השער?"},
{"i":323,"he":"אנשים שלי! הזמן כמעט הגיע!"},
{"i":324,"he":"זמן למה?"},
{"i":325,"he":"זמן לקפטן באגי להשתלט על העולם!"},
{"i":326,"he":"נכון מאוד, חברים שלי!"},
{"i":327,"he":"למי אכפת ממפקדת הצי?!"},
{"i":328,"he":"היי, תראו! אגרוף האש אייס!"},
{"i":329,"he":"זה האיש שבגללו\\Nהעולם עומד להתהפך!"},
{"i":330,"he":"כל העולם תלוי בו!"},
{"i":331,"he":"אני אגיד להם הכל, גארפ."},
{"i":332,"he":"תעשה מה שבא לך. אני יורד."},
{"i":333,"he":"תיסוגו."},
{"i":334,"he":"כן, אדוני!"},
{"i":335,"he":"אדמירל הצי סנגוקו!"},
{"i":336,"he":"מה קורה?"},
{"i":337,"he":"תן לי את שבלול התקשורת."},
{"i":338,"he":"כן, אדוני."},
{"i":339,"he":"יש לי הודעה לכולכם."},
{"i":340,"he":"פורטגס D. אייס..."},
{"i":341,"he":"הוצאתו להורג של האיש הזה\\Nקובעת הכל."},
{"i":342,"he":"לא עשית שום דבר רע."},
{"i":343,"he":"נשים תמיד מתרככות ברגעים כאלו, צורו."},
{"i":344,"he":"אייס. איך קוראים לאבא שלך?!"},
{"i":345,"he":"אבא שלו?"},
{"i":346,"he":"על מה כל זה?"},
{"i":347,"he":"אבא שלי הוא זקן לבן."},
{"i":348,"he":"לא נכון!"},
{"i":349,"he":"הוא כן! זקן לבן האבא היחיד שלי!"},
{"i":350,"he":"לפני שנים שמנו המון אנשים\\Nעל העקבות שלו."},
{"i":351,"he":"חשדנו שהאיש הזה הוליד ילד\\Nבאי מסוים."},
{"i":352,"he":"כל מה שהיה לנו זה רמז מעורפל\\Nמסייפר פול."},
{"i":353,"he":"יילודים..."},
{"i":354,"he":"וכאלו שעוד לא נולדו..."},
{"i":355,"he":"עברנו על כל תינוק וכל אם.\\Nכלום."},
{"i":356,"he":"אבל אני מניח שזה היה צפוי."},
{"i":357,"he":"אמא שלך סיכנה את החיים\\Nכדי ללדת אותך בשלום."},
{"i":358,"he":"היא עשתה תרגיל מיוחד."},
{"i":359,"he":"היא רימתה אותנו...\\Nלא, את כל העולם!"},
{"i":360,"he":"היא גרה באי בטרילה,\\Nבכחול הדרומי."},
{"i":361,"he":"קראו לה פורטגס D. רוז'."},
{"i":362,"he":"אמא שלך, ברצון בלבד,\\Nעשתה משהו שאי אפשר להאמין."},
{"i":363,"he":"היא נשאה את הילד ברחם\\N20 חודשים שלמים."},
{"i":364,"he":"מה הוא אומר?"},
{"i":365,"he":"ברגע שילדה אותך,\\Nהכוח נגמר והיא מתה."},
{"i":366,"he":"שנה ו-3 חודשים אחרי שהאב מת,"},
{"i":367,"he":"נולד ילד עם הדם\\Nשל האיש הכי מרושע בעולם."},
{"i":368,"he":"הילד הזה היה אתה!"},
{"i":369,"he":"אני בטוח שאתה כבר יודע..."},
{"i":370,"he":"אין חטא על תינוק שנולד."},
{"i":371,"he":"גארפ."},
{"i":372,"he":"תשמור על הילד שלי."},
{"i":373,"he":"אבא שלך הוא..."},
{"i":374,"he":"מלך הפיראטים, גולד רוג'ר!"}
