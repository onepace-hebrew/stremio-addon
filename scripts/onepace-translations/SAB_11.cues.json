 {
  "i": 172,
  "style": "Main",
  "name": "Nami",
  "text": "There's no mistake..."
 },
 {
  "i": 173,
  "style": "Main",
  "name": "Nami",
  "text": "I've seen that ability before..."
 },
 {
  "i": 174,
  "style": "Main",
  "name": "Nami",
  "text": "Back at Thriller Bark, he used that..."
 },
 {
  "i": 175,
  "style": "Main",
  "name": "Nami",
  "text": "...To get rid of a girl..."
 },
 {
  "i": 176,
  "style": "Main",
  "name": "Nami",
  "text": "...Tnd she never came back!"
 },
 {
  "i": 177,
  "style": "Main",
  "name": "Franky",
  "text": "This is really bad!"
 },
 {
  "i": 178,
  "style": "Main",
  "name": "Luffy",
  "text": "Hey! What'd he do to Zoro?!"
 },
 {
  "i": 179,
  "style": "Main",
  "name": "Luffy",
  "text": "Where'd he disappear off to?!"
 },
 {
  "i": 180,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "I have no obligation to answer."
 },
 {
  "i": 181,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "I'm the most tight-lipped man in the world."
 },
 {
  "i": 182,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "I don't know if it's true or not, but they say that"
 },
 {
  "i": 183,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "anyone who gets blasted off by his pads"
 },
 {
  "i": 184,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "is sent flying through the sky for three days and nights..."
 },
 {
  "i": 185,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "Nobody except the person who was sent flying knows where to, though..."
 },
 {
  "i": 186,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "But it definitely won't be on this island..."
 },
 {
  "i": 187,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "Or anywhere else where you might meet them anytime soon."
 },
 {
  "i": 188,
  "style": "Main",
  "name": "Sentoumaru",
  "text": "They might end up on the edge of some distant sea."
 },
 {
  "i": 189,
  "style": "Main",
  "name": "Luffy",
  "text": "What?!"
 },
 {
  "i": 190,
  "style": "Main",
