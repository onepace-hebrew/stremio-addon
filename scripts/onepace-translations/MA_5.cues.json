[
 {
  "i": 0,
  "style": "Main",
  "name": "",
  "text": "Vmy heart feels like it's gonna burst!"
 },
 {
  "i": 1,
  "style": "Title",
  "name": "",
  "text": "{\\fad(590,300)}Luffy and Whitebeard"
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "Hey, partner! Can't you do anything?!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "How is my wax power gonna help us here?!"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "Why are Luffy and the others falling from the sky?"
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "To answer that, we must turn back the clock a little."
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "What was that?"
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "The wave stopped!"
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "What happened?!"
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "What the hell is this?!"
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "We're trapped in ice! Now we can't go anywhere at all!"
 },
 {
  "i": 11,
  "style": "Flashbacks",
  "name": "",
  "text": "The only one who could've done this is..."
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "Take a look below. There's your answer."
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "Old Whitebeard..."
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "The battle has already begun!"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "Listen up, you guys!"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "I've got an idea how we can get past this!"
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "Now that we've made it this far, we have to hurry!"
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "We've got less than three hours till they execute Ace!"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "Yeah, so?"
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "What?!"
 },
 {
  "i": 21,
  "style": "Main",
  "name": "",
  "text": "He wants us to slide the ship down the frozen wave?"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "That's our only choice! First off, we have to break the ship out of the ice!"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "Are you an idiot?! This is a warship! It's not gonna move that easily!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "That's right, you moron!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "If we work together, I know we can do this!"
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "I'm starting to feel like we really can..."
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "That's right! We've got the man who's gonna conquer the world, Captain Buggy, on our side!"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "If the Captain says we can do it, then I know we can!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "Calling all ships and troops."
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "Our target is site TOTTZ."
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "Change formation and initiate Operation Three."
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "It's a broadcast of the Navy's plans..."
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "Make haste with the preparations."
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "TOT... What was that about?"
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "Dunno... Probably some sort of code."
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "Once the preparations are complete, we'll push the schedule forward and execute Ace!"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "Over!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "Luffy{\\i1}-kun{\\i0}..."
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "Let's hurry!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "Vwe can't wait any longer. There's no time to argue about this!"
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "Everyone! Vwe're going with Straw Hat-boy's idea!"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "Go!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "H-Hey!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "Wrong way!"
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "That brings us back to the present, where Luffy and the others are falling."
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "What happened?! Was that a warship falling out of the sky?!"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "It's water... We're saved."
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "We fell into the sea."
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "I thought we were gonna crash into the ice and die."
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "Why is there no ice in this one spot?"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "Climb up! Get higher!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "This ain't nothing compared to the water torture in Hell!"
 },
 {
  "i": 53,
  "style": "Thoughts",
  "name": "",
  "text": "I swear, these Devil Fruit users..."
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "Ace!!!"
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "Luffy!!!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "I finally found you!"
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "Hey! Is that..."
 },
 {
  "i": 58,
  "style": "Main",
  "name": "",
  "text": "Crocodile!"
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "That's not who I meant! Who's that huge-faced guy?"
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "Vi'd expect no less from the Navy's full force. They're not to be underestimated."
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "Get ready for me, world!"
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "Ace! I'm here to save you!"
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "We're all here to save you!"
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "Garp! It's your damn family again!"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "Luffy!"
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "Look! It's not only Straw Hat!"
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "Jinbe! And even Ivankov from the Revolutionary Army!"
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "And behind them is a horde of history's most notorious pirates!"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "They're the Impel Down escapees!"
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "The man who everybody talks about. Straw Hat."
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "Straw... Hat..."
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "What's he doing here?!"
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "That's not his usual crew, is it?"
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "Luffy! I am so glad you are safe!"
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "You have to see this, Helmeppo{\\i1}-san{\\i0}!"
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "What is it? Nothing is gonna surprise me anym-"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "Straw Hat!"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "And I heard he'd been imprisoned in Impel Down! He really is amazing!"
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "That's one hell of a team he brought with him."
 },
 {
  "i": 80,
  "style": "Main",
  "name": "",
  "text": "I didn't think I'd be seeing him again so soon."
 },
 {
  "i": 81,
  "style": "Main",
  "name": "",
  "text": "Hey, that's the little brother Ace is always talking about."
 },
 {
  "i": 82,
  "style": "Main",
  "name": "",
  "text": "Now we've got all the Warlords here, new and old!"
 },
 {
  "i": 83,
  "style": "Main",
  "name": "",
  "text": "And that's the troublemaker rookie, Straw Hat?"
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "Smoker{\\i1}-san{\\i0}, look!"
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "I know."
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "You're mine!"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "Straw Hat and Crocodile..."
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "Why are they working together?"
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "So that's him..."
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "Not only is he the grandson of Garp the Hero..."
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "he's also the son of the Revolutionary Dragon..."
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "We'll have to eliminate him as well."
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "Of all the things you could have done, you joined forces with Straw Hat Luffy..."
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "Is this your answer, Jinbe?!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "That's right! I quit being a Warlord!"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "Any way you look at it, that's a strange team..."
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "I seriously doubt they all have the same objective."
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "At least, not on this battlefield."
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "Where's Croco-boy?"
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "Huh? Well, considering the situation..."
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "There he is!"
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "He's trying to beat me to it!"
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "Crocodile is moving in on Whitebeard!"
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "Old Man!"
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "Long time no see, Whitebeard!"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "You never learn, do you?"
 },
 {
  "i": 107,
  "style": "Thoughts",
  "name": "",
  "text": "So you already made preparations to fight me, huh?"
 },
 {
  "i": 108,
  "style": "Flashbacks",
  "name": "",
  "text": "Once you become wet, you can't turn into sand!"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "I honored our agreement and helped you get here."
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "Why are you defending Whitebeard?"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "So this old guy really is Whitebeard?"
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "Then don't touch him!"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "Ace likes this old guy!"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "You're pretty good, Ace's brother."
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "Don't let him near the Old Man!"
 },
 {
  "i": 116,
  "style": "Flashbacks",
  "name": "",
  "text": "When a man as great as you came back from the\\NEast Blue missing an arm, everyone was surprised."
 },
 {
  "i": 117,
  "style": "Flashbacks",
  "name": "",
  "text": "What sort of enemy did you give it up to?"
 },
 {
  "i": 118,
  "style": "Flashbacks",
  "name": "",
  "text": "That left arm of yours."
 },
 {
  "i": 119,
  "style": "Flashbacks",
  "name": "",
  "text": "I wagered it..."
 },
 {
  "i": 120,
  "style": "Flashbacks",
  "name": "",
  "text": "on the new era."
 },
 {
  "i": 121,
  "style": "Main",
  "name": "",
  "text": "Kid... That straw hat of yours..."
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "It looks a lot like the one Red Hair used to wear."
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "You know Shanks, old guy?"
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "I'm holding it for Shanks."
 },
 {
  "i": 125,
  "style": "Flashbacks",
  "name": "",
  "text": "Look at this, Old Man! This is my little brother!"
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Have you come to save your brother?"
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "That's right!"
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "Don't you understand what you're up against?!"
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "Someone like you doesn't stand a chance here!"
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "Shut up! That's not for you to decide!"
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "I know perfectly well! You wanna be the Pirate King, don't you?!"
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "But I'm going to be the Pirate King, not you!"
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "You're pretty damn cheeky..."
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "I won't show mercy if you slow me down, you spoiled brat!"
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "I'm doing what I want to do!"
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "I'm gonna save Ace myself!"
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "H-He's..."
 },
 {
  "i": 138,
  "style": "Main",
  "name": "",
  "text": "standing up to Whitebeard!"
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "Unbelievable!"
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "I can execute every one of them, right, Sengoku{\\i1}-san{\\i0}?"
 },
 {
  "i": 141,
  "style": "Main",
  "name": "",
  "text": "Of course."
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "They're moving Ace's execution time up?"
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "You're sure that's what they said?"
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "After they finish some kind of preparations."
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "Then some code stuff I didn't really get."
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "Since you wanna save Ace, too, I thought I'd tell you!"
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "I see. This is rather important news."
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "Sorry about before."
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "Don't worry about it."
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "Why are they having such a friendly chat?!"
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "Right!"
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "Ace, I'm coming now!"
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "How is he so confident?!"
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "Move it!"
 },
 {
  "i": 155,
  "style": "Main",
  "name": "",
  "text": "So that's Ace's little brother?"
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "Don't get in the kid's way!"
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "Third Division, start your assault!"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "We're going too."
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "Seriously?!"
 },
 {
  "i": 160,
  "style": "Main",
  "name": "",
  "text": "Fourteenth Division, clear his path!"
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "Yes sir, Commander Jil!"
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "Luffy..."
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "Just one man's recklessness got them this riled up?"
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "Regardless, this won't alter our plans."
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "Don't lose focus!"
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "Proceed as instructed!"
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "That Sengoku..."
 },
 {
  "i": 168,
  "style": "Main",
  "name": "",
  "text": "Now that he's up against pirates, there's no need to keep the old execution time?"
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "These \"preparations\" he's planning must be the key."
 },
 {
  "i": 170,
  "style": "Main",
  "name": "",
  "text": "Old Man!"
 },
 {
  "i": 171,
  "style": "Main",
  "name": "",
  "text": "According to a Navy transmission, they're going to accelerate Ace's execution."
 },
 {
  "i": 172,
  "style": "Main",
  "name": "",
  "text": "Yeah, I heard."
 },
 {
  "i": 173,
  "style": "Main",
  "name": "",
  "text": "We'll play right into their plans if we start panicking over this leaked information."
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "He's not sloppy. It's no accident."
 },
 {
  "i": 175,
  "style": "Main",
  "name": "",
  "text": "Not coming from that man."
 },
 {
  "i": 176,
  "style": "Main",
  "name": "",
  "text": "Shove through!"
 },
 {
  "i": 177,
  "style": "Main",
  "name": "",
  "text": "Light-speed kicks?!"
 },
 {
  "i": 178,
  "style": "Main",
  "name": "",
  "text": "Don't get carried away. I won't let you through that easily."
 },
 {
  "i": 179,
  "style": "Main",
  "name": "",
  "text": "It's Admiral Kizaru!"
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "It's you, from Sabaody!"
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "The Celestial Dragons will be on my case if I let you get away again."
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "Straw Hat Luffy."
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "That Straw Hat guy's about to die!"
 },
 {
  "i": 184,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Death Wink!"
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "I want to turn back and go home now!"
 },
 {
  "i": 186,
  "style": "Main",
  "name": "",
  "text": "What, Captain Buggy?!"
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "I can't believe what you're saying!"
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "Huh?"
 },
 {
  "i": 189,
  "style": "Main",
  "name": "",
  "text": "You wanna turn the tables of this battle? Are you serious?!"
 },
 {
  "i": 190,
  "style": "Main",
  "name": "",
  "text": "Well, I..."
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "Nothing less from the legendary crew!"
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "He doesn't even flinch facing Admiral Kizaru!"
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "Well, no..."
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "You guys only hear what you want to hear!"
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "Straw Hat-boy, are vyou alright?"
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "That was close! Thanks, Iva{\\i1}-chan{\\i0}!"
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "It is vmy mission to protect vyou from death!"
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "Kizaru again!"
 },
 {
  "i": 199,
  "style": "Main",
  "name": "",
  "text": "Wait, no. That's..."
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "Kuma!"
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "That's the bear-guy who sent us all flying!"
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Rolling Aesthe!"
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "Bartholomew Kuma!"
 },
 {
  "i": 204,
  "style": "Thoughts",
  "name": "",
  "text": "This is terrible!"
 },
 {
  "i": 205,
  "style": "Thoughts",
  "name": "",
  "text": "Even though he's standing over with the other Warlords,"
 },
 {
  "i": 206,
  "style": "Thoughts",
  "name": "",
  "text": "he's shooting lasers at vme after all vwe've been through together?"
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "How unlucky for you to bump into us."
 },
 {
  "i": 208,
  "style": "Main",
  "name": "",
  "text": "Straw Hat. This is where it ends for you!"
 },
 {
  "i": 209,
  "style": "Main",
  "name": "",
  "text": "Huh... Who're you?"
 },
 {
  "i": 210,
  "style": "Main",
  "name": "",
  "text": "I'm Fullbody!"
 },
 {
  "i": 211,
  "style": "Main",
  "name": "",
  "text": "I still owe you from the floating restaurant Baratie!"
 },
 {
  "i": 212,
  "style": "Main",
  "name": "",
  "text": "Ah... the guy who got his ass kicked by Sanji."
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "Don't tell me you've forgotten these chakrams?"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "Aren't you that hypnotist from Usopp's village?"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "What are you doing here?"
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "With the Navy's help, I've perfected..."
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "Jango{\\i1}-sama{\\i0}'s Hypnotism."
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "Two chakrams. Twice as effective."
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "With \"One, Two, Jango\" you will fall asleep."
 },
 {
  "i": 220,
  "style": "Main",
  "name": "",
  "text": "One, two..."
 },
 {
  "i": 221,
  "style": "Main",
  "name": "",
  "text": "Jango!"
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "What's going on here?"
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "Hina disappointed."
 },
 {
  "i": 224,
  "style": "Main",
  "name": "",
  "text": "You... I met you back in Alabasta!"
 },
 {
  "i": 225,
  "style": "Main",
  "name": "",
  "text": "I don't have any more time to waste with you guys!"
 },
 {
  "i": 226,
  "style": "Main",
  "name": "",
  "text": "I won't let you run."
 },
 {
  "i": 227,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Kimono Sleeve Cage!"
 },
 {
  "i": 228,
  "style": "Main",
  "name": "",
  "text": "Everything that passes through my body... is locked tight."
 },
 {
  "i": 229,
  "style": "Main",
  "name": "",
  "text": "There it is, her signature phrase!"
 },
 {
  "i": 230,
  "style": "Main",
  "name": "",
  "text": "Now you shall be captivated by Madame Hina!"
 },
 {
  "i": 231,
  "style": "Main",
  "name": "",
  "text": "I've had enough of being in cages!"
 },
 {
  "i": 232,
  "style": "Main",
  "name": "",
  "text": "Gear Second"
 },
 {
  "i": 233,
  "style": "Main",
  "name": "",
  "text": "He's fast!"
 },
 {
  "i": 234,
  "style": "Main",
  "name": "",
  "text": "I couldn't see him!"
 },
 {
  "i": 235,
  "style": "Main",
  "name": "",
  "text": "Hina negligence."
 },
 {
  "i": 236,
  "style": "Main",
  "name": "",
  "text": "Our negligence too."
 },
 {
  "i": 237,
  "style": "Main",
  "name": "",
  "text": "Madame Hina has bound our bodies and our hearts."
 },
 {
  "i": 238,
  "style": "Main",
  "name": "",
  "text": "Stop right there!"
 },
 {
  "i": 239,
  "style": "Main",
  "name": "",
  "text": "Every single one of these guys is strong!"
 },
 {
  "i": 240,
  "style": "Main",
  "name": "",
  "text": "Straw Hat!"
 },
 {
  "i": 241,
  "style": "Main",
  "name": "",
  "text": "His ability is impressive, as always."
 },
 {
  "i": 242,
  "style": "Main",
  "name": "",
  "text": "That reminds me."
 },
 {
  "i": 243,
  "style": "Main",
  "name": "",
  "text": "I should take his shadow once again, and bring Oars back to life with it."
 },
 {
  "i": 244,
  "style": "Main",
  "name": "",
  "text": "Come out and play, zombie warriors!"
 },
 {
  "i": 245,
  "style": "Main",
  "name": "",
  "text": "Now, my minions, go and capture Straw Hat!"
 },
 {
  "i": 246,
  "style": "Main",
  "name": "",
  "text": "Moriah!"
 },
 {
  "i": 247,
  "style": "Main",
  "name": "",
  "text": "Another tough guy."
 },
 {
  "i": 248,
  "style": "Main",
  "name": "",
  "text": "Have them back!"
 },
 {
  "i": 249,
  "style": "Main",
  "name": "",
  "text": "There's more!"
 },
 {
  "i": 250,
  "style": "Main",
  "name": "",
  "text": "Of course! This is a battlefield!"
 },
 {
  "i": 251,
  "style": "Main",
  "name": "",
  "text": "People dying simply adds to my zombie army!"
 },
 {
  "i": 252,
  "style": "Main",
  "name": "",
  "text": "Capture Straw Hat!"
 },
 {
  "i": 253,
  "style": "Main",
  "name": "",
  "text": "He's the culprit behind the prison break!"
 },
 {
  "i": 254,
  "style": "Main",
  "name": "",
  "text": "Keep it up!"
 },
 {
  "i": 255,
  "style": "Main",
  "name": "",
  "text": "Your opponents are all commissioned officers."
 },
 {
  "i": 256,
  "style": "Main",
  "name": "",
  "text": "How far do you think you will get?"
 },
 {
  "i": 257,
  "style": "Main",
  "name": "",
  "text": "Luffy..."
 },
 {
  "i": 258,
  "style": "Main",
  "name": "",
  "text": "Keep away, Luffy!"
 },
 {
  "i": 259,
  "style": "Main",
  "name": "",
  "text": "You oughta know already!"
 },
 {
  "i": 260,
  "style": "Main",
  "name": "",
  "text": "You and I are both pirates!"
 },
 {
  "i": 261,
  "style": "Main",
  "name": "",
  "text": "You should be out sailing however you want!"
 },
 {
  "i": 262,
  "style": "Main",
  "name": "",
  "text": "Me, I have my own adventures!"
 },
 {
  "i": 263,
  "style": "Main",
  "name": "",
  "text": "Me, I have my own friends!"
 },
 {
  "i": 264,
  "style": "Main",
  "name": "",
  "text": "Ace..."
 },
 {
  "i": 265,
  "style": "Main",
  "name": "",
  "text": "You have no right to interfere with that!"
 },
 {
  "i": 266,
  "style": "Main",
  "name": "",
  "text": "A weakling like you coming to rescue me..."
 },
 {
  "i": 267,
  "style": "Main",
  "name": "",
  "text": "Move!"
 },
 {
  "i": 268,
  "style": "Main",
  "name": "",
  "text": "Do you think I'm gonna let that happen?!"
 },
 {
  "i": 269,
  "style": "Main",
  "name": "",
  "text": "That would be too humiliating."
 },
 {
  "i": 270,
  "style": "Main",
  "name": "",
  "text": "Go back, Luffy! Why did you come?!"
 },
 {
  "i": 271,
  "style": "Thoughts",
  "name": "",
  "text": "Please, Luffy..."
 },
 {
  "i": 272,
  "style": "Thoughts",
  "name": "",
  "text": "I don't want to take you with me!"
 },
 {
  "i": 273,
  "style": "Thoughts",
  "name": "",
  "text": "This is my failure."
 },
 {
  "i": 274,
  "style": "Main",
  "name": "",
  "text": "I'm..."
 },
 {
  "i": 275,
  "style": "Main",
  "name": "",
  "text": "your brother!"
 },
 {
  "i": 276,
  "style": "Flashbacks",
  "name": "",
  "text": "Didn't ya know?"
 },
 {
  "i": 277,
  "style": "Flashbacks",
  "name": "",
  "text": "When you exchange sake cups, you become brothers."
 },
 {
  "i": 278,
  "style": "Flashbacks",
  "name": "",
  "text": "From today onward, we are brothers!"
 },
 {
  "i": 279,
  "style": "Main",
  "name": "",
  "text": "Just then, he definitely said \"brother\"..."
 },
 {
  "i": 280,
  "style": "Main",
  "name": "",
  "text": "That means he is also Roger's...?"
 },
 {
  "i": 281,
  "style": "Main",
  "name": "",
  "text": "Ace's parents died after he was born!"
 },
 {
  "i": 282,
  "style": "Main",
  "name": "",
  "text": "There's no way he can have a younger brother!"
 },
 {
  "i": 283,
  "style": "Main",
  "name": "",
  "text": "Those stupid pirate \"rules\"..."
 },
 {
  "i": 284,
  "style": "Main",
  "name": "",
  "text": "I've never heard of them!"
 },
 {
  "i": 285,
  "style": "Main",
  "name": "",
  "text": "Don't you get it?"
 },
 {
  "i": 286,
  "style": "Main",
  "name": "",
  "text": "Go, my zombie minions!"
 },
 {
  "i": 287,
  "style": "Main",
  "name": "",
  "text": "S-Sea water?"
 },
 {
  "i": 288,
  "style": "Main",
  "name": "",
  "text": "Jinbe!"
 },
 {
  "i": 289,
  "style": "Main",
  "name": "",
  "text": "They're weak against salt."
 },
 {
  "i": 290,
  "style": "Main",
  "name": "",
  "text": "Moriah, those zombies of yours..."
 },
 {
  "i": 291,
  "style": "Main",
  "name": "",
  "text": "Luffy{\\i1}-kun{\\i0}, leave the zombies to me."
 },
 {
  "i": 292,
  "style": "Main",
  "name": "",
  "text": "I'm counting on you."
 },
 {
  "i": 293,
  "style": "Main",
  "name": "",
  "text": "Knight of the Sea Jinbe!"
 },
 {
  "i": 294,
  "style": "Main",
  "name": "",
  "text": "Former member of the Seven Warlords..."
 },
 {
  "i": 295,
  "style": "Main",
  "name": "",
  "text": "What are you doing?"
 },
 {
  "i": 296,
  "style": "Main",
  "name": "",
  "text": "It's only one rookie... Don't let him dictate the entire war this way!"
 },
 {
  "i": 297,
  "style": "Main",
  "name": "",
  "text": "Out of my way!"
 },
 {
  "i": 298,
  "style": "Main",
  "name": "",
  "text": "I'll crush him!"
 },
 {
  "i": 299,
  "style": "Main",
  "name": "",
  "text": "That man will be a danger in the future."
 },
 {
  "i": 300,
  "style": "Main",
  "name": "",
  "text": "He was raised with his sworn brother, Ace."
 },
 {
  "i": 301,
  "style": "Main",
  "name": "",
  "text": "But his actual bloodline makes him the son of the Revolutionary, Dragon!"
 },
 {
  "i": 302,
  "style": "Main",
  "name": "",
  "text": "The Revolutionary Dragon?!"
 },
 {
  "i": 303,
  "style": "Main",
  "name": "",
  "text": "The son of the world's most fearsome criminal?!"
 },
 {
  "i": 304,
  "style": "Main",
  "name": "",
  "text": "And I know this person!"
 },
 {
  "i": 305,
  "style": "Main",
  "name": "",
  "text": "His papa's a big deal!"
 },
 {
  "i": 306,
  "style": "Main",
  "name": "",
  "text": "He's gone and said it."
 },
 {
  "i": 307,
  "style": "Main",
  "name": "",
  "text": "Luffy{\\i1}-san{\\i0}...!"
 },
 {
  "i": 308,
  "style": "Main",
  "name": "",
  "text": "Luffy..."
 },
 {
  "i": 309,
  "style": "Thoughts",
  "name": "",
  "text": "Knowing you're the child of a demon makes me..."
 },
 {
  "i": 310,
  "style": "Main",
  "name": "",
  "text": "So that's how it is?!"
 },
 {
  "i": 311,
  "style": "Main",
  "name": "",
  "text": "I get it now."
 },
 {
  "i": 312,
  "style": "Flashbacks",
  "name": "",
  "text": "Bastard!"
 },
 {
  "i": 313,
  "style": "Main",
  "name": "",
  "text": "That solves the riddle from Loguetown."
 },
 {
  "i": 314,
  "style": "Main",
  "name": "",
  "text": "That's why Dragon saved him..."
 },
 {
  "i": 315,
  "style": "Main",
  "name": "",
  "text": "Did you just hear that?"
 },
 {
  "i": 316,
  "style": "Main",
  "name": "",
  "text": "Dragon... The Dragon?!"
 },
 {
  "i": 317,
  "style": "Main",
  "name": "",
  "text": "Head Office! Head Office!"
 },
 {
  "i": 318,
  "style": "Main",
  "name": "",
  "text": "This is Sabaody Archipelago."
 },
 {
  "i": 319,
  "style": "Main",
  "name": "",
  "text": "Big news!"
 },
 {
  "i": 320,
  "style": "Main",
  "name": "",
  "text": "T-Tell the world!"
 },
 {
  "i": 321,
  "style": "Main",
  "name": "",
  "text": "We mustn't let him live!"
 },
 {
  "i": 322,
  "style": "Main",
  "name": "",
  "text": "Take him down with everything we have!"
 },
 {
  "i": 323,
  "style": "Main",
  "name": "",
  "text": "Fine."
 },
 {
  "i": 324,
  "style": "Main",
  "name": "",
  "text": "There's no point in hiding it anymore."
 },
 {
  "i": 325,
  "style": "Main",
  "name": "",
  "text": "Luffy is already a notorious outlaw. This news won't make any difference now."
 },
 {
  "i": 326,
  "style": "Main",
  "name": "",
  "text": "Raising them as brothers was a big mistake!"
 },
 {
  "i": 327,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 328,
  "style": "Main",
  "name": "",
  "text": "Say whatever the hell you want!"
 },
 {
  "i": 329,
  "style": "Main",
  "name": "",
  "text": "I'm saving you, even if I die!"
 },
 {
  "i": 330,
  "style": "Main",
  "name": "",
  "text": "That kid."
 },
 {
  "i": 331,
  "style": "Main",
  "name": "",
  "text": "Only Straw Hat could say that to him!"
 },
 {
  "i": 332,
  "style": "Main",
  "name": "",
  "text": "We're Ace's family!"
 },
 {
  "i": 333,
  "style": "Main",
  "name": "",
  "text": "Show us that you can save him!"
 },
 {
  "i": 334,
  "style": "Main",
  "name": "",
  "text": "Marco, don't let him die."
 },
 {
  "i": 335,
  "style": "Main",
  "name": "",
  "text": "Roger that."
 },
 {
  "i": 336,
  "style": "Main",
  "name": "",
  "text": "Luffy..."
 }
]