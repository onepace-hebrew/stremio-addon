דיין יפות!"},{"i":190,"he":"נקללו?"},{"i":191,"he":"על מה הן מדברות?"},{"i":192,"he":"לא משנה איך מסתכלים על זה,\\Nפשוט אכלתן פרי שטן!"},{"i":193,"he":"הוצאה להורג! הוצאה להורג!"},{"i":194,"he":"הוצאה להורג!..."},{"i":195,"he":"אולי פשוט אבלע אותו בשלמותו..."},{"i":196,"he":"או שאחנק אותו למוות..."},{"i":197,"he":"אל תגידו שהוא קפא מפחד!"},{"i":198,"he":"פשוט תעמוד שם ותמות!"},{"i":199,"he":"הנה!"},{"i":200,"he":"אין להן סדקים, נכון?"},{"i":201,"he":"אתן שלוש, המתינו פה."},{"i":202,"he":"סליחה על זה. בגללי אתן הפכתן לאבן."},{"i":203,"he":"אם צ'ופר היה פה,\\Nהייתי מבקש ממנו לבדוק אתכן מיד."},{"i":204,"he":"זה בדיוק כמו כשרובין ואני\\Nנהפכנו לקרח על ידי אאוקיג'י."},{"i":205,"he":"יכול להיות שתוכלו לחזור לקדמותכן."},{"i":206,"he":"לא עדיף שתדאג לבטיחות שלך במקום לשלהן?"},{"i":207,"he":"שתקי! אני אעשה מה שבא לי!"},{"i":208,"he":"הגבר הזה..."},{"i":209,"he":"הוא מנסה להציל את מרגריט והאחרות?"},{"i":210,"he":"אין מצב!"},{"i":211,"he":"כבר גזרו עליו מוות!"},{"i":212,"he":"טוב אז..."},{"i":213,"he":"בקיצור, אני פשוט צריך להרביץ לכן, נכון?"},{"i":214,"he":"אין מצב!"},{"i":215,"he":"מה הילד הזה הרגע אמר?"},{"i":216,"he":"הוא חושב שהוא יכול להרביץ לאחיות?"},{"i":217,"he":"מצחיק! לגרום לאנשים לצחוק\\Nאחרי שנגזר עליו מוות!"},{"i":218,"he":"גברים באמת מצחיקים!"},{"i":219,"he":"אני יכול לעשות את זה, נכון?\\Nלהרביץ לכן, כלומר."},{"i":220,"he":"כן, ברור שאתה יכול."},{"i":221,"he":"אם עוד לא ויתרת על החיים,\\Nתן לי להגיד לך משהו."},{"i":222,"he":"אם הייתי במקומך, לא הייתי נופל\\Nלבור בין המושבים לזירה!"},{"i":223,"he":"לא אכפת לי אם זה יקרה,\\Nאבל אם תיפול, היתדות למטה ידקרו אותך."},{"i":224,"he":"אז, בואו נתחיל."},{"i":225,"he":"הרגו אותו, סנדרסוניה, מריגולד!"},{"i":226,"he":"על פשע הפלישה לאי הנשים הזה!"},{"i":227,"he":"ועל שעלבת אותי,"},{"i":228,"he":"הראו לו את אמנות העונש!"},{"i":229,"he":"חיכיתי לזה!"},{"i":230,"he":"קח את זה, ואת זה, ואת זה!"},{"i":231,"he":"הוא לא רע בזה, הא?"},{"i":232,"he":"תפסי אותו, אדונתי מריגולד!"},{"i":233,"he":"מה זה...?!"},{"i":234,"he":"רעל?! זה היה קרוב!"},{"i":235,"he":"זה רעל קטלני! חבל עליך!"},{"i":236,"he":"גומי-גומי..."},{"i":237,"he":"חותמת!"},{"i":238,"he":"זה קפץ בחזרה!"},{"i":239,"he":"זה כואב!"},{"i":240,"he":"איך...?! אני עשוי מגומי!"},{"i":241,"he":"ראיתן! הוא באמת רק נביחות בלי נשיכה!"},{"i":242,"he":"אבל זה נכון שגברים נמתחים! מעניין!"},{"i":243,"he":"הא?! אני כבר לא גומי?!"},{"i":244,"he":"לא, זה לא זה!"},{"i":245,"he":"אז למה מהלומות כואבות?!"},{"i":246,"he":"זה לא פייר."},{"i":247,"he":"אל תשמרי את כל הכיף לעצמך, מארי."},{"i":248,"he":"גם אני רוצה להשתעשע איתו!"},{"i":249,"he":"למה זה כואב?! אני עשוי מגומי!"},{"i":250,"he":"גם הבחור עם גרזן הקרב היה כזה..."},{"i":251,"he":"זה אומר שזה לא כוח של פרי שטן?"},{"i":252,"he":"אני מניחה שגם לך יש כוחות."},{"i":253,"he":"לעזאזל!"},{"i":254,"he":"אבל אני מניחה שאתה לא יכול להשתמש בהאקי?"},{"i":255,"he":"רוב הזרים לא יכולים."},{"i":256,"he":"לכן אתה חלש."},{"i":257,"he":"בעיטה ברגל שמאל."},{"i":258,"he":"לכאן!"},{"i":259,"he":"היא ניחשה לי את התנועה!"},{"i":260,"he":"מכת נחש!"},{"i":261,"he":"כן!"},{"i":262,"he":"זה לא כאב."},{"i":263,"he":"כמו תמיד."},{"i":264,"he":"גומי-גומי..."},{"i":265,"he":"גאטלינג!"},{"i":266,"he":"ריקוד נחש!"},{"i":267,"he":"איזה תנועות מדהימות!"},{"i":268,"he":"עם ההאקי של אדונתי סוניה אין התקפה\\Nשהיא לא יכולה להתחמק ממנה!"},{"i":269,"he":"אתה מאוד ישיר."},{"i":270,"he":"אני קוראת אותך כמו ספר."},{"i":271,"he":"מה קורה פה?!"},{"i":272,"he":"היא מנחשת לי כל תנועה!"},{"i":273,"he":"להתמקד רק בהתקפה זה נחמד וכל זה, אבל..."},{"i":274,"he":"מקל נחש!"},{"i":275,"he":"אוח!"},{"i":276,"he":"אל תשכח שאנחנו שתיים!"},{"i":277,"he":"הוא נופל לבור!"},{"i":278,"he":"זה היה קרוב!"},{"i":279,"he":"נסיכת הנחשים הניחה\\Nאת השיער מאחורי האוזן!"},{"i":280,"he":"אין גבול לחן שלה!"},{"i":281,"he":"הגבר הזה הוא ההגדרה המדויקת\\Nשל \"רק דיבורים\"."},{"i":282,"he":"אני לא יכולה שלא לצחוק."},{"i":283,"he":"שתקי, טמבלית!"},{"i":284,"he":"אוי ואבוי!"},{"i":285,"he":"הוא דיבר בגסות\\Nאל נסיכת הנחשים שוב!"},{"i":286,"he":"אין סליחה! מהרו והרגו אותו!"},{"i":287,"he":"סוניה! מארי!"},{"i":288,"he":"סיימו את חיי הגבר הזה מיד!"},{"i":289,"he":"כדי שלא יהיו עוד התפרצויות..."},{"i":290,"he":"מהפה המלוכלך שלו!"},{"i":291,"he":"נראה שזמן המשחק נגמר."},{"i":292,"he":"בואו ניתן לפושע ייאוש ומוות!"},{"i":293,"he":"היי! מה אתן עושות?!\\Nאל תיגעו בהן!"},{"i":294,"he":"מה אם היא תישבר?!"},{"i":295,"he":"היא הצילה לי את החיים, אתן יודעות!"},{"i":296,"he":"אנחנו הולכות לשבור אותה."},{"i":297,"he":"אמרת שהיא הצילה לך את החיים."},{"i":298,"he":"אז על אחת כמה וכמה."},{"i":299,"he":"עצוב לי עליה, אבל זה העונש שלך."},{"i":300,"he":"אל תהיו מטומטמות!"},{"i":301,"he":"הדו-קרב הזה הוא ביני לביניכן!"},{"i":302,"he":"לעזאזל! תעזבי!"},{"i":303,"he":"רק אתה חושב שזה דו-קרב."},{"i":304,"he":"זו הוצאה להורג פומבית!"},{"i":305,"he":"פשוט תשב ותסתכל!"},{"i":306,"he":"הפגיעה שגרמת לאחות שלנו\\Nחורגת הרבה מעבר לזה!"},{"i":307,"he":"כולן פה מעריצות את נסיכת הנחשים!"},{"i":308,"he":"היא חזקה, אצילית, והאישה\\Nהכי יפה בעולם!"},{"i":309,"he":"קיסרית הפיראטים, בואה הנקוק!"},{"i":310,"he":"היי! תפסיקו!"},{"i":311,"he":"היא העריצה אתכן, אתן יודעות!"},{"i":312,"he":"כולן בארץ הזו מעריצות אותה."},{"i":313,"he":"אז אני חושבת שזה מה שהיא הייתה רוצה!"},{"i":314,"he":"שטויות!"},{"i":315,"he":"מה אתן, טיפשות?!"},{"i":316,"he":"אוי ואבוי. איזו שפה גסה."},{"i":317,"he":"הנה זה בא!"},{"i":318,"he":"שלוש..."},{"i":319,"he":"היי! תפסיקי!"},{"i":320,"he":"שתיים..."},{"i":321,"he":"אין טעם."},{"i":322,"he":"אחת..."},{"i":323,"he":"מרגריט!"},{"i":324,"he":"אמרתי לכן להפסיק, לעזאזל!!"},{"i":325,"he":"הלוחמות מתעלפות!"},{"i":326,"he":"אין מצב..."},{"i":327,"he":"איזו הקלה!"},{"i":328,"he":"היא לא נפגעה בשום מקום!"},{"i":329,"he":"הו, אז אתן בכל זאת הגיוניות!"},{"i":330,"he":"הרגע... זה היה האקי של המלכים!"},{"i":331,"he":"זה לא יכול להיות אמיתי!"},{"i":332,"he":"רק אחד ממיליון אנשים מסוגל\\Nלהשתמש בהאקי של המלכים."},{"i":333,"he":"מעולם לא ראיתי אף אדם שיכול\\Nלהשתמש בזה מלבד האחות הגדולה שלנו!"},{"i":334,"he":"לילד הזה יש תכונות של מלך,\\Nשיכול לעמוד מעל כולם!"},{"i":335,"he":"יש לו את האקי של המלכים בדיוק כמוני?"},{"i":336,"he":"איך זה יכול להיות?!"},{"i":337,"he":"הוא בכלל לא סתם ילד?!"},{"i":338,"he":"מי לעזאזל הבחור הזה?!"},{"i":339,"he":"על מה כולן מקשקשות?"},{"i":340,"he":"מה הקטע הגדול?"},{"i":341,"he":"הוא לא מבין שהוא השתמש בהאקי?!"},{"i":342,"he":"אני מניחה שהוא עוד לא הבין\\Nאיך לשלוט בזה."},{"i":343,"he":"יופי!"},{"i":344,"he":"הראיתן לי שאתן חזקות!"},{"i":345,"he":"עכשיו בואו נמשיך בדו-קרב."}]