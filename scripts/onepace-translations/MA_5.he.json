{"i":281,"he":"ההורים של אייס מתו אחרי שהוא נולד!"},
{"i":282,"he":"אין מצב שיש לו אח קטן!"},
{"i":283,"he":"ה\"חוקים\" המטופשים של הפיראטים..."},
{"i":284,"he":"מעולם לא שמעתי עליהם!"},
{"i":285,"he":"אתה לא קולט?"},
{"i":286,"he":"קדימה, הזומבים שלי!"},
{"i":287,"he":"מ-מי ים?"},
{"i":288,"he":"ג'ינביי!"},
{"i":289,"he":"מלח מפרק אותם."},
{"i":290,"he":"מוריה, הזומבים האלו שלך..."},
{"i":291,"he":"לופי, תשאיר לי את הזומבים."},
{"i":292,"he":"אני סומך עליך."},
{"i":293,"he":"בכור הים ג'ינביי!"},
{"i":294,"he":"חבר לשעבר בשבעת לוחמי הים..."},
{"i":295,"he":"מה אתם עושים?"},
{"i":296,"he":"טירון אחד...\\Nאל תתנו לו לנהל את המלחמה!"},
{"i":297,"he":"זוזו מהדרך!"},
{"i":298,"he":"אני ארסק אותו!"},
{"i":299,"he":"האיש הזה עוד יסכן אותנו."},
{"i":300,"he":"הוא גדל כאח בשבועה לאייס."},
{"i":301,"he":"אבל בדם הוא בנו של המהפכן, דראגון!"},
{"i":302,"he":"דראגון המהפכן?!"},
{"i":303,"he":"הבן של הפושע הכי מפחיד בעולם?!"},
{"i":304,"he":"ואני מכיר אותו!"},
{"i":305,"he":"אבא שלו זה לא צחוק!"},
{"i":306,"he":"הוא פלט את זה."},
{"i":307,"he":"אדון לופי...!"},
{"i":308,"he":"לופי..."},
{"i":309,"he":"בן של שד... ולי אין מילים..."},
{"i":310,"he":"אז זה העניין?!"},
{"i":311,"he":"עכשיו זה מסתדר."},
{"i":312,"he":"ממזר!"},
{"i":313,"he":"זה סוגר את החידה מלוגטאון."},
{"i":314,"he":"בגלל זה דראגון הציל אותו..."},
{"i":315,"he":"שמעת את זה?"},
{"i":316,"he":"דראגון... הדראגון?!"},
{"i":317,"he":"משרד ראשי! משרד ראשי!"},
{"i":318,"he":"כאן ארכיפלג סבאודי."},
{"i":319,"he":"ידיעה ענקית!"},
{"i":320,"he":"ת-תספרו לעולם!"},
{"i":321,"he":"אסור להשאיר אותו בחיים!"},
{"i":322,"he":"תורידו אותו עם כל הכוח!"},
{"i":323,"he":"בסדר."},
{"i":324,"he":"אין טעם להחביא את זה יותר."},
{"i":325,"he":"לופי כבר פורע חוק מפורסם.\\Nמאוחר מידי לסגור את זה."},
{"i":326,"he":"טעות גדולה לגדל אותם כאחים!"},
{"i":327,"he":"אייס!"},
{"i":328,"he":"תגיד מה שבא לך!"},
{"i":329,"he":"אני מציל אותך גם אם אמות!"},
{"i":330,"he":"הילד הזה."},
{"i":331,"he":"רק כובע הקש יכול להגיד לו כזה דבר!"},
{"i":332,"he":"אנחנו המשפחה של אייס!"},
{"i":333,"he":"תראה לנו שאתה מציל אותו!"},
{"i":334,"he":"מארקו, אל תיתן לו למות."},
{"i":335,"he":"קיבלתי."},
{"i":336,"he":"לופי..."}
