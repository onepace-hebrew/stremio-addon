[
 {
  "i": 0,
  "style": "Title",
  "name": "",
  "text": "{\\fad(900,1500)}The Execution Platform"
 },
 {
  "i": 1,
  "style": "Main",
  "name": "",
  "text": "Yeah! Ace is alive!"
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "Hey, stay with me!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "Was that Ace's brother?!"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "Look at this!"
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "I almost passed out!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "Like Pops and Red Hair\\Nhe used Conqueror's Haki!"
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "Was he the one who did it?"
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "Seems like he used it unconsciously."
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "I didn't know that he had\\Nsuch tremendous power!"
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "He was born with it as I thought!"
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "He uses it, too!"
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "Back down if your heart is weak!"
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "He is not just another rookie!"
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "Conqueror's Haki!"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "But it's not surprising because he's\\Nthe son of Dragon the revolutionary!"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "Vice Admiral Doberman!"
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "Hey, where did you get the power from?!"
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "Huh?! What power?!"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "Never mind!"
 },
 {
  "i": 20,
  "style": "Thoughts",
  "name": "",
  "text": "He's not aware of it!"
 },
 {
  "i": 21,
  "style": "Thoughts",
  "name": "",
  "text": "So it's not ready to be used!"
 },
 {
  "i": 22,
  "style": "Thoughts",
  "name": "",
  "text": "But it's no wonder that he attracts people!"
 },
 {
  "i": 23,
  "style": "Thoughts",
  "name": "",
  "text": "This is why they say \"blood will tell,\" Dragon!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "Don't let him escape this battlefield! If\\Nyou do, he'll prove a formidable foe for us!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "Make sure he dies!"
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "Let's get Whitebeard first!"
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "He's a monster but he's wounded\\Nbadly! Bring him down at any cost!"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "You guys!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "Pops?!"
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "From now on, back Straw Hat Luffy up..."
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "with all your strength!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "Ace's brother?!"
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "Straw Hat-boy! Watch out!"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "You're..."
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "the allied pirate of Whitebeard, Bohemian Knight Doma!"
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "Nice to meet you, Vice Admiral Momonga!"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "DeCalvan Brothers!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "You got to fight...!"
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "Against us!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "Thunder Lord McGuy!"
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "I need you to fight me,\\NVice Admiral Doberman!"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "I-Is this...?!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "We pirates from the New World will assist you!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "Ace-{\\i1}chan{\\i0}'s right there! Let's go, Straw Hat!"
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "The allied pirates of Whitebeard\\Nare surrounding Straw Hat!"
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "What are they doing?!"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "Hurry up, Ace's brother!"
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "Navy forces are focusing on Pops now!"
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "This is your only chance\\Nto get beyond the admirals!"
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "Let's break through all\\Nat once! Come with us!"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "This is a big deal, Straw Hat-boy!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "The world's greatest pirate\\Nis putting you to the test!"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "Huh?"
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "Heehaw!"
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "Whitebeard put all his hopes\\Non you! That's a big thing!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "Are you ready to respond\\Nto his expectations?!"
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "I don't know what Whitebeard wants!"
 },
 {
  "i": 58,
  "style": "Main",
  "name": "",
  "text": "But I came here for..."
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "only one reason, right from the start!"
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "The pirates are gaining vigor!"
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "They're gonna break through!\\NWe need more troops!"
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "Vice Admiral-{\\i1}dono{\\i0}! Let's\\Nget Straw Hat first...!"
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "Wait!"
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "They left Whitebeard alone!\\NAttack Whitebeard now!"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "If we can bring Whitebeard\\Ndown, we can stop all of them!"
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "They think that they can beat me\\Nif they attack me all at one time!"
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "Whitebeard! Is he invincible?!"
 },
 {
  "i": 68,
  "style": "Thoughts",
  "name": "",
  "text": "Do it, brat!"
 },
 {
  "i": 69,
  "style": "Thoughts",
  "name": "",
  "text": "You just stopped them from\\Nexecuting Ace on my behalf!"
 },
 {
  "i": 70,
  "style": "Thoughts",
  "name": "",
  "text": "You have the middle initial D,"
 },
 {
  "i": 71,
  "style": "Thoughts",
  "name": "",
  "text": "so show me how the world\\Nwill be in years to come!"
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "That's..."
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "Hawk Eye!"
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "Heads up, Straw Hat-boy!"
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "What are you...?!"
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "It's the president's order! We consider\\Nthe Navy as our enemy for now! Go!"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "You're Daz Bones, aren't you?"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "Straw Hat-boy!"
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "Crocodile!"
 },
 {
  "i": 80,
  "style": "Main",
  "name": "",
  "text": "You're sleeping too much, Mr. 1!"
 },
 {
  "i": 81,
  "style": "Main",
  "name": "",
  "text": "I got out of shape by being in prison."
 },
 {
  "i": 82,
  "style": "Main",
  "name": "",
  "text": "I don't need you here, Straw Hat! Off you go!"
 },
 {
  "i": 83,
  "style": "Main",
  "name": "",
  "text": "Why are you standing in my way, Crocodile?"
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "I'm not in the best mood now."
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "So you better watch yourself, Hawk Eye!"
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "Luffy!"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "I want to help you, too!"
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "Shoot Monkey D. Luffy."
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "Boa Hancock. Friendly operative. Abort attack."
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "Hey!"
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "What do you think you're doing?!"
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "You're a Warlord, aren't you, Boa Hancock?!"
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "Why do you keep stopping the Pacifistas?!"
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "I thought you were on the Government's side!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "You're such a senseless man!\\NYou don't know anything!"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "What?!"
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "Let me tell you one thing."
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "Love is always a hurricane!"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "What're you talking about?!"
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "The scaffold is close now, Straw Hat-boy!"
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "You just run straight!"
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "Alright!"
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "Now is our chance to do it."
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "I'm sorry that you must do this when you're\\Nnot fully recovered."
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "But we need you!"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "It's nothing, Iva-{\\i1}san{\\i0}."
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "Don't worry about it."
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "Crab-{\\i1}chan{\\i0}!"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "What is that?!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "Inazuma of the Revolutionary Army! He did it!"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "There's a bridge! Alright!"
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "Straw Hat is heading straight towards the scaffold!"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "Do something or he'll reach it!"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "Don't let him!"
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "We can't! These pirates aren't letting us by!"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "Gah! Use guns! Fire at Straw Hat!"
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "What?! Th-They are..."
 },
 {
  "i": 118,
  "style": "Main",
  "name": "",
  "text": "commanders of the Whitebeard Pirates!"
 },
 {
  "i": 119,
  "style": "Main",
  "name": "",
  "text": "Ace's brother! Just run straight, don't stop!"
 },
 {
  "i": 120,
  "style": "Main",
  "name": "",
  "text": "Break through all at once!"
 },
 {
  "i": 121,
  "style": "Main",
  "name": "",
  "text": "Don't let him pass through!"
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Rubber-Rubber..."
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}...Battle Axe!"
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "Luffy-{\\i1}kun{\\i0}, go ahead!"
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "Alright, thanks!"
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Don't let him go!"
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Death Wink!"
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "No one will pass by here!"
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "Just advance, Straw Hat-boy!"
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "Straw Hat will make it!"
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "Yeah! Keep going!"
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "Yank Straw Hat down!"
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "Go, Straw Hat!"
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "Set Ace free!"
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "I can't believe that you used that\\Nkid as a trump card, Whitebeard!"
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "But I won't let him go any further!"
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "Whitebeard!"
 },
 {
  "i": 138,
  "style": "Main",
  "name": "",
  "text": "Why don't you stay quiet and watch?"
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "Luffy!"
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "I'm here, Ace!"
 },
 {
  "i": 141,
  "style": "Main",
  "name": "",
  "text": "It's Garp the Hero!"
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "Grandpa! Move out of my way!"
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "I'm not going to move!"
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "Because I'm a vice admiral of the Navy!"
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "I've been fighting against pirates\\Nsince long before you were born!"
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "Gramps!"
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "If you wanna pass through here,\\Nyou have to kill me first!"
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "Straw Hat Luffy!"
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "Because of the path you two..."
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "have chosen to live!"
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "You gotta find a way, Straw Hat-boy!\\NHurry up before the bridge collapses!"
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "Straw Hat!"
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "Luffy{\\i1}-kun!{\\i0}"
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "Ouch!"
 },
 {
  "i": 155,
  "style": "Main",
  "name": "",
  "text": "You bastard!"
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "Grandpa!"
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "Why do you want me to fight with these guys?!"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "That's your training!"
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "My training?!"
 },
 {
  "i": 160,
  "style": "Main",
  "name": "",
  "text": "It just makes me hungry and I\\Ndon't wanna get hit anymore!"
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "Don't be such a baby!"
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "You've got to become the strongest Navy soldier!"
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "I'm gonna become a pirate,\\Nnot a Navy soldier!"
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "Huh?"
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "You fool!"
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "Ouch!"
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "{\\fad(0,900)}Nothing's more painful than Grandpa's fist!"
 },
 {
  "i": 168,
  "style": "Main",
  "name": "",
  "text": "I can't do it, Grandpa! Move out of my way!"
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "If you can't, Ace will die!"
 },
 {
  "i": 170,
  "style": "Main",
  "name": "",
  "text": "No way!"
 },
 {
  "i": 171,
  "style": "Main",
  "name": "",
  "text": "Things don't always go as you want!\\NI'm not gonna have mercy on you!"
 },
 {
  "i": 172,
  "style": "Main",
  "name": "",
  "text": "Luffy, I consider you..."
 },
 {
  "i": 173,
  "style": "Main",
  "name": "",
  "text": "my enemy!"
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "Garp!"
 },
 {
  "i": 175,
  "style": "Flashbacks",
  "name": "",
  "text": "Dammit! What's wrong with me?! This isn't the time to..."
 },
 {
  "i": 176,
  "style": "Flashbacks",
  "name": "",
  "text": "Pops, my brother and my crew..."
 },
 {
  "i": 177,
  "style": "Flashbacks",
  "name": "",
  "text": "are falling, and yet..."
 },
 {
  "i": 178,
  "style": "Flashbacks",
  "name": "",
  "text": "I'm so happy... my tears won't stop..."
 },
 {
  "i": 179,
  "style": "Flashbacks",
  "name": "",
  "text": "Even now that it's come\\Nto this... I want to live..."
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "Vice Admiral Garp!"
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "You're their parent after all, Garp."
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "He is about to get to the scaffold!"
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "You called him a reckless piece of crap!"
 },
 {
  "i": 184,
  "style": "Main",
  "name": "",
  "text": "He is reckless!"
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "I wonder how he will free Fire Fist Ace."
 },
 {
  "i": 186,
  "style": "Main",
  "name": "",
  "text": "Get lost! You fool!"
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "You're not careful."
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 189,
  "style": "Flashbacks",
  "name": "",
  "text": "Take this."
 },
 {
  "i": 190,
  "style": "Flashbacks",
  "name": "",
  "text": "{\\fad(0,500)}This is the key to your brother's handcuffs."
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "I have the key!"
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "Luffy, you..."
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "Wh-What the hell is that?!"
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "Look! Fleet Admiral Sengoku is using his power!"
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "I've never seen it before!"
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "You can't get away from me!"
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "Sengoku!"
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "A giant Buddha!"
 },
 {
  "i": 199,
  "style": "Main",
  "name": "",
  "text": "I can't believe that you even have\\Nsuch a thing, Straw Hat Luffy!"
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "Oh no, the key!"
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "Get ready!"
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "Aim at them and be ready to\\Nfire at a moment's notice!"
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "No way, the key...!"
 },
 {
  "i": 204,
  "style": "Main",
  "name": "",
  "text": "Straw Hat Luffy!"
 },
 {
  "i": 205,
  "style": "Main",
  "name": "",
  "text": "You're a serious criminal who\\Nshould be punished by death, too!"
 },
 {
  "i": 206,
  "style": "Main",
  "name": "",
  "text": "I'm gonna execute both of you\\Nbrothers with my own bare hands!"
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "What was that? I passed\\Nout all of a sudden..."
 },
 {
  "i": 208,
  "style": "Main",
  "name": "",
  "text": "Straw Hat... Oh!"
 },
 {
  "i": 209,
  "style": "Main",
  "name": "",
  "text": "Three! Why are you here?!"
 },
 {
  "i": 210,
  "style": "Main",
  "name": "",
  "text": "What is that?!"
 },
 {
  "i": 211,
  "style": "Main",
  "name": "",
  "text": "Hey, Three! Protect Ace with a wall!"
 },
 {
  "i": 212,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Rubber-Rubber..."
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Giant Balloon!"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Candle Wall!"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "Is he expanding?!"
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "The scaffold is collapsing!"
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "What happened?!"
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "Ace is still alive!"
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "We're falling!"
 },
 {
  "i": 220,
  "style": "Main",
  "name": "",
  "text": "I'll make the key! Uncuff him right away!"
 },
 {
  "i": 221,
  "style": "Main",
  "name": "",
  "text": "Alright!"
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "Captain Buggy! There's Brother Three!"
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "What?! What is he doing in\\Nthat ridiculous costume?!"
 },
 {
  "i": 224,
  "style": "Main",
  "name": "",
  "text": "I thought he ran away from here already!"
 },
 {
  "i": 225,
  "style": "Main",
  "name": "",
  "text": "Where's the other guy?!\\NWhat's taking him so long?!"
 },
 {
  "i": 226,
  "style": "Main",
  "name": "",
  "text": "Since it was such short notice, he's\\Nhaving trouble getting ready..."
 },
 {
  "i": 227,
  "style": "Main",
  "name": "",
  "text": "Hey, hurry up!"
 },
 {
  "i": 228,
  "style": "Main",
  "name": "",
  "text": "Alright, let's go!"
 },
 {
  "i": 229,
  "style": "Main",
  "name": "",
  "text": "If I tell you that I'm here out\\Nof respect for my late comrade,"
 },
 {
  "i": 230,
  "style": "Main",
  "name": "",
  "text": "are you going to laugh at me?!"
 },
 {
  "i": 231,
  "style": "Main",
  "name": "",
  "text": "No, I won't!"
 },
 {
  "i": 232,
  "style": "Main",
  "name": "",
  "text": "Fire! Blow them away!"
 },
 {
  "i": 233,
  "style": "Main",
  "name": "",
  "text": "Save your brother, Straw Hat!"
 },
 {
  "i": 234,
  "style": "Main",
  "name": "",
  "text": "Okay!"
 },
 {
  "i": 235,
  "style": "Main",
  "name": "",
  "text": "Oh no!"
 },
 {
  "i": 236,
  "style": "Main",
  "name": "",
  "text": "Straw Hat-boy!"
 },
 {
  "i": 237,
  "style": "Main",
  "name": "",
  "text": "No way!"
 },
 {
  "i": 238,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 239,
  "style": "Main",
  "name": "",
  "text": "Brother Three!"
 },
 {
  "i": 240,
  "style": "Main",
  "name": "",
  "text": "They all got hit!"
 },
 {
  "i": 241,
  "style": "Main",
  "name": "",
  "text": "Fire Fist can't use his power because of\\Nthe seastone handcuffs!"
 },
 {
  "i": 242,
  "style": "Main",
  "name": "",
  "text": "He's dead!"
 },
 {
  "i": 243,
  "style": "Main",
  "name": "",
  "text": "And we got Straw Hat, too!"
 },
 {
  "i": 244,
  "style": "Main",
  "name": "",
  "text": "There's a tunnel of fire in the smoke!"
 },
 {
  "i": 245,
  "style": "Main",
  "name": "",
  "text": "You've always been like this!"
 },
 {
  "i": 246,
  "style": "Main",
  "name": "",
  "text": "Luffy!"
 },
 {
  "i": 247,
  "style": "Main",
  "name": "",
  "text": "You've never even listened to me..."
 },
 {
  "i": 248,
  "style": "Main",
  "name": "",
  "text": "and always done such crazy things!"
 },
 {
  "i": 249,
  "style": "Main",
  "name": "",
  "text": "Good!"
 },
 {
  "i": 250,
  "style": "Main",
  "name": "",
  "text": "Oh my!"
 },
 {
  "i": 251,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 252,
  "style": "Main",
  "name": "",
  "text": "I-I can't believe it!"
 },
 {
  "i": 253,
  "style": "Main",
  "name": "",
  "text": "Straw Hat and Brother Three are alive, too!"
 },
 {
  "i": 254,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 }
]