[
 {
  "i": 0,
  "style": "Main",
  "name": "",
  "text": "Why did the video cut out?!"
 },
 {
  "i": 1,
  "style": "Main",
  "name": "",
  "text": "Show us Marineford!"
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "Hurry and show it already!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "Something must have happened to their Visual Transponder Snails, there's nothing we can do!"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "The Navy and Whitebeard made a deal? Can it be true?!"
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "Show us something!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "Did Whitebeard really sell out his companions?!"
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "What's going on in this war?!"
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "What will happen to the world?!"
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "What an annoying move by the Navy..."
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "I guess the show's over, huh?"
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "We sailed back here just so we could watch the war..."
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "now they're having trouble with the Visual Transponder Snails?"
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "There's no way that's the truth."
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "Huh? It's not?"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "You sure are an idiot. It's obvious that they're hiding something."
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "Something they don't want pirates, or anyone else, to see..."
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "Captain Bonney..."
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "Shut up! Leave me alone!"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "Whitebeard sold out his companions?"
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "Like hell. He's a legend because he never does anything like that."
 },
 {
  "i": 21,
  "style": "Title",
  "name": "",
  "text": "{\\fad(1000,0)}Assault{\\pos(643,485)}"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "Time to set sail, Bepo."
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "Aye aye, Captain!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "Come with me, Jean Bart!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "That's right. It doesn't look like it'll be fixed anytime soon."
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "Right now, there's no way to tell what's happening in Marineford."
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "Meteor Volcano!{\\fad(150,150)}"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "We're not letting you escape!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "Melt the ice and take away their footing!"
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "T-The water..."
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "It's hot!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "The magma is making the water boil!"
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "Get out of the water, quickly!"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "Hey, look!"
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "This way is blocked too!"
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "Is there nothing we can do against this wall?!"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "Whitebeard..."
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "T-The Pops's attacks aren't working... That's no ordinary wall!"
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "Now, it's time to end this."
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "The Moby Dick took a direct hit from the magma!"
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "Put out the fire!"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "Hurry!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "You have to hold on!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "Don't let the ship sink!"
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "We're gonna travel the seas with our friends, and Ace, once more!"
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "Whitebeard. Your era is at an end!"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "The Moby Dick..."
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "Damn it! Damn the Navy!"
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "That was our pride and joy!"
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "Damn! They destroyed our ship! The ship that's carried the Whitebeard Pirates for decades!"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "Forgive me."
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "We're losing our only way into the plaza!"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "The plan is progressing smoothly."
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "The execution of Portgas D. Ace... will proceed..."
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "immediately!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "We can't even see what's going on!"
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "There's no way we'll let them kill Ace!"
 },
 {
  "i": 58,
  "style": "Main",
  "name": "",
  "text": "Yeah..."
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "There's still one way..."
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "One single path..."
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "The path that Oars made for us!"
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "If we go that way, we'll be killed. The Navy is sure to be waiting for us."
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "This is no time to stand around and chat!"
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "Yeah... If we're gonna save Ace, that's the only way..."
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "Straw Hat..."
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "We'll go, too!"
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "Yeah!"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "That route is far too obvious!"
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "It's not over yet! Hold them off as best as you can!"
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "Fire!"
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "There's no way the enemy would ignore the only opening!"
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "It's definitely a trap!"
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "Fire!"
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "Straw Hat-boy!"
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "Luffy{\\i1}-kun{\\i0}!"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "Little Oars Jr.! He was still alive?!"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "Ace... {\\i1}kun{\\i0}..."
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "Oars..."
 },
 {
  "i": 80,
  "style": "Main",
  "name": "",
  "text": "I'm... gonna protect... Ace{\\i1}-kun{\\i0}..."
 },
 {
  "i": 81,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 82,
  "style": "Main",
  "name": "",
  "text": "Captain Squard!"
 },
 {
  "i": 83,
  "style": "Main",
  "name": "",
  "text": "You guys..."
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "Right!"
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "Are you alright, Luffy{\\i1}-kun{\\i0}?"
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "Really, how reckless can vyou get?"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "Prepare to fire."
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "Shoot!"
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "I've gotta do something..."
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "I've gotta hurry..."
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "They're gonna execute Ace!"
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "Yes, we must act quickly!"
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "Jinbe!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "I've got..."
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "a favor to ask!"
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "You sure are persistent..."
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "He's already half-dead! Finish him off!"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "Oh, don't bother. I'll do it."
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "Kizaru-san!"
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "We need to get the execution over with, and fast."
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "At times like this, it's best to just pierce them right through the head..."
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "Ocean Current Shoulder Throw!{\\fad(150,150)}"
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "Lu-"
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "Luffy!"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "Oh, my. You finally made it here."
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "Quite an entrance, son of Dragon."
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "This youngster sure is scary..."
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "Ace's little brother just went straight over the wall!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "That kid..."
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "If nothing else, I praise your tenacity."
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "But you're not ready for this stage yet."
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "There's no way you can beat us, you know?"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "Give Ace..."
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "back!"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "He's just as reckless as his brother."
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "Oars! Stay where you are."
 },
 {
  "i": 118,
  "style": "Main",
  "name": "",
  "text": "We'll need your strength."
 },
 {
  "i": 119,
  "style": "Main",
  "name": "",
  "text": "Pops..."
 },
 {
  "i": 120,
  "style": "Main",
  "name": "",
  "text": "Jozu! Time for our trump card!"
 },
 {
  "i": 121,
  "style": "Main",
  "name": "",
  "text": "Sure!"
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "All men, prepare yourselves!"
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "We're breaking into the plaza!"
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "Rubber-Rubber...{\\fad(150,150)}"
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "Stamp Gatling!{\\fad(150,150)}"
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Gear Second!{\\fad(150,150)}"
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "I don't have time to fight these guys!"
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "How cunning of him."
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "Too slow."
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "On my mark!"
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "Yes sir!"
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "Do it!"
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "Ace!!"
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "Who was that?!"
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "Bastard!"
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "Considering your old grudge against Whitebeard, I had thought we were lucky..."
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "Crocodile!"
 },
 {
  "i": 138,
  "style": "Main",
  "name": "",
  "text": "Him!"
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "Huh... it wasn't my turn yet?"
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "You were hell-bent on killing the Pops.\\N What's this sudden change of heart?"
 },
 {
  "i": 141,
  "style": "Main",
  "name": "",
  "text": "That dying old man?"
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "I'll eliminate him later."
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "But right now..."
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "I don't want to see you enjoying victory!"
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "Hey now, Crocodile-man!"
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "D-Doflamingo!"
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "So you're ditching me to team up with Whitebeard?"
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "It's enough to make a guy jealous, ya know..."
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "I don't team up with anybody."
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "That's the same as brushing me off."
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "More or less."
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "I don't get what's going on... but we were saved."
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "End of the line, Straw Hat!"
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "Die!"
 },
 {
  "i": 155,
  "style": "Main",
  "name": "",
  "text": "Get out of..."
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "my way!"
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "Stop right there, Straw Hat!"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "I will not let you go any further!"
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "Move it!"
 },
 {
  "i": 160,
  "style": "Secondary",
  "name": "",
  "text": "Shave!{\\fad(150,150)}"
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "Moon Walk!{\\fad(150,150)}"
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "Iron Body...{\\fad(150,150)}"
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "Smash!{\\fad(150,150)}"
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "Rubber-Rubber...{\\fad(150,150)}"
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "Iron Body!{\\fad(150,150)}"
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "Bullet!{\\fad(150,150)}"
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "Stop Straw Hat!"
 },
 {
  "i": 168,
  "style": "Main",
  "name": "",
  "text": "Don't let him get any closer!"
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "Admiral Sakazuki!"
 },
 {
  "i": 170,
  "style": "Main",
  "name": "",
  "text": "That hurts!"
 },
 {
  "i": 171,
  "style": "Main",
  "name": "",
  "text": "Damn it!"
 },
 {
  "i": 172,
  "style": "Main",
  "name": "",
  "text": "I'm indebted to your granddad, but..."
 },
 {
  "i": 173,
  "style": "Main",
  "name": "",
  "text": "I have no choice!"
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "You have chosen your own death!"
 },
 {
  "i": 175,
  "style": "Main",
  "name": "",
  "text": "You! Do not lay a hand on Luffy!"
 },
 {
  "i": 176,
  "style": "Main",
  "name": "",
  "text": "Admiral!"
 },
 {
  "i": 177,
  "style": "Main",
  "name": "",
  "text": "That's..."
 },
 {
  "i": 178,
  "style": "Main",
  "name": "",
  "text": "The Commander of the First Division... Marco!"
 },
 {
  "i": 179,
  "style": "Main",
  "name": "",
  "text": "Thanks for saving me."
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "Don't mention it."
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "Three people have penetrated the plaza!"
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "Devil Fruit users are passing over the walls!"
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "Cross the water and head for Oars!"
 },
 {
  "i": 184,
  "style": "Main",
  "name": "",
  "text": "Whatever happens, get to the plaza!"
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "The pirates are getting desperate."
 },
 {
  "i": 186,
  "style": "Main",
  "name": "",
  "text": "Defend the gap in the walls!"
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "Yes sir!"
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "Even after losing their ships and their footing, they're still as frenzied as ever."
 },
 {
  "i": 189,
  "style": "Main",
  "name": "",
  "text": "Foolish pirates."
 },
 {
  "i": 190,
  "style": "Main",
  "name": "",
  "text": "They're sitting ducks! Fire!"
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "Everyone, get on board!"
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "Yeah!"
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "Hold on tight!"
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "No way! A ship..."
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "Big trouble!"
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "Another coated ship has emerged from the bay!"
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "Damn it!"
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "It was hiding underwater the whole time!"
 },
 {
  "i": 199,
  "style": "Main",
  "name": "",
  "text": "I don't remember saying that we'd used all of our ships!"
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "It's a paddle ship!"
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "It's going to ram us!"
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "What?!"
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "Sink it! Just like the Moby Dick!"
 },
 {
  "i": 204,
  "style": "Main",
  "name": "",
  "text": "No, not the ship!"
 },
 {
  "i": 205,
  "style": "Main",
  "name": "",
  "text": "Shoot Oars!"
 },
 {
  "i": 206,
  "style": "Main",
  "name": "",
  "text": "Huh? Oars?"
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "Too late!"
 },
 {
  "i": 208,
  "style": "Main",
  "name": "",
  "text": "Here we go, everyone!"
 },
 {
  "i": 209,
  "style": "Main",
  "name": "",
  "text": "H-He pulled the whole ship in!"
 },
 {
  "i": 210,
  "style": "Main",
  "name": "",
  "text": "The intruders have breached the walls!"
 },
 {
  "i": 211,
  "style": "Main",
  "name": "",
  "text": "We're in the plaza!"
 },
 {
  "i": 212,
  "style": "Main",
  "name": "",
  "text": "Let's save Ace!"
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "Time to overthrow Navy HQ!"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "Hang in there, Ace!"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "They got us."
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "There was one tiny mouse hole in the walls, and they swarmed right in."
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "Those walls may wind up working against us."
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "Whitebeard..."
 },
 {
  "i": 220,
  "style": "Main",
  "name": "",
  "text": "Still got your head, Ace?"
 },
 {
  "i": 221,
  "style": "Main",
  "name": "",
  "text": "We made it!"
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "Now Ace{\\i1}-kun{\\i0} can be resc-"
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "Oars!"
 },
 {
  "i": 224,
  "style": "Main",
  "name": "",
  "text": "Save... Ace{\\i1}-kun{\\i0}..."
 },
 {
  "i": 225,
  "style": "Main",
  "name": "",
  "text": "Oars..."
 },
 {
  "i": 226,
  "style": "Main",
  "name": "",
  "text": "Whitebeard has entered the plaza!"
 },
 {
  "i": 227,
  "style": "Main",
  "name": "",
  "text": "Stand back, my sons."
 },
 {
  "i": 228,
  "style": "Main",
  "name": "",
  "text": "Men!"
 },
 {
  "i": 229,
  "style": "Main",
  "name": "",
  "text": "Rescue Ace, and destroy the Navy!"
 },
 {
  "i": 230,
  "style": "Main",
  "name": "",
  "text": "Garp..."
 },
 {
  "i": 231,
  "style": "Main",
  "name": "",
  "text": "Yeah."
 },
 {
  "i": 232,
  "style": "Main",
  "name": "",
  "text": "It looks like even we have to take a hand in this!"
 }
]