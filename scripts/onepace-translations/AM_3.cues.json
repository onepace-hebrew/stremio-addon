 },
 {
  "i": 10,
  "style": "OP11 Credits",
  "name": "",
  "text": "{\\pos(1050,460)}Edit-checking\\NGalaxy 9000"
 },
 {
  "i": 11,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "It begins, it expands, this flavor that exceeds imagination"
 },
 {
  "i": 12,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "I feel so good throughout my body, I will become free, oh yeah"
 },
 {
  "i": 13,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "Share the music, even if it's far."
 },
 {
  "i": 14,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "Share the one dream, by telling each other."
 },
 {
  "i": 15,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "Share the good times and laugh."
 },
 {
  "i": 16,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "I'll keep going until I can reach the sky."
 },
 {
  "i": 17,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "Let's overcome it now, I believe in the next tomorrow yeah yeah..."
 },
 {
  "i": 18,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "You were waiting there on the other side of the invisible wall."
 },
 {
  "i": 19,
  "style": "OP11 Lyrics",
  "name": "",
  "text": "I'll be there soon, I believe in one world yeah yeah..."
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "Big Sis!"
 },
 {
  "i": 21,
  "style": "Main",
  "name": "",
  "text": "Big Sis! What happened?!"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "Who is that? A man?!"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "What is a man doing in this land?!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "What in the world happened?!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "Oh I uhh..."
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "He saw my back."
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "Then he'll have to die."
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "Huh?! H-How come?! I only saw her back!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "I dunno why, but I could swear I've seen it somewhere before..."
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "We would rather die than let anyone see what you saw on my back!"
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "That thing? How come?"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "Who are you? How come?"
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "Take everything you saw to the grave!"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Love-Love Beam!"
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "Huh? Slow-Slow?!"
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "A Slow-Slow Beam?!"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "Oh no!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "I'm turning slower! Slow...er..."
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Love-Love Beam!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "Why won't he petrify?!"
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "Does he not feel any excitement\\Nfrom seeing me in the bath?!"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "That's not possible, Big Sis!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "The beauty of your naked body would\\Ncharm anyone of any age or gender!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "His fear of death must be\\Noverpowering his wicked thoughts!"
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "He's a pathetic yet lucky man!"
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "I dunno what's going on\\Nbut I'm getting outta here!"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "I just wanna talk to someone important!"
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "He jumped out from this height!"
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "He won't get away!"
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Pistol Kiss!"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "Huh?! They don't bounce off!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "They're not metal bullets?!"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "That man is an intruder!"
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "Seize him, Kuja Pirates!"
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "Y-Yes, ma'am!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "A man?! What's a man doing here?!"
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "Let's just catch him for now!"
 },
 {
  "i": 58,
  "style": "Title",
  "name": "",
  "text": "{\\fad(317,0)}The Arena"
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "Damn! Come off, you stupid things!"
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "What are these iron rope-like snakes?!"
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "We were too slow."
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "Let's just hope they don't\\Nask how he arrived here..."
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "He's going to be killed, isn't he?"
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "What's with this place?"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "There really isn't even one guy here."
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "Snake Princess!"
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "Marigold-sama!"
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "Sandersonia-sama!"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "Let me ask you this, man."
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "How and why did you come to this island?!"
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "Seriously, I don't know either!"
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "I suddenly went flying through the sky and before I realized it I was here!"
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "Liar. You can't fool me with that ridiculous story."
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "You must be after something."
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "Well, you could give me a ship!"
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "I'd appreciate getting a lift most of all,"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "but anyway there's a place\\NI need to leave for right away!"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "If you're the most important person here, then please! I want to set sail!"
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "What nonsense is this?!"
 },
 {
  "i": 80,
  "style": "Main",
  "name": "",
  "text": "He must be plotting something!"
 },
 {
  "i": 81,
  "style": "Main",
  "name": "",
  "text": "You can't fool us!"
 },
 {
  "i": 82,
  "style": "Flashbacks",
  "name": "",
  "text": "I can keep fighting again and again!"
 },
 {
  "i": 83,
  "style": "Main",
  "name": "",
  "text": "How dare he speak so rudely and\\Ntastelessly to the Snake Princess?!"
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "He's appalling!"
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "Don't think you can leave this place alive."
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "Your death is inescapable!"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "Please wait Snake Princess!"
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "I-I don't think he's the\\Nkind of person who can lie!"
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "Marguerite!"
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "Snake Princess."
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "E-Everything this man says is sincere."
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "He hardly seems like the type\\Nto bring harm to our land!"
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "Oh! You!"
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "Yeah! Tell her for me!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "A defense warrior?"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "My name is Marguerite!"
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "The punishment of the crime of intruding into this kingdom,"
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "which is forbidden to men, is death."
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "Why are you defending him?"
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "I feel I owe him."
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "The person who let him into this country..."
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "...was I!"
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "Marguerite! Why?!"
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "Snake Princess! W-We can explain!"
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "Yes!"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "We found him in the forest\\Ncovered in mushrooms!"
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "We thought he was from the village\\Nand carried him here!"
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "Sweet Pea! Aphelandra!"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "We're also responsible for\\Nthe crime of bringing him here!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "That's right!"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "Stop you two!"
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "I'm the one who suggested\\Nbringing him to the village!"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "Does she know what this means?"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "Marguerite is way too honest!"
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "Oh you guys!"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "You guys tried to kill me\\Nbut you're actually nice after all!"
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "Only I'm guilty of letting\\Nhim into the country!"
 },
 {
  "i": 118,
  "style": "Main",
  "name": "",
  "text": "Marguerite!"
 },
 {
  "i": 119,
  "style": "Main",
  "name": "",
  "text": "It's all right."
 },
 {
  "i": 120,
  "style": "Main",
  "name": "",
  "text": "Look up, honest Marguerite."
 },
 {
  "i": 121,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Love-Love Beam!"
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "What the...?!"
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "They did something stupid."
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "Hey, what happened to you?!"
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "What happened?!"
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "They turned into stone! Why?!"
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "Hey, what did you do to them!?"
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "They saved my life!"
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "Yes, they have been punished for helping you."
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "Because of me!?"
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "Wait! Turn them back to normal!"
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "Bring Bacura to the arena!"
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "Bacura!?"
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "It's all over for that man now!"
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "I told you to turn them back!"
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "This place is the kingdom of the warriors, Amazon Lily,"
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "where if you are powerful, you are beautiful."
 },
 {
  "i": 138,
  "style": "Main",
  "name": "",
  "text": "You should die fighting."
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "We are gonna watch it."
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "That black panther's name is Bacura."
 },
 {
  "i": 141,
  "style": "Main",
  "name": "",
  "text": "It is a carnivorous animal that was used as an executioner"
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "by the empress of this kingdom for many generations."
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "After the execution, not even a single bone will remain."
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "What's gonna happen to these people?! Are they gonna turn back to normal?!"
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "What a disrespectful way of speaking to the Snake Princess!"
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "Go finish him, Bacura!"
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "Bacura!"
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "He's strong!"
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "Bacura was defeated by a single hit?!"
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "He didn't use Haki!"
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "Then that was just brute strength?!"
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "You guys are screwed up."
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "That woman..."
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "Even after your comrades have been turned to stone by that woman,"
 },
 {
  "i": 155,
  "style": "Main",
  "name": "",
  "text": "why are you still laughing childishly?!"
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "The savage is shouting at us!"
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "Unbelievable! What a vicious creature!"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "We feel sorry for those three, but what Snake Princess did wasn't wrong!"
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "They're the ones to blame!\\NThey broke the rules of our land!"
 },
 {
  "i": 160,
  "style": "Main",
  "name": "",
  "text": "Whatever I do..."
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "...I will be forgiven."
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "If you ask why..."
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "Indeed..."
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "It's because I'm beautiful!"
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "Snake Princess!"
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "You think so, too, right?"
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "You're pissin' me off."
 },
 {
  "i": 168,
  "style": "Main",
  "name": "",
  "text": "Sister, get a hold of yourself!"
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "This is just ridiculous!"
 },
 {
  "i": 170,
  "style": "Main",
  "name": "",
  "text": "There can't possibly exist a man that can't be captured by my charm!"
 },
 {
  "i": 171,
  "style": "Main",
  "name": "",
  "text": "I can't bear that man's existence!"
 },
 {
  "i": 172,
  "style": "Main",
  "name": "",
  "text": "How dare you say that to the Snake Princess?!"
 },
 {
  "i": 173,
  "style": "Main",
  "name": "",
  "text": "Hurry and execute him!"
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "Execution!"
 },
 {
  "i": 175,
  "style": "Main",
  "name": "",
  "text": "Execution! Execution!"
 },
 {
  "i": 176,
  "style": "Main",
  "name": "",
  "text": "Go! Marigold! Sandersonia!"
 },
 {
  "i": 177,
  "style": "Main",
  "name": "",
  "text": "Take that man's head!"
 },
 {
  "i": 178,
  "style": "Main",
  "name": "",
  "text": "Yes! Leave it to us Big Sis!"
 },
 {
  "i": 179,
  "style": "Main",
  "name": "",
  "text": "These guys use devil-fruit powers, too?"
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "Execution!"
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "Execution!"
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "The younger sisters'\\NSnake Pit Dance is about to start!"
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "{\\an8}I can't wait to see Marigold-sama's\\N\"Salamander\" with my own eyes!"
 },
 {
  "i": 184,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(1000,0)}Youngest Sister Marigold Snake-Snake\\NFruit Model King Cobra"
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "{\\an8}And Sandersonia-sama's\\N\"Eight-Headed Serpent\"!"
 },
 {
  "i": 186,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(1000,0)\\pos(317,630)}Middle Sister Sandersonia\\NSnake-Snake Fruit Model Anaconda"
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "How magnificent she looks!"
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "This is proof that they defeated\\Nthe monster, Gorgon, and took its powers!"
 },
 {
  "i": 189,
  "style": "Main",
  "name": "",
  "text": "Even after they were cursed, the sisters are still beautiful!"
 },
 {
  "i": 190,
  "style": "Main",
  "name": "",
  "text": "Cursed?"
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "What are they talking about?"
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "No matter how you look at it, you just ate a Devil Fruit!"
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "Execution! Execution!"
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "Execution!..."
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "Perhaps I should swallow him whole..."
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "Or squeeze him to death..."
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "Don't tell me he's scared stiff!"
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "Just stand there and die!"
 },
 {
  "i": 199,
  "style": "Main",
  "name": "",
  "text": "There!"
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "They don't have any cracks, right?"
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "You three wait here."
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "Sorry about this. Because of me you guys turned into stone."
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "If Chopper was here, I'd ask him to check on you right away."
 },
 {
  "i": 204,
  "style": "Main",
  "name": "",
  "text": "It's just like when Robin and I were turned into ice by Aokiji."
 },
 {
  "i": 205,
  "style": "Main",
  "name": "",
  "text": "You guys might be able to turn back to normal."
 },
 {
  "i": 206,
  "style": "Main",
  "name": "",
  "text": "Shouldn't you be more concerned about your own safety instead of theirs?"
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "Shut up! I can do whatever I want!"
 },
 {
  "i": 208,
  "style": "Main",
  "name": "",
  "text": "That man..."
 },
 {
  "i": 209,
  "style": "Main",
  "name": "",
  "text": "Is he trying to save Marguerite and the others?"
 },
 {
  "i": 210,
  "style": "Main",
  "name": "",
  "text": "That can't be!"
 },
 {
  "i": 211,
  "style": "Main",
  "name": "",
  "text": "He's already been sentenced to death!"
 },
 {
  "i": 212,
  "style": "Main",
  "name": "",
  "text": "Well then..."
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "Anyway, I just gotta beat you guys up, right?"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "No way!"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "What did that boy just say?"
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "He thinks he can beat the sisters up?"
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "Hilarious! Making people laugh\\Nafter being sentenced to death!"
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "Men really are hilarious!"
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "I can do that, right? Beat you up, I mean."
 },
 {
  "i": 220,
  "style": "Main",
  "name": "",
  "text": "Yeah, sure you can."
 },
 {
  "i": 221,
  "style": "Main",
  "name": "",
  "text": "If you haven't given up on your life yet, let me tell you something."
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "I wouldn't fall into the pit between\\Nthe seats and the ring if I were you!"
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "I don't mind if it happens, but if you fall, you will be stabbed by the spikes below."
 },
 {
  "i": 224,
  "style": "Main",
  "name": "",
  "text": "Then, let's start."
 },
 {
  "i": 225,
  "style": "Main",
  "name": "",
  "text": "Kill him, Sandersonia, Marigold!"
 },
 {
  "i": 226,
  "style": "Main",
  "name": "",
  "text": "For the crime of intruding on this island of women!"
 },
 {
  "i": 227,
  "style": "Main",
  "name": "",
  "text": "For the sin of insulting me,"
 },
 {
  "i": 228,
  "style": "Main",
  "name": "",
  "text": "show him the art of the punishment!"
 },
 {
  "i": 229,
  "style": "Main",
  "name": "",
  "text": "I've been waiting for this!"
 },
 {
  "i": 230,
  "style": "Main",
  "name": "",
  "text": "Take that, and that, and that!"
 },
 {
  "i": 231,
  "style": "Thoughts",
  "name": "",
  "text": "He's not bad at this huh?"
 },
 {
  "i": 232,
  "style": "Main",
  "name": "",
  "text": "Get him Marigold-sama!"
 },
 {
  "i": 233,
  "style": "Main",
  "name": "",
  "text": "What the...?!"
 },
 {
  "i": 234,
  "style": "Main",
  "name": "",
  "text": "Poison?! That was close!"
 },
 {
  "i": 235,
  "style": "Main",
  "name": "",
  "text": "It's a deadly poison! Too bad for you!"
 },
 {
  "i": 236,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Rubber..."
 },
 {
  "i": 237,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Stamp!"
 },
 {
  "i": 238,
  "style": "Main",
  "name": "",
  "text": "It bounced off!"
 },
 {
  "i": 239,
  "style": "Main",
  "name": "",
  "text": "That hurts!"
 },
 {
  "i": 240,
  "style": "Main",
  "name": "",
  "text": "How...?! I'm made of rubber!"
 },
 {
  "i": 241,
  "style": "Main",
  "name": "",
  "text": "See! He really is all bark and no bite!"
 },
 {
  "i": 242,
  "style": "Main",
  "name": "",
  "text": "But it's true that men stretch! Interesting!"
 },
 {
  "i": 243,
  "style": "Main",
  "name": "",
  "text": "Huh?! Am I not rubber anymore?!"
 },
 {
  "i": 244,
  "style": "Main",
  "name": "",
  "text": "No that's not it!"
 },
 {
  "i": 245,
  "style": "Main",
  "name": "",
  "text": "Then why do impact blows hurt?!"
 },
 {
  "i": 246,
  "style": "Main",
  "name": "",
  "text": "That's unfair."
 },
 {
  "i": 247,
  "style": "Main",
  "name": "",
  "text": "Don't hog all the fun yourself, Mari."
 },
 {
  "i": 248,
  "style": "Main",
  "name": "",
  "text": "I want to have some fun with him too!"
 },
 {
  "i": 249,
  "style": "Main",
  "name": "",
  "text": "Why does that hurt?! I'm made of rubber!"
 },
 {
  "i": 250,
  "style": "Main",
  "name": "",
  "text": "The guy with the battle-axe was like that, too..."
 },
 {
  "i": 251,
  "style": "Main",
  "name": "",
  "text": "Does that mean it's not a Devil Fruit power?"
 },
 {
  "i": 252,
  "style": "Main",
  "name": "",
  "text": "I take it you have powers too."
 },
 {
  "i": 253,
  "style": "Main",
  "name": "",
  "text": "Damn!"
 },
 {
  "i": 254,
  "style": "Main",
  "name": "",
  "text": "But I take it you can't use Haki?"
 },
 {
  "i": 255,
  "style": "Main",
  "name": "",
  "text": "Most outsiders can't."
 },
 {
  "i": 256,
  "style": "Main",
  "name": "",
  "text": "That's why you're weak."
 },
 {
  "i": 257,
  "style": "Main",
  "name": "",
  "text": "A kick with the left foot."
 },
 {
  "i": 258,
  "style": "Main",
  "name": "",
  "text": "Over here!"
 },
 {
  "i": 259,
  "style": "Main",
  "name": "",
  "text": "She predicted my move!"
 },
 {
  "i": 260,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Snake Slam!"
 },
 {
  "i": 261,
  "style": "Main",
  "name": "",
  "text": "Yes!"
 },
 {
  "i": 262,
  "style": "Main",
  "name": "",
  "text": "That one didn't hurt."
 },
 {
  "i": 263,
  "style": "Main",
  "name": "",
  "text": "Same as usual."
 },
 {
  "i": 264,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Rubber..."
 },
 {
  "i": 265,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Gatling!"
 },
 {
  "i": 266,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Snake Dance!"
 },
 {
  "i": 267,
  "style": "Main",
  "name": "",
  "text": "What amazing moves!"
 },
 {
  "i": 268,
  "style": "Main",
  "name": "",
  "text": "With Sonia-sama's Haki\\Nthere's no attack she can't dodge!"
 },
 {
  "i": 269,
  "style": "Main",
  "name": "",
  "text": "You're very straightforward."
 },
 {
  "i": 270,
  "style": "Main",
  "name": "",
  "text": "I can read you like a book."
 },
 {
  "i": 271,
  "style": "Main",
  "name": "",
  "text": "What's going on?!"
 },
 {
  "i": 272,
  "style": "Main",
  "name": "",
  "text": "She's guessing my every move!"
 },
 {
  "i": 273,
  "style": "Main",
  "name": "",
  "text": "Focusing entirely on offense\\Nis nice and all but..."
 },
 {
  "i": 274,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Snake Stick!"
 },
 {
  "i": 275,
  "style": "Main",
  "name": "",
  "text": "Ouch!"
 },
 {
  "i": 276,
  "style": "Main",
  "name": "",
  "text": "Don't forget that there are two of us!"
 },
 {
  "i": 277,
  "style": "Main",
  "name": "",
  "text": "He's falling into the pit!"
 },
 {
  "i": 278,
  "style": "Main",
  "name": "",
  "text": "That was close!"
 },
 {
  "i": 279,
  "style": "Main",
  "name": "",
  "text": "The Snake Princess put\\Nher hair behind her ear!"
 },
 {
  "i": 280,
  "style": "Main",
  "name": "",
  "text": "Her loveliness knows no bounds!"
 },
 {
  "i": 281,
  "style": "Main",
  "name": "",
  "text": "This man is the very definition\\Nof \"nothing but talk.\""
 },
 {
  "i": 282,
  "style": "Main",
  "name": "",
  "text": "I can't help but laugh."
 },
 {
  "i": 283,
  "style": "Main",
  "name": "",
  "text": "Shut up you dumbass!"
 },
 {
  "i": 284,
  "style": "Main",
  "name": "",
  "text": "Oh my!"
 },
 {
  "i": 285,
  "style": "Main",
  "name": "",
  "text": "He spoke abusively to\\Nthe Snake Princess again!"
 },
 {
  "i": 286,
  "style": "Main",
  "name": "",
  "text": "Unforgivable! Hurry and kill him!"
 },
 {
  "i": 287,
  "style": "Main",
  "name": "",
  "text": "Sonia! Mari!"
 },
 {
  "i": 288,
  "style": "Main",
  "name": "",
  "text": "End that man's life at once!"
 },
 {
  "i": 289,
  "style": "Main",
  "name": "",
  "text": "To ensure there are no further outbursts..."
 },
 {
  "i": 290,
  "style": "Main",
  "name": "",
  "text": "from his filthy mouth!"
 },
 {
  "i": 291,
  "style": "Main",
  "name": "",
  "text": "It looks like playtime is over now."
 },
 {
  "i": 292,
  "style": "Main",
  "name": "",
  "text": "Let's give the criminal despair and death!"
 },
 {
  "i": 293,
  "style": "Main",
  "name": "",
  "text": "Hey! What're you doing?! Don't touch them!"
 },
 {
  "i": 294,
  "style": "Main",
  "name": "",
  "text": "What if she breaks?!"
 },
 {
  "i": 295,
  "style": "Main",
  "name": "",
  "text": "She saved my life you know!"
 },
 {
  "i": 296,
  "style": "Main",
  "name": "",
  "text": "We are going to break her."
 },
 {
  "i": 297,
  "style": "Main",
  "name": "",
  "text": "You said she saved your life."
 },
 {
  "i": 298,
  "style": "Main",
  "name": "",
  "text": "Then that's all the more reason to."
 },
 {
  "i": 299,
  "style": "Main",
  "name": "",
  "text": "I feel bad for her, but this is your punishment."
 },
 {
  "i": 300,
  "style": "Main",
  "name": "",
  "text": "Don't be stupid!"
 },
 {
  "i": 301,
  "style": "Main",
  "name": "",
  "text": "This duel is between me and you!"
 },
 {
  "i": 302,
  "style": "Main",
  "name": "",
  "text": "Damn! Let go!"
 },
 {
  "i": 303,
  "style": "Main",
  "name": "",
  "text": "You're the only one who\\Nthinks this is a duel."
 },
 {
  "i": 304,
  "style": "Main",
  "name": "",
  "text": "This is a public execution!"
 },
 {
  "i": 305,
  "style": "Main",
  "name": "",
  "text": "Just sit there and watch!"
 },
 {
  "i": 306,
  "style": "Main",
  "name": "",
  "text": "The emotional trauma you gave our\\Nsister goes much further than this!"
 },
 {
  "i": 307,
  "style": "Flashbacks",
  "name": "",
  "text": "Everyone here looks up to the Snake Princess!"
 },
 {
  "i": 308,
  "style": "Flashbacks",
  "name": "",
  "text": "She's strong noble and the most\\Nbeautiful woman in the world!"
 },
 {
  "i": 309,
  "style": "Flashbacks",
  "name": "",
  "text": "The Pirate Empress Boa Hancock!"
 },
 {
  "i": 310,
  "style": "Main",
  "name": "",
  "text": "Hey! Stop it!"
 },
 {
  "i": 311,
  "style": "Main",
  "name": "",
  "text": "She looked up to you guys you know!"
 },
 {
  "i": 312,
  "style": "Main",
  "name": "",
  "text": "Everyone in this land does."
 },
 {
  "i": 313,
  "style": "Main",
  "name": "",
  "text": "So I think this is what she would want!"
 },
 {
  "i": 314,
  "style": "Main",
  "name": "",
  "text": "The hell it is!"
 },
 {
  "i": 315,
  "style": "Main",
  "name": "",
  "text": "What are you stupid?!"
 },
 {
  "i": 316,
  "style": "Main",
  "name": "",
  "text": "Oh my. What crude language."
 },
 {
  "i": 317,
  "style": "Main",
  "name": "",
  "text": "Here goes!"
 },
 {
  "i": 318,
  "style": "Main",
  "name": "",
  "text": "Three..."
 },
 {
  "i": 319,
  "style": "Main",
  "name": "",
  "text": "Hey! Stop!"
 },
 {
  "i": 320,
  "style": "Main",
  "name": "",
  "text": "Two..."
 },
 {
  "i": 321,
  "style": "Main",
  "name": "",
  "text": "It's no use."
 },
 {
  "i": 322,
  "style": "Main",
  "name": "",
  "text": "One..."
 },
 {
  "i": 323,
  "style": "Main",
  "name": "",
  "text": "Marguerite!"
 },
 {
  "i": 324,
  "style": "Main",
  "name": "",
  "text": "I told you to stop, dammit!!"
 },
 {
  "i": 325,
  "style": "Main",
  "name": "",
  "text": "The warriors are fainting!"
 },
 {
  "i": 326,
  "style": "Main",
  "name": "",
  "text": "There's no way..."
 },
 {
  "i": 327,
  "style": "Main",
  "name": "",
  "text": "What a relief!"
 },
 {
  "i": 328,
  "style": "Main",
  "name": "",
  "text": "She isn't hurt anywhere!"
 },
 {
  "i": 329,
  "style": "Main",
  "name": "",
  "text": "Oh I guess you guys are sensible after all!"
 },
 {
  "i": 330,
  "style": "Main",
  "name": "",
  "text": "Just now... that was the Conqueror's Haki!"
 },
 {
  "i": 331,
  "style": "Main",
  "name": "",
  "text": "This can't be real!"
 },
 {
  "i": 332,
  "style": "Main",
  "name": "",
  "text": "Only one in a million people is capable of using the Haki of the chosen ones."
 },
 {
  "i": 333,
  "style": "Thoughts",
  "name": "",
  "text": "I've never seen any person who\\Ncan use it other than our big sister!"
 },
 {
  "i": 334,
  "style": "Thoughts",
  "name": "",
  "text": "This boy has the qualities of a king,\\Ncapable of standing above all others!"
 },
 {
  "i": 335,
  "style": "Main",
  "name": "",
  "text": "He has the Conqueror's Haki just like me?"
 },
 {
  "i": 336,
  "style": "Main",
  "name": "",
  "text": "How can this be?!"
 },
 {
  "i": 337,
  "style": "Main",
  "name": "",
  "text": "Is he no mere boy after all?!"
 },
 {
  "i": 338,
  "style": "Main",
  "name": "",
  "text": "Just who is that guy?!"
 },
 {
  "i": 339,
  "style": "Main",
  "name": "",
  "text": "What's everyone blabbing about?"
 },
 {
  "i": 340,
  "style": "Main",
  "name": "",
  "text": "What's the big deal?"
 },
 {
  "i": 341,
  "style": "Main",
  "name": "",
  "text": "He doesn't realize he used Haki?!"
 },
 {
  "i": 342,
  "style": "Main",
  "name": "",
  "text": "I guess he hasn't figured\\Nout how to control it."
 },
 {
  "i": 343,
  "style": "Main",
  "name": "",
  "text": "Alright!"
 },
 {
  "i": 344,
  "style": "Main",
  "name": "",
  "text": "You showed me you're strong!"
 },
 {
  "i": 345,
  "style": "Main",
  "name": "",
  "text": "Now let's get on with the duel."
 }
]