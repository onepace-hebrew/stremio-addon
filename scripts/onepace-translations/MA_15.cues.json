[
 {
  "i": 0,
  "style": "Title",
  "name": "",
  "text": "{\\fad(1250,1250)}Edward Newgate"
 },
 {
  "i": 1,
  "style": "Main",
  "name": "",
  "text": "You got to be kidding me!"
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "Ace...!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "Fire Fist Ace is dead!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "Straw Hat-boy!"
 },
 {
  "i": 7,
  "style": "Thoughts",
  "name": "",
  "text": "He's losing it!"
 },
 {
  "i": 8,
  "style": "Thoughts",
  "name": "",
  "text": "His life is in danger!"
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "It's Akainu!"
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "I'll get you this time for sure!"
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "Straw Hat!"
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "I'm not gonna let you kill him!"
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "Luffy{\\i1}-kun{\\i0}! Luffy{\\i1}-kun{\\i0}! Stay with me!"
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "Move out of my way!"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "This war is not over yet!"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "Take Ace's brother with you, Jinbe!"
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "All right!"
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "Straw Hat's life is how\\NAce's life will live on!"
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "Commander... Marco!"
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "We will protect him at any\\Ncost on Ace's behalf!"
 },
 {
  "i": 21,
  "style": "Main",
  "name": "",
  "text": "If we let him die,"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "it'll be a dishonor to the Whitebeard Pirates!"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "Luffy{\\i1}-kun{\\i0}, don't lose your sanity!"
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "I told you that I won't\\Nlet the brothers get away!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "Straw Hat!"
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "Akainu{\\i1}-san{\\i0}!"
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "Pops is furious!"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "Guys, we gotta get out of here!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "Hellhound!{\\fad(150,150)}"
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "Navy HQ is collapsing!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "You bastard!"
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "Whitebeard!"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "Admiral Sakazuki!"
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "– Don't fall!\\N– Hang on!"
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "Is it over?"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "The plaza has split in two! The\\Npirates are on the other side!"
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "We are completely separated from Pops!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "He is still this powerful after his gut has been burnt through?"
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "I'm not done yet."
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "Everybody, get on the ships!"
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "Think about why Pops stayed over there and his last wish for us!"
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "Cry after you get on the ship!"
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "– Pops! Ace!\\N– Hurry up!"
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "Bring all able ships to the bay!"
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "We won't let you get away!"
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "Hurry up, everyone!"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "Salome! I can't stop worrying about Luffy!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "Hey, look! What is that?!"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "There is something behind the HQ building!"
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "Oh, they found me!"
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "Not only him! Who are they on the scaffold?"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "Oh... They noticed us finally."
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "It's you! How did you all get here?!"
 },
 {
  "i": 58,
  "style": "Main",
  "name": "",
  "text": "Why are they here?!"
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "You bastard."
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "They're the most heinous criminals"
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "whose existence has been erased\\Nbecause of their brutality!"
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "He's the biggest of all living things!"
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "The Pirate – \"Colossal Battleship\" Sanjuan Wolf!{\\an8}"
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "Oh, not only am I found,\\Nbut they know who I am!{\\an8}"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "\"Corrupt King\" Avalo Pizarro!{\\an8}"
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "I missed being back on the street!{\\an8}"
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "{\\an8}\"Heavy Drinker\" Vasco Shot!"
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "{\\an8}Am I allowed to kill them all?"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "{\\an8}\"Crescent Moon Hunter\" Catarina Devon!"
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "{\\an8}I like you boys, too."
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "{\\an8}And the Head Jailer of Impel Down..."
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "{\\an8}Shiryuu of the Rain!"
 },
 {
  "i": 73,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(800,0)}\"Colossal Battleship\" Sanjuan Wolf"
 },
 {
  "i": 74,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(800,0)}\"Corrupt King\" Avalo Pizarro"
 },
 {
  "i": 75,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(800,0)}\"Heavy Drinker\" Vasco Shot"
 },
 {
  "i": 76,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(940,0)}\"Crescent Moon Hunter\" Catarina Devon"
 },
 {
  "i": 77,
  "style": "Captions",
  "name": "",
  "text": "{\\fad(800,0)}Shiryuu of the Rain"
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "They're the Blackbeard Pirates!"
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "Long time no see! I'm glad to be\\Npresent at the time of your death!"
 },
 {
  "i": 80,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 81,
  "style": "Main",
  "name": "",
  "text": "Teach...!"
 },
 {
  "i": 82,
  "style": "Main",
  "name": "",
  "text": "Shiryuu! You..."
 },
 {
  "i": 83,
  "style": "Main",
  "name": "",
  "text": "What happened to Magellan? What happened to Impel Down?!"
 },
 {
  "i": 84,
  "style": "Main",
  "name": "",
  "text": "How did you all get here?!"
 },
 {
  "i": 85,
  "style": "Main",
  "name": "",
  "text": "Doesn't the fact that we {\\i1}are{\\i0} here answer your questions..."
 },
 {
  "i": 86,
  "style": "Main",
  "name": "",
  "text": "Fleet Admiral Sengoku{\\i1}-san{\\i0}?"
 },
 {
  "i": 87,
  "style": "Main",
  "name": "",
  "text": "If you want to know the details..."
 },
 {
  "i": 88,
  "style": "Main",
  "name": "",
  "text": "you can go find out for yourself later."
 },
 {
  "i": 89,
  "style": "Main",
  "name": "",
  "text": "At any rate, I've decided to team up with these guys."
 },
 {
  "i": 90,
  "style": "Main",
  "name": "",
  "text": "I bid you farewell."
 },
 {
  "i": 91,
  "style": "Main",
  "name": "",
  "text": "Fleet Admiral Sengoku!"
 },
 {
  "i": 92,
  "style": "Main",
  "name": "",
  "text": "I didn't have a chance to report this to you earlier..."
 },
 {
  "i": 93,
  "style": "Main",
  "name": "",
  "text": "But we received reports that the\\NGates of Justice had opened again..."
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "and an unauthorized warship passed through it!"
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "And these people were on that ship?"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "But there shouldn't be anyone in the control room except our marines..."
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "and nothing out of the ordinary has been reported, either!"
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "How did they get here?"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "I apologize."
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "It is quite simple."
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "Before the Blackbeard Pirates set sail for Impel Down,"
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "I hypnotized the marines in the control room..."
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "and gave them the order that all warships approaching the Gates of Justice..."
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "were to be allowed to pass."
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "It seems this helped some others as well."
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "For a pirate, an enemy of the Government..."
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "breaking into Impel Down would've been impossible, since the Gates of Justice would never open."
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "That's why I increased my reputation and became one of the Seven Warlords!"
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "But I don't need that rank any more!"
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "So your goal was to free those guys?"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "Indeed! That was my plan all along!"
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "That was all I wanted!"
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "Now do you get it?"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "None of that matters!"
 },
 {
  "i": 115,
  "style": "Main",
  "name": "",
  "text": "Teach!"
 },
 {
  "i": 116,
  "style": "Main",
  "name": "",
  "text": "Watch out, Captain!"
 },
 {
  "i": 117,
  "style": "Main",
  "name": "",
  "text": "That was really close!"
 },
 {
  "i": 118,
  "style": "Main",
  "name": "",
  "text": "We barely made it out in time."
 },
 {
  "i": 119,
  "style": "Main",
  "name": "",
  "text": "You aren't holding back!"
 },
 {
  "i": 120,
  "style": "Main",
  "name": "",
  "text": "Well, I guess that's to be expected."
 },
 {
  "i": 121,
  "style": "Main",
  "name": "",
  "text": "You're the one person I will never call my son, Teach."
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "You broke the one iron rule on my ship..."
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "You killed a member of the crew!"
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "So that the Fourth Division Commander Thatch may rest in peace..."
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "I will take this fool's life, and settle the score!"
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "Marco!"
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "Stay out of this!"
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "You got that?!"
 },
 {
  "i": 132,
  "style": "Main",
  "name": "",
  "text": "Let's settle this, Teach!"
 },
 {
  "i": 133,
  "style": "Main",
  "name": "",
  "text": "Fine by me!"
 },
 {
  "i": 134,
  "style": "Main",
  "name": "",
  "text": "What is that black stuff coming out of his body?"
 },
 {
  "i": 135,
  "style": "Main",
  "name": "",
  "text": "Smoke?"
 },
 {
  "i": 136,
  "style": "Main",
  "name": "",
  "text": "{\\fad(150,150)}Black Hole!"
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "This is the power of the Devil Fruit I stole after killing Thatch!"
 },
 {
  "i": 138,
  "style": "Main",
  "name": "",
  "text": "The mightiest power, the Dark-Dark Fruit!"
 },
 {
  "i": 139,
  "style": "Main",
  "name": "",
  "text": "Have a good taste!"
 },
 {
  "i": 140,
  "style": "Main",
  "name": "",
  "text": "Hey, Pops. Thatch is dead, and so is Ace."
 },
 {
  "i": 141,
  "style": "Main",
  "name": "",
  "text": "I had always respected and admired you from the bottom of my heart."
 },
 {
  "i": 142,
  "style": "Main",
  "name": "",
  "text": "But now, you've grown old."
 },
 {
  "i": 143,
  "style": "Main",
  "name": "",
  "text": "So rusty, you couldn't save a single underling from execution!"
 },
 {
  "i": 144,
  "style": "Main",
  "name": "",
  "text": "Even though I made sure to let Ace live after our battle on Banaro Island."
 },
 {
  "i": 145,
  "style": "Main",
  "name": "",
  "text": "That bastard..."
 },
 {
  "i": 146,
  "style": "Main",
  "name": "",
  "text": "Now, now... That won't work."
 },
 {
  "i": 147,
  "style": "Main",
  "name": "",
  "text": "All Devil Fruit abilities are useless against me!"
 },
 {
  "i": 148,
  "style": "Main",
  "name": "",
  "text": "Black Vortex!{\\fad(150,150)}"
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": "Well, Pops? What do you think about my darkness?"
 },
 {
  "i": 150,
  "style": "Main",
  "name": "",
  "text": "It can even suck in Devil Fruit powers, making the users defenseless!"
 },
 {
  "i": 151,
  "style": "Main",
  "name": "",
  "text": "In other words, you can't cause your earthquakes anym—"
 },
 {
  "i": 152,
  "style": "Main",
  "name": "",
  "text": "That hurts..."
 },
 {
  "i": 153,
  "style": "Main",
  "name": "",
  "text": "That hurts, damn it!"
 },
 {
  "i": 154,
  "style": "Main",
  "name": "",
  "text": "Overconfidence... Carelessness..."
 },
 {
  "i": 155,
  "style": "Main",
  "name": "",
  "text": "Those are your biggest weaknesses!"
 },
 {
  "i": 156,
  "style": "Main",
  "name": "",
  "text": "S-Stop it..."
 },
 {
  "i": 157,
  "style": "Main",
  "name": "",
  "text": "Pops, stop it! I'm your son, aren't I?"
 },
 {
  "i": 158,
  "style": "Main",
  "name": "",
  "text": "Are you really going to kill me?!"
 },
 {
  "i": 159,
  "style": "Main",
  "name": "",
  "text": "You did it, Pops!"
 },
 {
  "i": 160,
  "style": "Main",
  "name": "",
  "text": "No... Look at that!"
 },
 {
  "i": 161,
  "style": "Main",
  "name": "",
  "text": "Y-You monster!"
 },
 {
  "i": 162,
  "style": "Main",
  "name": "",
  "text": "You should be dead!"
 },
 {
  "i": 163,
  "style": "Main",
  "name": "",
  "text": "Can't you just die already?!"
 },
 {
  "i": 164,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 165,
  "style": "Main",
  "name": "",
  "text": "Kill him, you guys!"
 },
 {
  "i": 166,
  "style": "Main",
  "name": "",
  "text": "Do it! Turn him into a honeycomb!"
 },
 {
  "i": 167,
  "style": "Main",
  "name": "",
  "text": "Pops!"
 },
 {
  "i": 168,
  "style": "Flashbacks",
  "name": "",
  "text": "You're dying, you say, Roger?"
 },
 {
  "i": 169,
  "style": "Main",
  "name": "",
  "text": "Yeah. I don't have much time left."
 },
 {
  "i": 170,
  "style": "Main",
  "name": "",
  "text": "Shall I tell you how to get to Raftel, Whitebeard?"
 },
 {
  "i": 171,
  "style": "Main",
  "name": "",
  "text": "Even if you did, I wouldn't go. I'm not interested."
 },
 {
  "i": 172,
  "style": "Main",
  "name": "",
  "text": "Do you know what the Government calls me these days?"
 },
 {
  "i": 173,
  "style": "Main",
  "name": "",
  "text": "\"Gold Roger.\""
 },
 {
  "i": 174,
  "style": "Main",
  "name": "",
  "text": "What? Is that your real name?"
 },
 {
  "i": 175,
  "style": "Main",
  "name": "",
  "text": "No, it's not."
 },
 {
  "i": 176,
  "style": "Main",
  "name": "",
  "text": "My name is Gol D. Roger."
 },
 {
  "i": 177,
  "style": "Main",
  "name": "",
  "text": "I've met some of those guys\\Nwith \"D\" in their names myself."
 },
 {
  "i": 178,
  "style": "Main",
  "name": "",
  "text": "There's one in my crew too. His name is Teach."
 },
 {
  "i": 179,
  "style": "Main",
  "name": "",
  "text": "What's with that \"D\" anyway?"
 },
 {
  "i": 180,
  "style": "Main",
  "name": "",
  "text": "You want to know?"
 },
 {
  "i": 181,
  "style": "Main",
  "name": "",
  "text": "Alright, I'll tell you."
 },
 {
  "i": 182,
  "style": "Main",
  "name": "",
  "text": "It's a story from long ago..."
 },
 {
  "i": 183,
  "style": "Main",
  "name": "",
  "text": "I'm out of bullets.\\NHey, someone give me another gun!"
 },
 {
  "i": 184,
  "style": "Main",
  "name": "",
  "text": "It's not you..."
 },
 {
  "i": 185,
  "style": "Main",
  "name": "",
  "text": "You're still alive?!"
 },
 {
  "i": 186,
  "style": "Main",
  "name": "",
  "text": "The man Roger is waiting for..."
 },
 {
  "i": 187,
  "style": "Main",
  "name": "",
  "text": "at the very least, Teach..."
 },
 {
  "i": 188,
  "style": "Main",
  "name": "",
  "text": "it's definitely not you."
 },
 {
  "i": 189,
  "style": "Main",
  "name": "",
  "text": "Just like there are those who carry on Roger's will..."
 },
 {
  "i": 190,
  "style": "Main",
  "name": "",
  "text": "I'm sure someone will appear to carry on Ace's will, someday."
 },
 {
  "i": 191,
  "style": "Main",
  "name": "",
  "text": "Even if you extinguish his bloodline, there's no way that their flame will ever burn out."
 },
 {
  "i": 192,
  "style": "Main",
  "name": "",
  "text": "It has been passed down since ancient times..."
 },
 {
  "i": 193,
  "style": "Main",
  "name": "",
  "text": "And in the future... someday..."
 },
 {
  "i": 194,
  "style": "Main",
  "name": "",
  "text": "someone will appear, shouldering the\\Nburden of history for all those centuries,"
 },
 {
  "i": 195,
  "style": "Main",
  "name": "",
  "text": "and challenge the whole world to a fight."
 },
 {
  "i": 196,
  "style": "Main",
  "name": "",
  "text": "Sengoku..."
 },
 {
  "i": 197,
  "style": "Main",
  "name": "",
  "text": "You and the World Government..."
 },
 {
  "i": 198,
  "style": "Main",
  "name": "",
  "text": "all fear the coming war and the immense impact it will have worldwide."
 },
 {
  "i": 199,
  "style": "Main",
  "name": "",
  "text": "I don't care myself..."
 },
 {
  "i": 200,
  "style": "Main",
  "name": "",
  "text": "but as soon as someone finds that great treasure..."
 },
 {
  "i": 201,
  "style": "Main",
  "name": "",
  "text": "the entire world will be turned upside down."
 },
 {
  "i": 202,
  "style": "Main",
  "name": "",
  "text": "And someone will find it."
 },
 {
  "i": 203,
  "style": "Main",
  "name": "",
  "text": "That day will definitely come sooner or later."
 },
 {
  "i": 204,
  "style": "Main",
  "name": "",
  "text": "One Piece..."
 },
 {
  "i": 205,
  "style": "Main",
  "name": "",
  "text": "does exist!{YOOOOOOOOO}"
 },
 {
  "i": 206,
  "style": "Main",
  "name": "",
  "text": "Damn you!"
 },
 {
  "i": 207,
  "style": "Main",
  "name": "",
  "text": "Those are some magnificent last words!"
 },
 {
  "i": 208,
  "style": "Thoughts",
  "name": "",
  "text": "Forgive me... my sons..."
 },
 {
  "i": 209,
  "style": "Thoughts",
  "name": "",
  "text": "I'm responsible for one hell of a fool..."
 },
 {
  "i": 210,
  "style": "Thoughts",
  "name": "",
  "text": "But thanks to all of you, I had everything I ever wanted."
 },
 {
  "i": 211,
  "style": "Thoughts",
  "name": "",
  "text": "This is the end for me."
 },
 {
  "i": 212,
  "style": "Flashbacks",
  "name": "",
  "text": "Now, that's odd! A pirate who doesn't care about treasure?"
 },
 {
  "i": 213,
  "style": "Main",
  "name": "",
  "text": "What do you want, then?"
 },
 {
  "i": 214,
  "style": "Main",
  "name": "",
  "text": "Hey, Newgate!"
 },
 {
  "i": 215,
  "style": "Main",
  "name": "",
  "text": "There's one thing I've wanted, ever since I was a kid."
 },
 {
  "i": 216,
  "style": "Main",
  "name": "",
  "text": "Oh, there is?"
 },
 {
  "i": 217,
  "style": "Main",
  "name": "",
  "text": "Tell us!"
 },
 {
  "i": 218,
  "style": "Main",
  "name": "",
  "text": "A family."
 },
 {
  "i": 219,
  "style": "Main",
  "name": "",
  "text": "A family? What's that supposed to mean?"
 },
 {
  "i": 220,
  "style": "Thoughts",
  "name": "",
  "text": "I'm grateful to you."
 },
 {
  "i": 221,
  "style": "Thoughts",
  "name": "",
  "text": "Farewell, my sons."
 },
 {
  "i": 222,
  "style": "Main",
  "name": "",
  "text": "H-He died..."
 },
 {
  "i": 223,
  "style": "Main",
  "name": "",
  "text": "while still standing!"
 },
 {
  "i": 224,
  "style": "Narrator",
  "name": "",
  "text": "Whitebeard is dead."
 },
 {
  "i": 225,
  "style": "Narrator",
  "name": "",
  "text": "Even in death, his body did not fall."
 },
 {
  "i": 226,
  "style": "Narrator",
  "name": "",
  "text": "His body, striking down foes while riddled with wounds..."
 },
 {
  "i": 227,
  "style": "Narrator",
  "name": "",
  "text": "was truly monstrous."
 },
 {
  "i": 228,
  "style": "Narrator",
  "name": "",
  "text": "The total number of sword wounds he received in this battle..."
 },
 {
  "i": 229,
  "style": "Narrator",
  "name": "",
  "text": "was 267."
 },
 {
  "i": 230,
  "style": "Narrator",
  "name": "",
  "text": "He was shot by 152 bullets."
 },
 {
  "i": 231,
  "style": "Narrator",
  "name": "",
  "text": "And was hit by 46 cannonballs."
 },
 {
  "i": 232,
  "style": "Narrator",
  "name": "",
  "text": "And despite all this..."
 },
 {
  "i": 233,
  "style": "Narrator",
  "name": "",
  "text": "his proud back..."
 },
 {
  "i": 234,
  "style": "Narrator",
  "name": "",
  "text": "over the course of his entire life as a pirate..."
 },
 {
  "i": 235,
  "style": "Narrator",
  "name": "",
  "text": "never received a single scar from running away!"
 },
 {
  "i": 236,
  "style": "Title",
  "name": "",
  "text": "{\\fad(1600,2800)}In memory of Kinryu Arimoto"
 }
]