{"i":271,"he":"קדימה, מפקד אייס!"},
{"i":272,"he":"באמת? איזו הפתעה!"},
{"i":273,"he":"אז ככה זה, הא?"},
{"i":274,"he":"אבל אתה לא מתנהג כמו רוג'ר..."},
{"i":275,"he":"הוא לא היה אויב שלך?"},
{"i":276,"he":"אתה לא מעיף אותי?"},
{"i":277,"he":"כשאמרת שיש משהו חשוב,\\Nחשבתי שזה משהו יותר גדול..."},
{"i":278,"he":"לא משנה מי ההורים.\\Nכל אחד הוא ילד של הים."},
{"i":279,"he":"נראה שעוד אחד רציני הצטרף לזקן לבן."},
{"i":280,"he":"אומרים שהוא חזק בטירוף!"},
{"i":281,"he":"דיי, אייס! תירגע!"},
{"i":282,"he":"אבא אמר שרק הפעם הוא מוותר!"},
{"i":283,"he":"אתה לא חייב לרדוף אחרי טיץ'!"},
{"i":284,"he":"תעזבו אותי! הוא היה ביחידה שלי!"},
{"i":285,"he":"אם אתעלם, תאץ' לא ינוח בשקט!"},
{"i":286,"he":"אייס."},
{"i":287,"he":"בסדר. רק הפעם."},
{"i":288,"he":"משהו לא יושב לי."},
{"i":289,"he":"הוא הרג חבר צוות וברח!"},
{"i":290,"he":"אחרי כל השנים תחת הכנף שלך..."},
{"i":291,"he":"הוא פשוט ירק לך בפרצוף!"},
{"i":292,"he":"ומעל הכל, בייש את השם של אבא."},
{"i":293,"he":"אתה חושב שאני אשתוק?!"},
{"i":294,"he":"אני אסגור את זה!"},
{"i":295,"he":"היי, חכה! תחזור, אייס!"},
{"i":296,"he":"אייס!"},
{"i":297,"he":"אבא..."},
{"i":298,"he":"כולכם..."},
{"i":299,"he":"הפרתי לכם פקודה וברחתי!\\Nלמה לא זרקתם אותי?!"},
{"i":300,"he":"הכל בגלל שהייתי עקשן!"},
{"i":301,"he":"לא..."},
{"i":302,"he":"אני אמרתי לך ללכת..."},
{"i":303,"he":"בני."},
{"i":304,"he":"אתה משקר! דיי עם השטויות!"},
{"i":305,"he":"ניסית לעצור אותי אז, אבל אני...!"},
{"i":306,"he":"אמרתי לך ללכת!"},
{"i":307,"he":"אני אמרתי לו ללכת. נכון, מארקו?"},
{"i":308,"he":"כן, גם אני שמעתי.\\Nשלחנו אותך לצרה, הא, אייס?"},
{"i":309,"he":"כל הים הזה צריך לדעת..."},
{"i":310,"he":"מה קורה למי ש..."},
{"i":311,"he":"פוגע באחד משלנו."},
{"i":312,"he":"מי שפוגע בך לא יישאר בחיים, אייס!"},
{"i":313,"he":"תחזיק מעמד! אנחנו באים עכשיו!"},
{"i":314,"he":"תתכוננו, מפקדת הצי!"},
{"i":315,"he":"הוא אסף חבורה מרשימה, הא?"},
{"i":316,"he":"על מה הם מקשקשים?"},
{"i":317,"he":"יש לי הרגשה רעה."},
{"i":318,"he":"מה הרעידות האלו?!"},
{"i":319,"he":"הנה זה בא. הרעידה שהוא עורר קודם..."},
{"i":320,"he":"חוזרת כצונאמי!"},
{"i":321,"he":"איש הרעידות, שאכל את פרי הרעד-רעד..."},
{"i":322,"he":"\"זקן לבן\", אדוארד ניוגייט!"},
{"i":323,"he":"מה זה?!"},
{"i":324,"he":"זה צונאמי! ענק!"},
{"i":325,"he":"אולי יש לנו יותר אנשים,\\Nאבל אל תחשבו שכבר ניצחנו..."},
{"i":326,"he":"יכול להיות שדווקא אנחנו נמות!"},
{"i":327,"he":"לאיש הזה..."},
{"i":328,"he":"יש לו כוח להרוס את העולם!"},
{"i":329,"he":"זה מתחיל..."},
{"i":330,"he":"המלחמה!"},
{"i":331,"he":"קדימה!"},
{"i":332,"he":"זקן לבן תוקף עם 47\\Nספינות פיראטים מהעולם החדש."},
{"i":333,"he":"מולם עומדים שני הכוחות\\Nהכי גדולים של ממשלת העולם:"},
{"i":334,"he":"מפקדת הצי ושבעת לוחמי הים."},
{"i":335,"he":"לא משנה מי ינצח... לא משנה מי יפסיד..."},
{"i":336,"he":"העידן ישתנה."}
]
