 {
  "i": 390,
  "style": "Main",
  "name": "",
  "text": "The remaining three Demon Guards are a given..."
 },
 {
  "i": 391,
  "style": "Main",
  "name": "",
  "text": "but if Warden Magellan also shows up, we're done for!"
