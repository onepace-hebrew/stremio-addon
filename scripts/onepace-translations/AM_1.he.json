"ראיתן אותה בכפר פעם?"},{"i":143,"he":"לא, אף פעם..."},{"i":144,"he":"היי, מי זו?"},{"i":145,"he":"הפטריות מכסות לה את הפנים..."},{"i":146,"he":"מאיפה לדעתכן היא הגיעה?"},{"i":147,"he":"היא בכלל בחיים?"},{"i":148,"he":"היא אכלה פטריית טפיל."},{"i":149,"he":"מה נעשה, בלאדונה?"},{"i":150,"he":"הן יוצאות במשיכה,\\Nאז תמשכו אותן. את כולן."},{"i":151,"he":"הן יוצאות?"},{"i":152,"he":"הן באמת יוצאות!"},{"i":153,"he":"אבל חלק מהשורשים נשארים בפנים!"},{"i":154,"he":"אני אטפל בהם אחר כך,\\Nאז אל תדאגו לשורשים."},{"i":155,"he":"בהחלט הבאת הביתה אחת מוזרה, מרגריט."},{"i":156,"he":"אוי! חם! חם!"},{"i":157,"he":"רגע, בלאדונה! מה את עושה?!"},{"i":158,"he":"זו הדרך היחידה למנוע מהן לגדול שוב."},{"i":159,"he":"אבל זה לא קצת מוגזם?"},{"i":160,"he":"היא התעלפה שוב!"},{"i":161,"he":"בכל זאת, היא הייתה מכוסה בפציעות\\Nלפני שהייתה מכוסה בפטריות."},{"i":162,"he":"באמת?"},{"i":163,"he":"נראה כמו סימנים מקרב אדיר."},{"i":164,"he":"נצטרך לטפל גם בפצעים שלה."},{"i":165,"he":"לא נעים לי לבקש, מרגריט"},{"i":166,"he":"אבל תוכלי ללכת לשטוף אותה בנהר?"},{"i":167,"he":"ב-בסדר! ברור!"},{"i":168,"he":"נשמע שהיא בכלל לא מהכפר הזה, סוויטפי."},{"i":169,"he":"כן..."},{"i":170,"he":"הא?! תראי כאן!"},{"i":171,"he":"מה קרה?"},{"i":172,"he":"יש עוד פטרייה בין הרגליים שפספסנו!"},{"i":173,"he":"נשארה אחת!"},{"i":174,"he":"אבל זו נראית שונה מהאחרות, לא?"},{"i":175,"he":"יש לה צורה מוזרה!"},{"i":176,"he":"יופי!"},{"i":177,"he":"היא לא יוצאת! למה?!"},{"i":178,"he":"היא נמתחת!"},{"i":179,"he":"היי, מה קורה? מה היה?"},{"i":180,"he":"היא אומרת שזה נמתח..."},{"i":181,"he":"מספיק לבהות, כולכן!"},{"i":182,"he":"זה לא מופע מפלצות!"},{"i":183,"he":"גם את מסתכלת, שתדעי!"},{"i":184,"he":"תראו! נראה שיש בעיה!"},{"i":185,"he":"בכל זאת, היא לא ממש מפותחת."},{"i":186,"he":"היא אפילו נראית קצת מחוספסת."},{"i":187,"he":"אין טעם."},{"i":188,"he":"מה זה? מה זה?"},{"i":189,"he":"מה קורה?"},{"i":190,"he":"הו, סבתא ניון!"},{"i":191,"he":"יש פטרייה על הילדה הזו שלא יוצאת!"},{"i":192,"he":"רגע רגע. חכו. מי זו בכלל?"},{"i":193,"he":"אוי ואבוי!"},{"i":194,"he":"ה-האדם הזה..."},{"i":195,"he":"...הוא ג-ג-גבר!"},{"i":196,"he":"ז-זה ג-גבר?!"},{"i":197,"he":"מעולם לא ראיתי אחד!"},{"i":198,"he":"כאן שוכן אי הבתולות אמזון לילי"},{"i":199,"he":"\"קוג'ה\""},{"i":200,"he":"מאוכלס בשבט הלוחמות\\Nהידוע בשם קוג'ה."},{"i":201,"he":"שלא תחלמו עליו ושלא תדרכו בו"},{"i":202,"he":"אם חייכם עדיין יקרים לכם."},{"i":203,"he":"אי הבתולות — אמזון לילי"},{"i":204,"he":"זו ארץ הנשים של אמזון לילי."},{"i":205,"he":"לפעמים נשים עוזבות את האי\\Nוחוזרות כשהן הרות"},{"i":206,"he":"אבל באופן מוזר, הן יולדות רק בנות."},{"i":207,"he":"\"קוג'ה\""},{"i":208,"he":"בתוך הר גבוה מוקף בג'ונגל סמיך יש חור גדול"},{"i":209,"he":"ובתוכו נבנה כפר דמוי מצודה\\Nונוצרה מדינה."},{"i":210,"he":"מצאתי!"},{"i":211,"he":"קדימה! יש לנו בשר מלך הים היום!"},{"i":212,"he":"זה נראה טוב!"},{"i":213,"he":"זה גם יחליק לך את העור!"},{"i":214,"he":"מה לגבי פירות טריים שנקטפו מהג'ונגל?!"},{"i":215,"he":"כל הפרנסה והעבודה הפיזית\\Nנעשות גם הן על ידי נשים, כמובן."},{"i":216,"he":"הבאתי!"},{"i":217,"he":"תודה! פשוט תשימי את זה שם!"},{"i":218,"he":"בשמחה!"},{"i":219,"he":"גדלות מלידה כלוחמות"},{"i":220,"he":"הן באמת חסונות ורחבות לב"},{"i":221,"he":"אבל יש להן גם הילה של אלגנטיות."},{"i":222,"he":"אין כאן מקום בכלל לגברים חמדנים וטיפשים."},{"i":223,"he":"\"קרב\""},{"i":224,"he":"ומעל הכל, הנשים באי הזה חזקות."},{"i":225,"he":"הנה ההימורים להיום!"},{"i":226,"he":"1,000 ברי על פופי!"},{"i":227,"he":"1,500 על פנזי!"},{"i":228,"he":"בארץ הזו, החזקות הן היפות."},{"i":229,"he":"אם גבר אי פעם יתקרב למדינה הזו"},{"i":230,"he":"חיסול הוא כל מה שמחכה לו."},{"i":231,"he":"\"כלא\""},{"i":232,"he":"הגבר התעורר!"},{"i":233,"he":"תנו לי לראות! תנו לי לראות!"},{"i":234,"he":"גם אני רוצה לראות!"},{"i":235,"he":"הוא זז!"},{"i":236,"he":"תראו! אין לו שדיים בכלל!"},{"i":237,"he":"איזה יצור מוזר ומחוספס!"},{"i":238,"he":"הוא נראה כל כך חלש\\Nעם השיער הפרוע והגוף הרזה!"},{"i":239,"he":"הוא ישן דיי הרבה זמן..."},{"i":240,"he":"אבל שמעתי שהוא אכל ארוחות תוך כדי שינה!"},{"i":241,"he":"ידעתן את זה?"},{"i":242,"he":"מה גברים בדרך כלל אוכלים? בשר נא?"},{"i":243,"he":"יש לי הרגשה שהוא יאכל הכל..."},{"i":244,"he":"מה קורה?"},{"i":245,"he":"– מה כל הרעש?\\N– הו! הוא מדבר!"},{"i":246,"he":"איפה אני?"},{"i":247,"he":"מה עשיתי בעצם?"},{"i":248,"he":"אה, נכון!"},{"i":249,"he":"כולם התפזרו בארכיפלג סבאודי!"},{"i":250,"he":"כולן! ששש! הוא אומר משהו!"},{"i":251,"he":"אני זוכר שאכלתי פטריות, אבל אחר כך-"},{"i":252,"he":"הכובע שלי נעלם!"},{"i":253,"he":"הנה הוא!"},{"i":254,"he":"תחירי לי אותו, מנוולת!"},{"i":255,"he":"היד שלו נמתחה!"},{"i":256,"he":"איזה סוג גוף יש לו?!"},{"i":257,"he":"איזו הקלה!"},{"i":258,"he":"ג-ג-גברים יכולים למתוח ידיים!"},{"i":259,"he":"איזה הלם! תרשמו! תרשמו!"},{"i":260,"he":"זה הכי מרתק!"},{"i":261,"he":"היי! איך קוראים לך?"},{"i":262,"he":"אני לופי."},{"i":263,"he":"אני עירום!"},{"i":264,"he":"אתה איטי!"},{"i":265,"he":"קריר לי!"},{"i":266,"he":"אתן יודעות איפה הבגדים שלי?"},{"i":267,"he":"גברים איטיים, ורוצים להסתיר\\Nאת הראש לפני הגוף!"},{"i":268,"he":"אממ, לפני שתתלבש, אממ...!"},{"i":269,"he":"מה יש בתוך התיק התפור בין הרגליים שלך?"},{"i":270,"he":"תיק?"},{"i":271,"he":"רגע, אתן לא יודעות מה זה?"},{"i":272,"he":"איזה מוזרות! אלה ביצים!"},{"i":273,"he":"ביצים?"},{"i":274,"he":"מה זה ביצים?"},{"i":275,"he":"אלה תכשיטי המשפחה, כמובן!"},{"i":276,"he":"מדהים!"},{"i":277,"he":"תכשיטי המשפחה!"},{"i":278,"he":"תוכל להוציא את התכשיטים\\Nולתת לנו לראות אותם?"},{"i":279,"he":"אין מצב!"},{"i":280,"he":"את מנסה להרוג אותי?! אידיוטית!"},{"i":281,"he":"אז הנה הבגדים שלך!"},{"i":282,"he":"שלך היו לגמרי קרועים"},{"i":283,"he":"אז תפרתי חדשים באותו עיצוב!"},{"i":284,"he":"הו?! זה מעולה!"},{"i":285,"he":"תודה! אני אפילו לא יודע מי את!"},{"i":286,"he":"מה את...?"},{"i":287,"he":"הוספתי גם מלמלות פרחים סקסיות!"},{"i":288,"he":"בגדי חוץ זה הכל המלמלה!"},{"i":289,"he":"עבודה מצוינת, מרגריט!"},{"i":290,"he":"הוא נראה כל כך שמח שהוא רועד!"},{"i":291,"he":"אל תהיי טיפשה!"},{"i":292,"he":"אני גבר, שתדעי!"},{"i":293,"he":"היכונו להתקפה!"},{"i":294,"he":"מה?!"},{"i":295,"he":"איזה מזג אלים!\\Nזה הטבע האמיתי שלך?!"},{"i":296,"he":"צועק בלי בושה, לא אכפת לו\\Nשהצלנו לו את החיים..."},{"i":297,"he":"איזה מזג פראי!"},{"i":298,"he":"המילים והמעשים שלו לא הראו\\Nשמץ של אלגנטיות!"},{"i":299,"he":"המין שלו באמת לא מתאים לנו!"},{"i":300,"he":"בכל זאת, קיקו!"},{"i":301,"he":"הוא לא עשה הרבה!\\Nחבל לי להרוג אותו!"},{"i":302,"he":"רגע! חכו!"},{"i":303,"he":"הצלתן לי את החיים?!"},{"i":304,"he":"מה קרה?! תספרו לי!"},{"i":305,"he":"הבנות האלו הצילו אותך אחרי\\Nשאכלת פטרייה קטלנית והתמוטטת."},{"i":306,"he":"אה, באמת?! תודה!"},{"i":307,"he":"סליחה שהתלוננתי על הבגדים!"},{"i":308,"he":"רק אל תירו בי!"},{"i":309,"he":"ההתנצלויות והתירוצים שלך לא שווים כלום!"},{"i":310,"he":"זו אימפריית הנשים של אמזון לילי!"},{"i":311,"he":"אסור לגברים!"},{"i":312,"he":"זה החוק המוחלט כאן כבר מאות שנים!"},{"i":313,"he":"מעולם לא הופר בהיסטוריה!"},{"i":314,"he":"אימפריית נשים?!"},{"i":315,"he":"עכשיו שחזרת להכרה"},{"i":316,"he":"אין לנו שום רחמים עליך!"},{"i":317,"he":"כן! עכשיו שאני מסתכל מקרוב,\\Nיש כאן רק נשים!"},{"i":318,"he":"איזו מדינה מוזרה!"},{"i":319,"he":"נסיים גם את סגנון הדיבור המזלזל הזה!"},{"i":320,"he":"היי!"},{"i":321,"he":"אפלנדרה!"},{"i":322,"he":"כשנסיכת הנחשים תחזור"},{"i":323,"he":"היא בהחלט תתנגד למצב הזה!"},{"i":324,"he":"גם אתן תואשמו בפשע\\Nשל הבאת גבר לכפר!"},{"i":325,"he":"מרגריט."},{"i":326,"he":"סוויטפי."},{"i":327,"he":"אפלנדרה."},{"i":328,"he":"זה למענכן!"},{"i":329,"he":"מוטב שנכסה את התקרית הזו!"},{"i":330,"he":"רגע! תשחררו אותי!"},{"i":331,"he":"אני חייב להגיע למקום\\Nשסיכמתי עם החברים שלי!"},{"i":332,"he":"ירו!"},{"i":333,"he":"הוא פרץ דרך הגג!"},{"i":334,"he":"אל תתנו לו לברוח!"},{"i":335,"he":"הוא זריז יותר ממה שהוא נראה!"},{"i":336,"he":"אפלנדרה!"},{"i":337,"he":"כן!"},{"i":338,"he":"סליחה שהצלנו אותך ואז עשינו את זה!"},{"i":339,"he":"הוא נפל!"},{"i":340,"he":"עכשיו הוא מקפץ!"},{"i":341,"he":"הממ, מה אני עושה עכשיו?"},{"i":342,"he":"אה נכון! כרטיס הוויוורה שלי!"},{"i":343,"he":"השארתי את הפתק של הזקן\\Nבמכנסיים האחרים שלי!"},{"i":344,"he":"הנה היא! היא זו!"},{"i":345,"he":"אני לא יכול לדבר כאן!"},{"i":346,"he":"סליחה! יש משהו שאני רוצה לשאול אותך!"},{"i":347,"he":"תעזוב! הצילו!"},{"i":348,"he":"אוי לא! מרגריט נחטפה!"},{"i":349,"he":"גומי-גומי בלון!"},{"i":350,"he":"היי. את בסדר?"},{"i":351,"he":"תתרחק!"},{"i":352,"he":"אתה... השמנת הרגע, לא?!"},{"i":353,"he":"אתה חייב להיות משוגע לקפוץ מגובה כזה!"},{"i":354,"he":"הייתי מוכנה למות!"},{"i":355,"he":"זה נס שאנחנו עדיין בחיים!"},{"i":356,"he":"באמת?"},{"i":357,"he":"תתרחק!"},{"i":358,"he":"שמעתי שלכם הגברים יש וירוס!"},{"i":359,"he":"כל הגברים פתאום משמינים?!"},{"i":360,"he":"אין לי שום סוג של וירוס"},{"i":361,"he":"וזה כאב ראש להסביר,\\Nאז בואי נגיד שכל הגברים פתאום משמינים."},{"i":362,"he":"בכל אופן, היה משהו בכיסים\\Nשל המכנסיים הקרועים שלי?"},{"i":363,"he":"זה?"},{"i":364,"he":"זהו זה! זהו זה! איזו הקלה!"},{"i":365,"he":"לא הייתי יודע מה לעשות בלי זה!"},{"i":366,"he":"תודה ששמרת עליו!"},{"i":367,"he":"ת-תעזוב!"},{"i":368,"he":"הו, איזו הקלה!"},{"i":369,"he":"היה משהו כתוב עליו, אז חשבתי..."},{"i":370,"he":"הנה, תראי!"},{"i":371,"he":"איזה מוזר! נראה כאילו זה זז!"},{"i":372,"he":"המון דברים קרו"},{"i":373,"he":"וכל החברים שלי עפו בשמיים\\Nלכיוונים שונים."},{"i":374,"he":"אבל בזכות הפתקים האלו"},{"i":375,"he":"כולנו נוכל להתאסף שוב!"},{"i":376,"he":"כולם קשוחים, את רואה!"},{"i":377,"he":"הו, אני מודה לך בלי הפסקה!"},{"i":378,"he":"יש משהו שאני יכול לעשות בשבילך?"},{"i":379,"he":"תוכל להוציא את תכשיטי המשפחה\\Nשאוכל לראות אותם?!"},{"i":380,"he":"אמרתי לך שהם לא יוצאים!"},{"i":381,"he":"תשימי את החרב בצד!"},{"i":382,"he":"מי ה\"חברים\" האלו שלך?!"},{"i":383,"he":"אה, אני פיראט!"},{"i":384,"he":"את יודעת מה זה פיראט?"},{"i":385,"he":"אתה פיראט?"},{"i":386,"he":"גם הקיסרית של הארץ הזו פיראטית."},{"i":387,"he":"באמת?"},{"i":388,"he":"אז יש לה צוות פיראטים רק של נשים?"},{"i":389,"he":"הן חזקות?"},{"i":390,"he":"זו שאלה טיפשית!"},{"i":391,"he":"הלוחמות המובחרות ביותר בארץ\\Nמפליגות בספינת הפיראטים שלה!"},{"i":392,"he":"הן חזקות מאוד!"},{"i":393,"he":"כולן כאן מעריצות את נסיכת הנחשים!"},{"i":394,"he":"היא חזקה, אצילית והאישה הכי יפה בעולם!"},{"i":395,"he":"קיסרית הפיראטים, בואה הנקוק!"},{"i":396,"he":"הארץ הזו מוגנת היטב על ידה\\Nועל ידי שתי אחיותיה!"},{"i":397,"he":"אוי לא! הספינה של נסיכת הנחשים\\Nבקרבת מקום!"},{"i":398,"he":"זה רע!"},{"i":399,"he":"צריך לסיים מהר את התקרית עם הגבר!"},{"i":400,"he":"קיקו..."},{"i":401,"he":"נראה שהגבר קפץ לג'ונגל בסוף!"},{"i":402,"he":"לוחמות! לג'ונגל!"},{"i":403,"he":"תהרגו את הגבר ותצילו את מרגריט!"},{"i":404,"he":"נסיכת הנחשים חזרה!"}]