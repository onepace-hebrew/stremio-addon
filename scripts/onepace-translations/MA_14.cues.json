[
 {
  "i": 0,
  "style": "Title",
  "name": "",
  "text": "{\\fad(1800,3000)}Thank You For Loving Me"
 },
 {
  "i": 1,
  "style": "Main",
  "name": "",
  "text": "Ace..."
 },
 {
  "i": 2,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 3,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 4,
  "style": "Main",
  "name": "",
  "text": "Ace-{\\i1}san!{\\i0}"
 },
 {
  "i": 5,
  "style": "Main",
  "name": "",
  "text": "Ace!"
 },
 {
  "i": 6,
  "style": "Main",
  "name": "",
  "text": "He's been beaten! Dammit!"
 },
 {
  "i": 7,
  "style": "Main",
  "name": "",
  "text": "Stop Akainu!"
 },
 {
  "i": 8,
  "style": "Main",
  "name": "",
  "text": "Fire!"
 },
 {
  "i": 9,
  "style": "Main",
  "name": "",
  "text": "How will this war end?"
 },
 {
  "i": 10,
  "style": "Main",
  "name": "",
  "text": "No way! Is he a monster?!"
 },
 {
  "i": 11,
  "style": "Main",
  "name": "",
  "text": "So you're still alive, then?"
 },
 {
  "i": 12,
  "style": "Main",
  "name": "",
  "text": "Stop..."
 },
 {
  "i": 13,
  "style": "Main",
  "name": "",
  "text": "Stop!"
 },
 {
  "i": 14,
  "style": "Main",
  "name": "",
  "text": "Jinbe!"
 },
 {
  "i": 15,
  "style": "Main",
  "name": "",
  "text": "You can't touch him anymore!"
 },
 {
  "i": 16,
  "style": "Main",
  "name": "",
  "text": "You're just delaying the inevitable, Jinbe!"
 },
 {
  "i": 17,
  "style": "Main",
  "name": "",
  "text": "Since you used to be a Warlord..."
 },
 {
  "i": 18,
  "style": "Main",
  "name": "",
  "text": "you should know exactly how strong I am."
 },
 {
  "i": 19,
  "style": "Main",
  "name": "",
  "text": "If I can buy us some time by risking my life, then I'll gladly do so!"
 },
 {
  "i": 20,
  "style": "Main",
  "name": "",
  "text": "I've been prepared to die from the very beginning!"
 },
 {
  "i": 21,
  "style": "Main",
  "name": "",
  "text": "Jinbe!"
 },
 {
  "i": 22,
  "style": "Main",
  "name": "",
  "text": "Marco! That guy's here!"
 },
 {
  "i": 23,
  "style": "Main",
  "name": "",
  "text": "Gee, thank you for helping me! I almost died..."
 },
 {
  "i": 24,
  "style": "Main",
  "name": "",
  "text": "Just shut up and unlock this thing!"
 },
 {
  "i": 25,
  "style": "Main",
  "name": "",
  "text": "V-Vice Admiral Garp!"
 },
 {
  "i": 26,
  "style": "Main",
  "name": "",
  "text": "What are you...?"
 },
 {
  "i": 27,
  "style": "Main",
  "name": "",
  "text": "Garp!"
 },
 {
  "i": 28,
  "style": "Main",
  "name": "",
  "text": "What are you doing?! Have you lost your mind?!"
 },
 {
  "i": 29,
  "style": "Main",
  "name": "",
  "text": "You better keep holding me down, Sengoku!"
 },
 {
  "i": 30,
  "style": "Main",
  "name": "",
  "text": "Because if you don't, I will kill Sakazuki!"
 },
 {
  "i": 31,
  "style": "Main",
  "name": "",
  "text": "You fool!"
 },
 {
  "i": 32,
  "style": "Main",
  "name": "",
  "text": "I guess I need to execute a traitor, too."
 },
 {
  "i": 33,
  "style": "Main",
  "name": "",
  "text": "Jinbe, get down!"
 },
 {
  "i": 34,
  "style": "Main",
  "name": "",
  "text": "How annoying!"
 },
 {
  "i": 35,
  "style": "Main",
  "name": "",
  "text": "So you guys are Haki users!"
 },
 {
  "i": 36,
  "style": "Main",
  "name": "",
  "text": "How could we let that happen?!"
 },
 {
  "i": 37,
  "style": "Main",
  "name": "",
  "text": "I'll never forgive myself for this!"
 },
 {
  "i": 38,
  "style": "Main",
  "name": "",
  "text": "Can't you see that Fire Fist can't be saved?"
 },
 {
  "i": 39,
  "style": "Main",
  "name": "",
  "text": "Take a look!"
 },
 {
  "i": 40,
  "style": "Main",
  "name": "",
  "text": "Ace..."
 },
 {
  "i": 41,
  "style": "Main",
  "name": "",
  "text": "Hey, are you all right? Hey."
 },
 {
  "i": 42,
  "style": "Main",
  "name": "",
  "text": "Ace, you need to get treated right away!"
 },
 {
  "i": 43,
  "style": "Main",
  "name": "",
  "text": "I'm sorry, Luffy..."
 },
 {
  "i": 44,
  "style": "Main",
  "name": "",
  "text": "Huh?"
 },
 {
  "i": 45,
  "style": "Main",
  "name": "",
  "text": "To save me..."
 },
 {
  "i": 46,
  "style": "Main",
  "name": "",
  "text": "you pushed yourself so hard..."
 },
 {
  "i": 47,
  "style": "Main",
  "name": "",
  "text": "but I won't be able to make it out of here..."
 },
 {
  "i": 48,
  "style": "Main",
  "name": "",
  "text": "I'm sorry."
 },
 {
  "i": 49,
  "style": "Main",
  "name": "",
  "text": "Wh-What are you saying?"
 },
 {
  "i": 50,
  "style": "Main",
  "name": "",
  "text": "Don't be ridiculous!"
 },
 {
  "i": 51,
  "style": "Main",
  "name": "",
  "text": "Somebody, treat him!"
 },
 {
  "i": 52,
  "style": "Main",
  "name": "",
  "text": "Please! Please help Ace!"
 },
 {
  "i": 53,
  "style": "Main",
  "name": "",
  "text": "Hey, somebody! Help Ace! Please!"
 },
 {
  "i": 54,
  "style": "Main",
  "name": "",
  "text": "Hurry! This way! Give him first aid now!"
 },
 {
  "i": 55,
  "style": "Main",
  "name": "",
  "text": "Okay!"
 },
 {
  "i": 56,
  "style": "Main",
  "name": "",
  "text": "Straw Hat-boy..."
 },
 {
  "i": 57,
  "style": "Main",
  "name": "",
  "text": "Ace! Are you all right?!"
 },
 {
  "i": 58,
  "style": "Main",
  "name": "",
  "text": "Hurry up and treat him!"
 },
 {
  "i": 59,
  "style": "Main",
  "name": "",
  "text": "Okay, let me see the wound!"
 },
 {
  "i": 60,
  "style": "Main",
  "name": "",
  "text": "Please!"
 },
 {
  "i": 61,
  "style": "Main",
  "name": "",
  "text": "This is...!"
 },
 {
  "i": 62,
  "style": "Main",
  "name": "",
  "text": "Huh?"
 },
 {
  "i": 63,
  "style": "Main",
  "name": "",
  "text": "Hey."
 },
 {
  "i": 64,
  "style": "Main",
  "name": "",
  "text": "What's the matter? Hurry up and help him!"
 },
 {
  "i": 65,
  "style": "Main",
  "name": "",
  "text": "I'm sorry."
 },
 {
  "i": 66,
  "style": "Main",
  "name": "",
  "text": "What do you mean by that?"
 },
 {
  "i": 67,
  "style": "Main",
  "name": "",
  "text": "What's going on?! Just do something!"
 },
 {
  "i": 68,
  "style": "Main",
  "name": "",
  "text": "Hey, aren't you a doctor?! Hey!"
 },
 {
  "i": 69,
  "style": "Main",
  "name": "",
  "text": "It's no use."
 },
 {
  "i": 70,
  "style": "Main",
  "name": "",
  "text": "My organs have been burned."
 },
 {
  "i": 71,
  "style": "Main",
  "name": "",
  "text": "I'm not gonna last long."
 },
 {
  "i": 72,
  "style": "Main",
  "name": "",
  "text": "I can tell..."
 },
 {
  "i": 73,
  "style": "Main",
  "name": "",
  "text": "that my life is ending..."
 },
 {
  "i": 74,
  "style": "Main",
  "name": "",
  "text": "Ace..."
 },
 {
  "i": 75,
  "style": "Main",
  "name": "",
  "text": "what are you saying?"
 },
 {
  "i": 76,
  "style": "Main",
  "name": "",
  "text": "Are you gonna die?!"
 },
 {
  "i": 77,
  "style": "Main",
  "name": "",
  "text": "You promised me..."
 },
 {
  "i": 78,
  "style": "Main",
  "name": "",
  "text": "that you'd never die..."
 },
 {
  "i": 79,
  "style": "Main",
  "name": "",
  "text": "no matter what, Ace!"
 },
 {
  "i": 80,
  "style": "Main",
  "name": "",
  "text": "I would've given up a long time ago..."
 },
 {
  "i": 81,
  "style": "Main",
  "name": "",
  "text": "if it weren't for Sabo and a\\Nhigh-maintenance brother like you."
 },
 {
  "i": 82,
  "style": "Flashbacks",
  "name": "",
  "text": "If Gold Roger had a kid?"
 },
 {
  "i": 83,
  "style": "Flashbacks",
  "name": "",
  "text": "Of course I know what'd happen to him!"
 },
 {
  "i": 84,
  "style": "Flashbacks",
  "name": "",
  "text": "They'd get their head cut off for sure!"
 },
 {
  "i": 85,
  "style": "Flashbacks",
  "name": "",
  "text": "No way! I wouldn't be happy if the kid died that easily."
 },
 {
  "i": 86,
  "style": "Flashbacks",
  "name": "",
  "text": "How about shoving needles into that kid until the number equals the people that hated Roger!"
 },
 {
  "i": 87,
  "style": "Flashbacks",
  "name": "",
  "text": "No way! We should burn him at the stake..."
 },
 {
  "i": 88,
  "style": "Flashbacks",
  "name": "",
  "text": "and humiliate him in front of the whole world!"
 },
 {
  "i": 89,
  "style": "Flashbacks",
  "name": "",
  "text": "That sounds nice!"
 },
 {
  "i": 90,
  "style": "Flashbacks",
  "name": "",
  "text": "They'll all say: \"It serves you right!\""
 },
 {
  "i": 91,
  "style": "Flashbacks",
  "name": "",
  "text": "I'd want his last words to be..."
 },
 {
  "i": 92,
  "style": "Flashbacks",
  "name": "",
  "text": "\"I'm sorry I was born. I'm nothing but trash.\""
 },
 {
  "i": 93,
  "style": "Flashbacks",
  "name": "",
  "text": "Ah, well... I doubt that brat actually exists."
 },
 {
  "i": 94,
  "style": "Main",
  "name": "",
  "text": "No one wanted me to exist."
 },
 {
  "i": 95,
  "style": "Main",
  "name": "",
  "text": "Ace! Did you start trouble in town again?"
 },
 {
  "i": 96,
  "style": "Main",
  "name": "",
  "text": "Everybody is talking about it!\\N Why can't you stay out of trouble for our sake?"
 },
 {
  "i": 97,
  "style": "Main",
  "name": "",
  "text": "Shut up, Dadan!"
 },
 {
  "i": 98,
  "style": "Main",
  "name": "",
  "text": "What?!"
 },
 {
  "i": 99,
  "style": "Main",
  "name": "",
  "text": "If I was stronger, I would've killed them all."
 },
 {
  "i": 100,
  "style": "Main",
  "name": "",
  "text": "Oh yeah. If you ever see Dadan again... can you give her my regards?"
 },
 {
  "i": 101,
  "style": "Main",
  "name": "",
  "text": "Facing my own death, I even miss a woman like her."
 },
 {
  "i": 102,
  "style": "Main",
  "name": "",
  "text": "Like I said, don't say that you're gonna die!"
 },
 {
  "i": 103,
  "style": "Main",
  "name": "",
  "text": "There is one thing... that makes me want to stay..."
 },
 {
  "i": 104,
  "style": "Main",
  "name": "",
  "text": "That's my desire to see you fulfill your dream."
 },
 {
  "i": 105,
  "style": "Main",
  "name": "",
  "text": "But... I know you can do it!"
 },
 {
  "i": 106,
  "style": "Main",
  "name": "",
  "text": "Because you're my little brother!"
 },
 {
  "i": 107,
  "style": "Main",
  "name": "",
  "text": "Just like how I swore on that day..."
 },
 {
  "i": 108,
  "style": "Main",
  "name": "",
  "text": "I have no regrets..."
 },
 {
  "i": 109,
  "style": "Main",
  "name": "",
  "text": "in my life."
 },
 {
  "i": 110,
  "style": "Main",
  "name": "",
  "text": "Liar! You're lying!"
 },
 {
  "i": 111,
  "style": "Main",
  "name": "",
  "text": "I'm not lying."
 },
 {
  "i": 112,
  "style": "Main",
  "name": "",
  "text": "I've realized that what I really wanted... wasn't fame."
 },
 {
  "i": 113,
  "style": "Main",
  "name": "",
  "text": "Did I deserve to be born?"
 },
 {
  "i": 114,
  "style": "Main",
  "name": "",
  "text": "I wanted to know the answer to that question."
 },
 {
  "i": 115,
  "style": "Flashbacks",
  "name": "",
  "text": "Become my son!"
 },
 {
  "i": 116,
  "style": "Flashbacks",
  "name": "",
  "text": "I take it my beloved son is still doing well?"
 },
 {
  "i": 117,
  "style": "Flashbacks",
  "name": "",
  "text": "I'm your brother!"
 },
 {
  "i": 118,
  "style": "Flashbacks",
  "name": "",
  "text": "Say whatever the hell you want!"
 },
 {
  "i": 119,
  "style": "Flashbacks",
  "name": "",
  "text": "I'm saving you, even if I die!"
 },
 {
  "i": 120,
  "style": "Flashbacks",
  "name": "",
  "text": "Men!"
 },
 {
  "i": 121,
  "style": "Flashbacks",
  "name": "",
  "text": "Rescue Ace, and destroy the Navy!"
 },
 {
  "i": 122,
  "style": "Main",
  "name": "",
  "text": "I'm not able to shout loudly enough for everyone to hear me anymore..."
 },
 {
  "i": 123,
  "style": "Main",
  "name": "",
  "text": "Could you tell them..."
 },
 {
  "i": 124,
  "style": "Main",
  "name": "",
  "text": "the words I'm about to say?"
 },
 {
  "i": 125,
  "style": "Main",
  "name": "",
  "text": "Pops..."
 },
 {
  "i": 126,
  "style": "Main",
  "name": "",
  "text": "Everybody..."
 },
 {
  "i": 127,
  "style": "Main",
  "name": "",
  "text": "And you, Luffy."
 },
 {
  "i": 128,
  "style": "Main",
  "name": "",
  "text": "I've always been such a hopeless person..."
 },
 {
  "i": 129,
  "style": "Main",
  "name": "",
  "text": "I was demon spawn... the son of the devil..."
 },
 {
  "i": 130,
  "style": "Main",
  "name": "",
  "text": "Thank you..."
 },
 {
  "i": 131,
  "style": "Main",
  "name": "",
  "text": "for loving me!"
 },
 {
  "i": 132,
  "style": "Flashbacks",
  "name": "",
  "text": "Gramps."
 },
 {
  "i": 133,
  "style": "Flashbacks",
  "name": "",
  "text": "Was it..."
 },
 {
  "i": 134,
  "style": "Flashbacks",
  "name": "",
  "text": "good that I was born?"
 },
 {
  "i": 135,
  "style": "Flashbacks",
  "name": "",
  "text": "Well, you..."
 },
 {
  "i": 136,
  "style": "Flashbacks",
  "name": "",
  "text": "As long as you're alive, you'll figure it out eventually."
 },
 {
  "i": 137,
  "style": "Main",
  "name": "",
  "text": "Ace..."
 },
 {
  "i": 138,
  "style": "Flashbacks",
  "name": "",
  "text": "Did you think I was dead?"
 },
 {
  "i": 139,
  "style": "Flashbacks",
  "name": "",
  "text": "But...!"
 },
 {
  "i": 140,
  "style": "Flashbacks",
  "name": "",
  "text": "What are you crying about?! I'm alive, you idiot!"
 },
 {
  "i": 141,
  "style": "Flashbacks",
  "name": "",
  "text": "I promise you... I will never die!"
 },
 {
  "i": 142,
  "style": "Flashbacks",
  "name": "",
  "text": "How could I leave a wimpy\\Nlittle brother like you behind?"
 },
 {
  "i": 143,
  "style": "Flashbacks",
  "name": "",
  "text": "Garp."
 },
 {
  "i": 144,
  "style": "Flashbacks",
  "name": "",
  "text": "Take care of my child."
 },
 {
  "i": 145,
  "style": "Flashbacks",
  "name": "",
  "text": "Our child's name is Gol D. Ace."
 },
 {
  "i": 146,
  "style": "Flashbacks",
  "name": "",
  "text": "Didn't ya know? When you exchange sake cups, you become brothers."
 },
 {
  "i": 147,
  "style": "Flashbacks",
  "name": "",
  "text": "From today onward..."
 },
 {
  "i": 148,
  "style": "Flashbacks",
  "name": "",
  "text": "we are brothers!"
 },
 {
  "i": 149,
  "style": "Main",
  "name": "",
  "text": ""
 }
]