{"i":260,"he":"עוד מוקדם מידי בשבילנו להילחם בכם."},
{"i":261,"he":"זזים, חבר'ה!"},
{"i":262,"he":"כולם..."},
{"i":263,"he":"רק לרגע..."},
{"i":264,"he":"תקשיבו בבקשה למה שיש לי להגיד."},
{"i":265,"he":"וזה הדיווח האחרון..."},
{"i":266,"he":"זקן לבן. אייס."},
{"i":267,"he":"תנו לנו לקבור אותם, בבקשה."},
{"i":268,"he":"המלחמה הזו שודרה בכל העולם."},
{"i":269,"he":"אל תנצלו את המוות שלהם\\Nיותר ממה שכבר ניצלתם!"},
{"i":270,"he":"איזו חוצפה! מה אתה מקשקש?!"},
{"i":271,"he":"נציג את הראשים שלהם לכל העולם,\\Nוזה יהיה הסמל לניצחון שלנו!"},
{"i":272,"he":"סגן האדמירל צודק!"},
{"i":273,"he":"אתה רוצה להכתים את הניצחון שלנו?!"},
{"i":274,"he":"אנחנו לא מקבלים פקודות מפיראט!"},
{"i":275,"he":"בסדר."},
{"i":276,"he":"אדמירל הצי!"},
{"i":277,"he":"אני מוכן להשאיר אותם בידיים שלך,\\Nאדום השיער."},
{"i":278,"he":"אבל, המפקד!"},
{"i":279,"he":"האחריות עלי."},
{"i":280,"he":"סליחה על הטרחה."},
{"i":281,"he":"תטפלו בפצועים!"},
{"i":282,"he":"המלחמה הזו..."},
{"i":283,"he":"נגמרה!"},
{"i":284,"he":"כל מי שיכול לזוז, שיעזור לצוות הרפואי!"},
{"i":285,"he":"תתחילו מהפצועים קשה!"},
{"i":286,"he":"אסור שיהיו עוד נפגעים בשדה הקרב הזה!"},
{"i":287,"he":"וכך..."},
{"i":288,"he":"הקרב הגדול ביותר מאז שעלה המסך\\Nעל עידן הפיראטים הגדול..."},
{"i":289,"he":"המלחמה הגדולה במרינפורד, הגיעה לסיומה."},
{"i":290,"he":"ונחרתה בדפי ההיסטוריה."}
]
